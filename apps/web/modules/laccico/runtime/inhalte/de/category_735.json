[{"name":"MultiGrid","type":"structure","meta":{"uuid":"73fd617a-b617-4dc6-b5ac-a47edc49a87d","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"8e839e7a-e5b4-4cba-bdf5-17128f5caed0","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"78bc0084-d5d7-4e43-a855-7c3eb9ab2575","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"671e54f9-18e5-4777-a535-1f7eb0ec9e2e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den 3 mm Rundsenkel verwendet man an Schuhen mit aufgesetzten Ösen oder Haken. Er ist kräftiger als der 2 mm Rundsenkel und passt damit zu Schuhen, die selbst etwas kräftiger gebaut sind.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Aufgesetzte Ösen erkennt man am Metallring, der außen am Leder zu sehen ist. Für verdeckte Ösen, bei denen man von außen nur ein kleines Loch im Leder sieht, ist der 2 mm Rundsenkel gemacht. Den 3 mm Rundsenkel gibt es als Classic Sportive (R3-CS) in 39 Farben.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> R3-CS im Überblick&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">R3-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Form<br><span class=\"small text-muted font-weight-normal\">Durchmesser</span></td><td class=\"py-3 px-3 align-middle\">Rund, 3 mm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Geflecht</span></td><td class=\"py-3 px-3 align-middle\">100 % Baumwolle, dicht geflochten.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert, seidenmatter Glanz.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Farben<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">39 Farben, von Weiß bis Schwarz.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längen<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120 und 150 cm (Verkehrsgelb ab 60 cm).</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Herkunft<br><span class=\"small text-muted font-weight-normal\">Fertigung</span></td><td class=\"py-3 px-3 align-middle\">Gefertigt in der EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Verdeckte Ösen<br><span class=\"small text-muted font-weight-normal\">Zum Vergleich</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wann verwendet man einen Rundsenkel mit 3 mm Durchmesser (R3)?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"47e919a5-5b46-48ea-b137-765eed9c11b5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Am besten passen 3 mm Rundsenkel zu Schnürstiefeletten mit Ösen und Haken, zu Boots und zu kräftigen Derbys mit aufgesetzten Ösen.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Viele hochwertige Schnürstiefeletten haben unten Ösen und oben zwei bis drei Haken. Dafür ist der R3 in der Regel gut. Auch rahmengenähte Schuhe brauchen nicht immer feine Senkel: Country-Derbys, Stiefeletten und Boots mit aufgesetzten Ösen tragen den 3 mm Rundsenkel. Wer es an Haken lieber flach mag, nimmt den 4 mm Flachsenkel, das ist Geschmackssache.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhtypen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Senkel</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefeletten<br><span class=\"small text-muted font-weight-normal\">Knöchelhoch</span></td><td class=\"py-3 px-3 align-middle\">Unten Ösen, oben oft 2–3 Haken.</td><td class=\"py-3 px-3 align-middle\">Kräftig genug für den Haken, ruhig im Bild.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark\">R3-CS</span> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Country-Derbys<br><span class=\"small text-muted font-weight-normal\">Kräftige Sohle</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle\">Passt zur kräftigen Machart.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, Heritage</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken.</td><td class=\"py-3 px-3 align-middle\">Eine runde Kordel, die mithält.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ledersneaker<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Schlaufen.</td><td class=\"py-3 px-3 align-middle\">Klassisch statt sportlich.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Feine Oxfords und Derbys<br><span class=\"small text-muted font-weight-normal\">Verdeckte Ösen</span></td><td class=\"py-3 px-3 align-middle\">Von außen nur ein kleines Loch im Leder.</td><td class=\"py-3 px-3 align-middle\">Hier gehört der 2 mm Rundsenkel hin.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Für welche Schuhtypen eignen sich 3 mm Rundsenkel am besten?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"70bc1892-454f-429d-bf00-8bf8bd111859","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der Senkel sollte etwas Spiel in der Öse haben. Der 3 mm Rundsenkel ist für aufgesetzte Ösen ab 4 mm Innendurchmesser und für Haken gemacht. Verdeckte Ösen haben meist nur 3 mm, dort ist der 2 mm Rundsenkel die bessere Wahl.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Ist die Öse zu eng, wird die Oberfläche des Senkels beim Durchziehen stark beansprucht. Ösen fallen je nach Hersteller verschieden aus. Einen groben Anhaltspunkt gibt der bisherige Senkel: War er rund und kräftig und lief gut durch die Ösen, passt auch der R3.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Öse &amp; Senkel&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Öse</th><th scope=\"col\" class=\"py-3 px-3\">Passt der R3?</th><th scope=\"col\" class=\"py-3 px-3\">Besser geeignet</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Verdeckte Ösen<br><span class=\"small text-muted font-weight-normal\">Feine Halbschuhe</span></td><td class=\"py-3 px-3 align-middle\">Nein, zu eng.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Aufgesetzte Ösen ab 4 mm Innendurchmesser<br><span class=\"small text-muted font-weight-normal\">Halbschuhe, Stiefeletten</span></td><td class=\"py-3 px-3 align-middle\">Ja.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">Stiefeletten, Boots</span></td><td class=\"py-3 px-3 align-middle\">Ja, den Senkel einlegen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark\">R3-CS</span> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Aufgesetzte Ösen ab 5 mm Innendurchmesser<br><span class=\"small text-muted font-weight-normal\">Sneaker, Boots</span></td><td class=\"py-3 px-3 align-middle\">Ja, wirkt dort aber schmal.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welchen Ösendurchmesser erfordern 3 mm Rundsenkel?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"65093b42-6623-4806-9bab-1fa71cc61df2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Am sichersten misst man die alten Senkel ungeschnürt von Spitze zu Spitze nach. Für klassisches Schuhwerk hilft die Zahl der Ösenpaare als Faustregel, etwa 75 cm bei 4 bis 5 Ösenpaaren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dickere Senkel brauchen etwas mehr Länge als dünne. Bei Boots liegen die Ösen weit auseinander, dort passt die Faustregel kaum, hier hilft nur Nachmessen. Den R3-CS gibt es in 45, 60, 75, 90, 120 und 150 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Ösenpaare</th><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1–2<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">45 cm</td><td class=\"py-3 px-3 align-middle\">Schuhe mit nur einem Lochpaar.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbys mit kurzer Schnürung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Kräftige Derbys mit aufgesetzten Ösen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbys bei kräftigem Fuß, Übergang zu knöchelhohen Schuhen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Ösen und Haken.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">ab 9<br><span class=\"small text-muted font-weight-normal\">Ösenpaare / Stiefel</span></td><td class=\"py-3 px-3 align-middle\">150 cm</td><td class=\"py-3 px-3 align-middle\">Hohe Schnürstiefel und Boots: nachmessen.</td></tr></tbody></table></div></div><p>Ausführlich auf unserer Seite <a href=\"/laccico-finest-waxed-laces/schnuersenkel-laenge\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Schnürsenkel-Länge</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Länge brauche ich bei 3 mm Rundsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"49a6f0d4-ccb4-4134-b858-f9c1d6d4ea75","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der R3-CS ist reißfest: dicht geflochtene Baumwolle, deren Geflecht das Wachs ganz durchdringt. Wie lange er hält, entscheiden vor allem die Ösen, die Haken und die Art zu schnüren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">An Haken den Senkel erst nach dem Überkreuzen unter Spannung einlegen, nicht vorher und nicht durchziehen. Die falsche Zugrichtung ist der häufigste Grund für Verschleiß. Neue gewachste Senkel sind anfangs etwas steif, mit dem Tragen werden sie geschmeidiger.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Handhabung&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Punkt</th><th scope=\"col\" class=\"py-3 px-3\">Richtig</th><th scope=\"col\" class=\"py-3 px-3\">Warum</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">Stiefeletten, Boots</span></td><td class=\"py-3 px-3 align-middle\">Nach dem Überkreuzen unter Spannung einlegen.</td><td class=\"py-3 px-3 align-middle\">Falsche Zugrichtung ist der häufigste Grund für Verschleiß.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ösen<br><span class=\"small text-muted font-weight-normal\">Raue Kanten</span></td><td class=\"py-3 px-3 align-middle\">Einmal vorsichtig entgraten.</td><td class=\"py-3 px-3 align-middle\">Grate von alten Stanzwerkzeugen scheuern den Senkel auf.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Pflege<br><span class=\"small text-muted font-weight-normal\">Stumpfe Senkel</span></td><td class=\"py-3 px-3 align-middle\">Einen Lappen mit etwas Schuhcreme fest um den Senkel schließen und kräftig entlangziehen.</td><td class=\"py-3 px-3 align-middle\">Reibung und Wärme verteilen das Wachs neu.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Neue Senkel<br><span class=\"small text-muted font-weight-normal\">Anfangs steif</span></td><td class=\"py-3 px-3 align-middle\">Einfach tragen.</td><td class=\"py-3 px-3 align-middle\">Gute gewachste Senkel werden mit der Zeit geschmeidiger.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mehr dazu<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Unsere häufigen Fragen</a></td><td class=\"py-3 px-3 align-middle\">Weitere Fragen rund um Schnürsenkel und Schuhe.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie langlebig sind 3 mm Rundsenkel und worauf sollte man bei der Handhabung achten?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"e3af0b00-f485-4147-9914-432e2a0152c0","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"SortFilter","type":"content","meta":{"uuid":"69631a70-9cd1-4dcf-87b7-97106a978974","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filte