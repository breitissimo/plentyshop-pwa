ddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"c419701e-6419-4788-85e5-e6ec05c2f7de","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Was macht den Splendore besonders? Er besteht aus 100 % Baumwolle, reißfest geflochten und doppelt gewachst. Das ergibt eine gleichmäßige Oberfläche und eine besondere Farbtiefe.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1},{"name":"TextCard","type":"content","meta":{"uuid":"2db6dc65-417d-46b8-8ef9-fd617785ec39","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Für nur EUR 5,99 erhalten Sie ein Paar LACCICO 'Slendore di LACCICO' Schnürsenkel – die ideale Ergänzung, um Ihrem Stil eine besondere Note zu verleihen.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2},{"name":"TextCard","type":"content","meta":{"uuid":"8b141ef8-26ef-4776-8f1a-5571dcde50af","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Bereichern Sie Ihre Schuhsammlung mit den 'Slendore di LACCICO' Schnürsenkeln von LACCICO und erleben Sie die unschlagbare Kombination aus Stärke, Farbbrillanz und einzigartiger Haptik. Gönnen Sie Ihren Füßen das Beste – gönnen Sie sich LACCICO.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":3}]},{"name":"TextCard","type":"content","meta":{"uuid":"0ba4b2f6-e14b-465a-a674-9f660acba48d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"Entdecke die Pracht","link":"/","variant":"primary"},"layout":{"backgroundColor":