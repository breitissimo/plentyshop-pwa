[{"name":"Image","type":"content","meta":{"uuid":"ef479a51-7666-4f29-91ca-195a81b3e833","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","alt":"Zu den Schnürsenkeln","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/gewachste-schnuersenkel"},"text":{"textOverlay":"<h2>Zu den Schnürsenkeln</h2>","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"038656b4-e64e-4470-ab7d-796370b641fc","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h1 class=\"align-center\">Für schöne Schleifen</h1>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"9d3b2e6b-34b3-421e-9bb8-bcf46fed9e06","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"aeac2e7f-0a83-4f6b-9ae1-6b96f0b3f886","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p class=\"align-justify\"><strong>LACCICO® Ihr Fachgeschäft für gewachste Schnürsenkel</strong><em>.</em> Wir führen <a href=\"https://www.laccico.com/runde-gewachste-schnuersenkel\"><strong>runde </strong></a>und <a href=\"https://www.laccico.com/flache-gewachste-schnuersenkel\"><strong>flache </strong></a><strong>gewachste Schnürsenkel in vielen Längen, Durchmessern, Breiten und in allen modischen Farben.</strong> Die Senkel sind <strong>aus 100% Baumwolle</strong> und werden in der Toskana, in Italien, produziert und in Deutschland fachkundig geprüft, verpackt und auch von dort aus versendet. <strong>Mit gewachsten Schnürsenkeln von LACCICO® erhalten Sie ein Accessiores, mit dem sich ganz nach Bedarf Akzente setzen lassen.</strong> Darüber hinaus sind sie ebenso<strong> ein erstklassiger Ersatz ihrer bisherigen Schnürsenkel.</strong></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"f70c4942-2070-4f2e-9bf3-4066146bac1c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p class=\"align-justify\">Längst sind Schnürsenkel nicht mehr \"nur\" das Schuhband, mit dem Sie Ihre Schnürschuhe verschließen. <strong>Durch die große Auswahl an Varianten wie </strong><a href=\"https://www.laccico.com/flache-gewachste-schnuersenkel\"><u>Flach</u></a><strong>- oder </strong><a href=\"https://www.laccico.com/runde-gewachste-schnuersenkel\"><strong><u>Rundsenkel</u></strong></a><strong>,</strong> diese in vielen Breiten, Durchmessern und Farben, <strong>lassen sich nahezu alle erdenklichen Stile</strong> zu verschiedenen Anlässen und Einsatzzwecken <strong>pflegen</strong>.<em> Lassen Sie sich</em> von der großen Vielfalt unseres Sortiments an gewachsten Schnürsenkeln <em>inspirieren</em>. <strong>Kombinieren Sie z.B. einfach mal die Farbe der Schnürsenkel zur Farbe von Manschettenknöpfen, Einstecktüchern oder den Kleidern Ihrer Begleitung.</strong></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]}]