[{"name":"MultiGrid","type":"structure","meta":{"uuid":"cf096c10-c6db-416c-aa37-771773605d0d","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"16d803be-573c-44d2-aaa7-6c0748b9ba75","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"33090a94-4a8f-42b5-abd7-346af3a71e2d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das hängt davon ab, was man unter Budapester versteht. Der echte ungarische Budapester hat heute meist verdeckte Ösen, dazu passt der 2 mm Rundsenkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Meist ist mit Budapester der Brogue mit seinem Lochmuster gemeint. Hat er verdeckte Ösen, passen der 2 mm Rundsenkel oder der schmale 3 mm Flachsenkel. Bei kräftigeren Brogues im Country-Stil mit aufgesetzten Ösen kommen auch der 3 mm Rundsenkel und der 4 mm Flachsenkel infrage.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Budapester &amp; Brogue&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Rottöne</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Budapester<br><span class=\"small text-muted font-weight-normal\">Zopfnaht am Rahmen</span></td><td class=\"py-3 px-3 align-middle\">Meist verdeckt</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Bordo (Weinrot), Rosso (Rot)</td><td class=\"py-3 px-3 align-middle\">Fein, der Senkel lässt dem Lochmuster den Vortritt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brogue, Full Brogue<br><span class=\"small text-muted font-weight-normal\">Klassisch</span></td><td class=\"py-3 px-3 align-middle\">Verdeckt</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Weinrot, Rot</td><td class=\"py-3 px-3 align-middle\">Dezent; der Flachsenkel ist ein kleiner Überraschungseffekt für Kenner.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brogue im Country-Stil<br><span class=\"small text-muted font-weight-normal\">Kräftiger</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzt</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Weinrot, Rot</td><td class=\"py-3 px-3 align-middle\">Kräftig, passt zu Tweed und Cord.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Form sorgt für einen zeitlosen Look bei Budapestern?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"1f77718e-35b5-4e4f-9747-138fa0556263","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Weil sie dicht und straff geflochten sind. Dadurch ist kaum Dehnung möglich, nach langem Gebrauch höchstens ein minimaler Rest.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Spulenzahl und Garnstärke werden beim Flechten auf den jeweiligen Senkel abgestimmt. Rundsenkel, vor allem die dickeren, sind um eine Kernkordel geflochten. Flachsenkel sind eine hohle Kordel, die anschließend flach gewalzt wird. Auch völlig durchnässt behalten die Senkel ihre Form.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Flechtung &amp; Form&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtung<br><span class=\"small text-muted font-weight-normal\">Dicht und straff</span></td><td class=\"py-3 px-3 align-middle\">Spulenzahl und Garnstärke passend zum Senkel.</td><td class=\"py-3 px-3 align-middle\">Dehnt sich kaum, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nässe<br><span class=\"small text-muted font-weight-normal\">Regen, Schnee</span></td><td class=\"py-3 px-3 align-middle\">Eng geflochten aus 100 % Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Behält auch durchnässt die Form.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert.</td><td class=\"py-3 px-3 align-middle\">Langlebig, schützt vor Nässe.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum dehnen sich LACCICO Baumwollsenkel beim Tragen nicht unerwünscht aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"679faa0e-3f46-4546-8a02-fdb1c71de8b9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Auf dunklem Leder setzen rote Senkel einen deutlichen Akzent. Weinrot wirkt ruhiger, reines Rot kräftiger.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Auf schwarzem Glattleder ist Rot ein klarer Kontrast. Zu dunkelbraunem Leder passt Weinrot, weil es den warmen Ton des Leders aufnimmt. Zu weinrotem Leder, etwa Cordovan Shell, steht Bordo (Weinrot) aus der Serie R2-SL Ton in Ton.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Rot &amp; Leder&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Rotton</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weinrotes Leder<br><span class=\"small text-muted font-weight-normal\">Cordovan Shell, Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Bordo (Weinrot)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Ton in Ton, mit besonderer Farbtiefe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraunes Glattleder<br><span class=\"small text-muted font-weight-normal\">Oxford, Derby</span></td><td class=\"py-3 px-3 align-middle\">Weinrot</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Warm und dezent.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarzes Glattleder<br><span class=\"small text-muted font-weight-normal\">Oxford, Derby</span></td><td class=\"py-3 px-3 align-middle\">Rot, Rosso (Rot)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Klarer Kontrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefelette<br><span class=\"small text-muted font-weight-normal\">Braunes Glatt- oder Rauleder</span></td><td class=\"py-3 px-3 align-middle\">Weinrot, Aubergine</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Ruhig und warm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkle Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, Heritage</span></td><td class=\"py-3 px-3 align-middle\">Weinrot</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Kräftig, im Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Helle Sneaker<br><span class=\"small text-muted font-weight-normal\">Weiß oder hellgrau</span></td><td class=\"py-3 px-3 align-middle\">Rosa, Altrosa, Pink, Fuchsia</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Frisch und fröhlich.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Wirkung erzielen rote und weinrote Schnürsenkel auf dunklem Leder?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"809bde61-75ee-4442-b69c-b430770b8096","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das entscheiden die Ösen. Der 2 mm Rundsenkel ist für verdeckte Ösen gemacht, der 4 mm Flachsenkel für aufgesetzte Ösen und Haken.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der Senkel sollte etwas Spiel in der Öse haben, sonst wird er beim Durchziehen stark beansprucht. Der 4 mm Flachsenkel ist besonders beliebt an knöchelhohen Schnürschuhen mit Ösen und Haken. Meistertipp: Bei Haken den Senkel erst nach dem Überkreuzen unter Spannung einlegen, nicht durch den Haken ziehen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Rund oder flach&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150, 180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbys, Brogues; 180 cm für Damenstiefel</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150, 180 cm</td><td class=\"py-3 px-3 align-middle\">Feine Oxfords und Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">60, 75, 90, 120 cm</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, offene Derbys</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wann wählt man 2 mm Rundsenkel und wann 4 mm Flachsenkel bei roten Kontrastschnürungen?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e33bdcc1-7545-4474-a192-20b77553f148","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das Wachs durchdringt das Fasergefüge des Baumwollgeflechts, ähnlich wie Gerbstoffe das Leder. Das schützt die Faser vor Abrieb und Nässe.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Nach dem Wachsen werden die Senkel heiß gewalzt und poliert, das gibt ihnen den seidenmatten Glanz. Die kräftigen Farben kommen von den Garnherstellern, die die Baumwolle mit speziellen Färbe- und Fixierverfahren färben. Wirkt ein Senkel mit der Zeit stumpf, frischt man ihn mit einem Lappen und etwas Schuhcreme wieder auf.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Wachs &amp; Farbe&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">Was passiert</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsen<br><span class=\"small text-muted font-weight-normal\">Paraffin</span></td><td class=\"py-3 px-3 align-middle\">Das Wachs durchdringt das Fasergefüge.</td><td class=\"py-3 px-3 align-middle\">Langlebig, schützt vor Abrieb und Nässe.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Walzen und Polieren<br><span class=\"small text-muted font-weight-normal\">Heiß gewalzt</span></td><td class=\"py-3 px-3 align-middle\">Die Bänder werden heiß gewalzt und poliert.</td><td class=\"py-3 px-3 align-middle\">Seidenmatter Glanz.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längeres Wachsbad<br><span class=\"small text-muted font-weight-normal\">Nur SL</span></td><td class=\"py-3 px-3 align-middle\">Die Bänder laufen langsamer durch das Wachsbad und sind stärker gewachst.</td><td class=\"py-3 px-3 align-middle\">Besondere Farbtiefe, Glanz wie feines Kalbsleder.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie schützt die Wachsung farbintensive rote Schnürsenkel vor vorzeitigem Verschleiß?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"035b1b31-aa3c-4387-a88f-df2fc9d4aeb3","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"e51d321c-09ca-416d-acb5-884a48b4d730","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"8dc749bd-db99-45d7-ab88-b518251f59b2","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommende