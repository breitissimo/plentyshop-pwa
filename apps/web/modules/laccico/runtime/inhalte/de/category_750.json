[{"name":"MultiGrid","type":"structure","meta":{"uuid":"019be278-e55c-4005-b528-64f4a78fb4cc","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"1a6c8254-8ec6-48d9-a2b2-2ec06adb390a","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"c9efe6b0-549c-43ef-bf59-fe08eb388a5e","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"335f365b-1fa8-4d8f-b149-5c10ccc3e165","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"172cd2b8-edb5-4d40-9b96-082fafbdb781","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Mit etwas Pflege. Wirkt ein Senkel stumpf, zieht man ihn kräftig durch einen Lappen mit etwas Schuhcreme. Durch Reibung und Wärme verteilt sich das Wachs neu.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Beim Schuheputzen bekommt meist nur die sichtbare Oberseite etwas ab. Deshalb den Senkel ab und zu ganz ausfädeln, damit auch die Stellen in den Ösen gepflegt werden. Das geht öfter, aber nicht ewig: Irgendwann ist ein neues Paar fällig. Mit der Zeit bekommt der Senkel zusammen mit dem Schuh eine schöne Patina.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Pflege&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pflege</th><th scope=\"col\" class=\"py-3 px-3\">So geht es</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Passt für</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Auffrischen<br><span class=\"small text-muted font-weight-normal\">Reibung und Wärme</span></td><td class=\"py-3 px-3 align-middle\">Lappen mit etwas Schuhcreme fest um den Senkel schließen und kräftig entlangziehen. Die Finger mit dem Tuch schützen.</td><td class=\"py-3 px-3 align-middle\">Das Wachs verteilt sich neu, der Senkel bekommt wieder Glanz.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ausfädeln<br><span class=\"small text-muted font-weight-normal\">Ganzer Senkel</span></td><td class=\"py-3 px-3 align-middle\">Den Senkel herausnehmen und auf ganzer Länge so behandeln.</td><td class=\"py-3 px-3 align-middle\">Auch die Stellen in den Ösen werden gepflegt.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bügeleisen<br><span class=\"small text-muted font-weight-normal\">Nur Flachsenkel</span></td><td class=\"py-3 px-3 align-middle\">Den Senkel kurz mit dem Bügeleisen glätten, das Eisen danach reinigen.</td><td class=\"py-3 px-3 align-middle\">Das Wachs verteilt sich, der Senkel liegt wieder glatt.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie behalten gewachste Schuhbänder ihre geschmeidige Haptik?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c89c07cf-b5d0-48c6-a8aa-8721b20f9ad7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Schnürsenkel für Schuhe werden nicht gewebt, sondern geflochten. Gewebte Bänder kennt man als Zier- und Geschenkbänder.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Entscheidend ist, wie dicht geflochten wird. Spulenzahl und Garnstärke werden beim Flechten auf den jeweiligen Senkel abgestimmt. Ein dicht und straff geflochtener Senkel ist reißfest, dehnt sich kaum und behält auch nass seine Form. Billige Senkel sind dagegen oft locker geflochten.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Aufbau&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Form</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rundsenkel<br><span class=\"small text-muted font-weight-normal\">2 und 3 mm</span></td><td class=\"py-3 px-3 align-middle\">Rund geflochten, die dickeren um eine Kernkordel. Das gibt Volumen.</td><td class=\"py-3 px-3 align-middle\">Rund und formstabil.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flachsenkel<br><span class=\"small text-muted font-weight-normal\">3, 4 und 6 mm</span></td><td class=\"py-3 px-3 align-middle\">Hohle Kordel, die anschließend flach gewalzt wird.</td><td class=\"py-3 px-3 align-middle\">Liegt flach in der Schnürung.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtung<br><span class=\"small text-muted font-weight-normal\">Spulenzahl, Garnstärke</span></td><td class=\"py-3 px-3 align-middle\">Dicht geflochten aus 100 % Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Reißfest, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum sind dicht geflochtene Schnürsenkel besser als gewebte Varianten?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"84a268d8-d9ea-45fa-a2d9-2351493e0f3b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Die Dicke richtet sich nach den Ösen, nicht nach der Farbe. Für verdeckte Ösen sind die 2 mm Rundsenkel und der flache 3 mm Senkel gemacht.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der Senkel sollte etwas Spiel in der Öse haben, sonst wird er beim Durchziehen stark beansprucht. Hat der Schuh aufgesetzte Ösen oder Haken, wie viele Schnürstiefeletten und Country-Derbys, passen auch der 3 mm Rundsenkel und der 4 mm Flachsenkel. Dunkelblau gibt es in allen diesen Serien.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Senkelstärke&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Blautöne</th><th scope=\"col\" class=\"py-3 px-3\">Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Blau, Graublau, Hellblau, Türkis, Lila</td><td class=\"py-3 px-3 align-middle\">Oxfords, feine Derbys, Brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Blu (Dunkelblau), Azzurro (Nachtblau), Testa di Azzurro (Basisblau), Royal (Königsblau), Cielo (Hellblau), Celeste (Türkis)</td><td class=\"py-3 px-3 align-middle\">Feine Oxfords und Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flach<br><span class=\"small text-muted font-weight-normal\">Der dezente Flachsenkel</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Blau, Royalblau, Hellblau, Türkis, Lila</td><td class=\"py-3 px-3 align-middle\">Klassische Halbschuhe, Brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Kräftiger</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Royalblau, Lila</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, Country-Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flach<br><span class=\"small text-muted font-weight-normal\">Kräftiger</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Blau, Royalblau, Hellblau, Türkis, Lila</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, offene Derbys</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Dicke wählt man für dunkelblaue Oxfords und Derbys?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"84419b04-7fd6-4480-99db-d9afb9452b6d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Blau auf braunem Leder ist ein klassischer Kontrast. Je dunkler der Blauton, desto ruhiger wirkt er.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zu dunkelbraunem Glattleder passt ein dunkles Blau, das erst auf den zweiten Blick auffällt. Auf hellerem Braun und Cognac darf es kräftiger sein. Dazu getragen greift das Blau einen dunkelblauen Anzug, ein Kostüm, ein Sakko oder Jeans auf.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Blau &amp; Braun&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Blauton</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraunes Glattleder<br><span class=\"small text-muted font-weight-normal\">Oxford, Derby</span></td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Blu (Dunkelblau), Azzurro (Nachtblau)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Dezent, fällt erst auf den zweiten Blick auf.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mittelbraun, Cognac<br><span class=\"small text-muted font-weight-normal\">Glattleder, Brogue</span></td><td class=\"py-3 px-3 align-middle\">Blau, Testa di Azzurro (Basisblau)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Deutlicher Kontrast, passt zum blauen Anzug.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braunes Wildleder<br><span class=\"small text-muted font-weight-normal\">Schnürstiefelette</span></td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Royalblau</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Kräftig, gern zu Jeans und Chino.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braune Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, Heritage</span></td><td class=\"py-3 px-3 align-middle\">Blau</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Rustikal, im Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneaker<br><span class=\"small text-muted font-weight-normal\">Braunes Leder</span></td><td class=\"py-3 px-3 align-middle\">Hellblau, Türkis</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Frisch und fröhlich.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie kombiniert man dunkelblaue Senkel stilvoll mit braunen Lederschuhen?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"415749b6-d905-4f1f-bd1d-52b2581ead4f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Die Färbung übernehmen die Garnhersteller. Sie färben die Baumwollgarne mit speziellen Färbe- und Fixierverfahren, bevor daraus Senkel geflochten werden.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das Wachs bindet die Farbe nicht, bildet aber eine schützende Barriere: Es durchdringt das Fasergefüge des Geflechts. Beim normalen Tragen bleiben die Senkel dank guter Färbung lange farbstabil. Beim Splendore di Laccico laufen die Bänder langsamer durch das Wachsbad, das gibt dem Blau eine besondere Farbtiefe.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farbe &amp; Wachs&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">Was passiert</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Färben<br><span class=\"small text-muted font-weight-normal\">Garn</span></td><td class=\"py-3 px-3 align-middle\">Die Garnhersteller färben und fixieren die Baumwollgarne.</td><td class=\"py-3 px-3 align-middle\">Gleichmäßiger Farbton über die ganze Länge.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsen<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert. Das Wachs durchdringt das Fasergefüge.</td><td class=\"py-3 px-3 align-middle\">Schützende Barriere, seidenmatter Glanz.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längeres Wachsbad<br><span class=\"small text-muted font-weight-normal\">Nur SL</span></td><td class=\"py-3 px-3 align-middle\">Die Bänder laufen langsamer durch das Wachsbad und sind stärker gewachst.</td><td class=\"py-3 px-3 align-middle\">Besondere Farbtiefe, Glanz wie feines Kalbsleder.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie halten tiefblau gefärbte gewachste Schnürsenkel ihre Farbe?","defaultOpen":false}}}],"parent_slot":0,"slot_index":2},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"ac84ce37-9092-4aad-9fc9-8c79de25f150","isGlobalTemplate":false},"parent_slot":1,"slot_index":0,"content":{"teil":"titel"}},{"name":"SortFilter","type":"content","meta":{"uuid":"f6e3ef18-8d71-48e4-95cf-5167f49a5c0f","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"82fb56cb