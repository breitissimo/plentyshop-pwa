dding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">flach, 6 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">75–150 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F6-XR</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">flach, 6 mm, kräftig</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">75–150 cm</td></tr></tbody></table></div><p style=\"margin:10px 0 0;font-size:.95rem;color:#555\">180 cm gibt es nur bei den 2-mm-Rundsenkeln.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"523a6b30-562c-4968-accc-52a04dab9db1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"mt-4\">Häufige Fragen zur Schnürsenkel-Länge</h3>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"DetailsList","type":"structure","meta":{"uuid":"b6a00de6-25e6-44ae-966d-683f81a58320","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"61e0bf84-f69c-430c-92f4-c98ec4dd3d16","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>90 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Nach der Faustregel passen bei 5–6 Ösenpaaren 90 cm. Das gilt für klassisches Schuhwerk; liegen die Ösen weit auseinander, wie bei Sneakern, darf es länger sein.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie lang müssen Schnürsenkel bei 6 Ösenpaaren sein?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"34317344-bb5b-4aec-8cf4-401d9b97ef13","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>75 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das passt fast immer bei klassischen 5-Loch-Schuhen. Bei kräftigem Fuß nimmt man 90 cm.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Länge brauche ich für einen 5-Loch-Derby oder -Oxford?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"dcf43b78-5f6a-45cd-836d-2ef1983aa647","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Ab 120 cm für Stiefeletten, 150 bis 180 cm für Stiefel mit 9 und mehr Ösenpaaren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">180 cm gibt es bei LACCICO in den 2-mm-Rundsenkeln; die langen Längen gehen meist an Damenstiefel.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie lang müssen Schnürsenkel für Stiefel sein?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4336af26-c452-4896-9acb-344729ee0be9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Ja, etwas.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Ein dicker Senkel wie der F6-XR verbraucht auf dem Weg durch die Ösen mehr Länge als ein dünner. Kommen nach der Faustregel zwei Längen in Frage, greift man beim F6-XR zur längeren.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Brauchen dickere Schnürsenkel mehr Länge?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c752b901-a294-4827-90a7-514db512c925","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Berechnen ließe sie sich, wenn man alle Ösenabstände und das Maß für die Schleife kennt. In der Praxis macht das niemand.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Am sichersten ist es, die alten Senkel im ungeschnürten Zustand nachzumessen; ohne alte Senkel hilft die Faustregel oben.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Kann man die Schnürsenkel-Länge berechnen?","defaultOpen":false}}}]},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"03ddba81-a26f-4689-b5b6-eb9c5d16c10e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left