[{"name":"MultiGrid","type":"structure","meta":{"uuid":"11768f7d-674c-45db-adf1-d8ae6418515a","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"122b47a6-806e-40f5-99a3-319e54258858","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"c241f756-2fb6-4302-a364-4912c6fd632d","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"c7edefdb-60fb-43fe-b1e4-6b7c1151d6df","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der F6-XR ist ein 6 mm breiter, gewachster Flachsenkel aus 100 % Baumwolle mit kräftigen Strängen. Er hat mehr Volumen, da mehr Garn darin verflochten ist, und wirkt rustikal.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Im Vergleich zum F6-CS ist er höher und schwerer. Sein softig-massiver Griff kommt von den Strängen, nicht vom Wachs. Gewachst, heiß gewalzt und poliert, hat er einen seidenmatten Glanz. Das Wachs durchdringt das Geflecht und schützt die Faser. Wer einen feineren Senkel mit unaufdringlichem Flechtbild sucht, nimmt den F6-CS.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-XR auf einen Blick&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Breite<br><span class=\"small text-muted font-weight-normal\">Form</span></td><td class=\"py-3 px-3 align-middle\">6 mm, flach.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Faser</span></td><td class=\"py-3 px-3 align-middle\">100 % Baumwolle, gewachst.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtbild<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Kräftige Stränge, rustikal.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Griff<br><span class=\"small text-muted font-weight-normal\">In der Hand</span></td><td class=\"py-3 px-3 align-middle\">Softig-massiv.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Glanz<br><span class=\"small text-muted font-weight-normal\">Wachsung</span></td><td class=\"py-3 px-3 align-middle\">Heiß gewalzt und poliert, seidenmatt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längen<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">75, 90, 120 und 150 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Feiner<br><span class=\"small text-muted font-weight-normal\">Schwesterserie</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was zeichnet die Serie Xtra Robust (F6-XR) bei 6 mm Flachsenkeln aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a30576a8-9529-47d4-94e6-31315d5c54fb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der F6-XR passt zu Schuhen mit aufgesetzten Ösen ab 5 mm Innendurchmesser im Vintage-, Heritage- und Workwear-Look: Moc-Toe-Boots, Workwear-Boots, Schnürstiefel und Sneaker im Vintage-Look.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zu kräftigem Leder und markanter Sohle passt das kräftige Flechtbild des F6-XR. An High-Top-Sneakern im Workwear-Look wirkt der F6-CS ebenso gut wie der F6-XR. Für edle Ledersneaker ist der feinere F6-CS die bessere Wahl.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhe&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Senkel</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Moc-Toe-Boots<br><span class=\"small text-muted font-weight-normal\">Heritage</span></td><td class=\"py-3 px-3 align-middle\">Ösen, oft mit Haken.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Workwear-Boots<br><span class=\"small text-muted font-weight-normal\">Robust</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen, Haken.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefel<br><span class=\"small text-muted font-weight-normal\">Hoher Schaft</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen, oben Haken.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneaker<br><span class=\"small text-muted font-weight-normal\">Vintage-Look</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">High-Top-Sneaker<br><span class=\"small text-muted font-weight-normal\">Workwear-Look</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ledersneaker<br><span class=\"small text-muted font-weight-normal\">Edel</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhtypen und Stiefel profitieren am meisten von der F6-XR Serie?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e2455e47-5b11-4dee-aeda-02613e099c85","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den F6-XR gibt es in 11 Farben und in 75, 90, 120 und 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Neben Schwarz, Anthrazit und Weiß gibt es Beige und drei Brauntöne, dazu Verkehrsgelb, Weinrot, Grün und Blau. Eine größere Auswahl hat der F6-CS mit 50 Farben.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farben&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Farbwelt</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Farben</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarz<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Schwarz</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weiß &amp; Creme<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Weiß</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grau<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Anthrazit</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braun &amp; Beige<br><span class=\"small text-muted font-weight-normal\">4 Farben</span></td><td class=\"py-3 px-3 align-middle\">Beige, Hellbraun, Karamellbraun, Dunkelbraun</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Gelb<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Verkehrsgelb</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rot &amp; Rosa<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Weinrot</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grün<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Grün</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blau<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Blau</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Farben gibt es beim gewachsten 6 mm Flachsenkel F6-XR?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"661b19a3-148b-4219-b29b-1db0cf1b7ba2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den Flachsenkel legt man in den Haken ein: erst überkreuzen, dann unter Spannung einlegen. Zieht man ihn im Zugkanal des Hakens fest, scheuert er schnell.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Die falsche Zugrichtung ist der häufigste Grund für frühen Verschleiß an Haken. In den Ösen darunter führt man das Band mit einer Hand durch die Öse und lässt das Restende über einen Finger der anderen Hand unter leichter Spannung gleiten. Erst ziehen, wenn das Band flach liegt.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Haken&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">Was tun</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ösen<br><span class=\"small text-muted font-weight-normal\">Unterer Teil</span></td><td class=\"py-3 px-3 align-middle\">Band mit leichter Gegenspannung durchführen, erst ziehen, wenn es flach liegt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Überkreuzen<br><span class=\"small text-muted font-weight-normal\">Vor jedem Haken</span></td><td class=\"py-3 px-3 align-middle\">Erst kreuzen, dann zum Haken führen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">Oberer Teil</span></td><td class=\"py-3 px-3 align-middle\">Unter Spannung einlegen, nicht durch den Zugkanal festziehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Verdreht<br><span class=\"small text-muted font-weight-normal\">Vor dem Festziehen</span></td><td class=\"py-3 px-3 align-middle\">Verdreht festgezogen lässt sich der Drall nur schwer korrigieren. Darum vorher prüfen, ob das Band flach liegt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Scheuert schnell<br><span class=\"small text-muted font-weight-normal\">Grate</span></td><td class=\"py-3 px-3 align-middle\">Oft haben Haken oder Ösen scharfe Grate. Einmal entgraten hilft.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie schnürt man F6-XR Flachsenkel an Boots mit Haken?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"ef469e96-9260-40f2-9ddb-3068f443eef8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Am sichersten misst man die alten Senkel ungeschnürt von Spitze zu Spitze nach. Den F6-XR gibt es in 75, 90, 120 und 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Die nötige Länge hängt von Schnürart, Schafthöhe und Fuß ab, und an Boots liegen die Ösen weit auseinander. Deshalb hilft eine Faustregel nach Ösenpaaren hier wenig.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">75 cm<br><span class=\"small text-muted font-weight-normal\">Kurz</span></td><td class=\"py-3 px-3 align-middle\">Halbschuhe und Sneaker mit wenigen Ösen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Mittel</span></td><td class=\"py-3 px-3 align-middle\">Low-Top-Sneaker im Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Lang</span></td><td class=\"py-3 px-3 align-middle\">Knöchelhohe Boots, Moc-Toe-Boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Sehr lang</span></td><td class=\"py-3 px-3 align-middle\">Hohe Schnürstiefel, Workwear-Boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mehr dazu<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Unsere häufigen Fragen</a></td></tr></tbody></table></div></div><p>Ausführlich auf unserer Seite <a href=\"/laccico-finest-waxed-laces/schnuersenkel-laenge\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Schnürsenkel-Länge</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Länge wählt man für die Serie F6-XR bei Stiefeln und Boots?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"6f0b8ffb-36ed-4937-aae2-9f0adb98000b","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"SortFilter","type":"content","meta":{"uuid":"a4aafad3-96b5-4deb-8eff-9c50185cebc5","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoLaengenleiste","type":"content","meta":{"uuid":"ec5e98cc-88b6-435e-935c-ad4a7507c13e","isGlobalTemplate":false}