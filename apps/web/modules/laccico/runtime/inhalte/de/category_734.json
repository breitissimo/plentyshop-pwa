[{"name":"MultiGrid","type":"structure","meta":{"uuid":"811c5281-573c-40f6-b252-603b8619b06d","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"be0e82d0-cb2e-43a3-94c6-1bbfe33f1103","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"37ebd1cb-7021-4585-89df-9d6d19ec8d73","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"ad5a29d4-dc2a-4cc1-a93e-c968c70f23bb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Beide sind 2 mm Rundsenkel aus Baumwolle, der Unterschied liegt in der Wachsung. Der R2-SL läuft langsamer durch das Wachsbad und saugt sich stärker voll. Er ist doppelt gewachst und hat eine besondere Farbtiefe und einen prächtigen Glanz wie feines Kalbsleder.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">In der Hand ist der R2-SL anfangs griffiger und fester. Das gehört bei einem stark gewachsten Senkel dazu, mit dem Tragen wird er geschmeidig. Der R2-CS bekommt unsere Standardwachsung: gewachst, heiß gewalzt und poliert, mit seidenmattem Glanz. Der R2-SL wird in Italien gefertigt.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> CS &amp; SL&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">R2-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">R2-SL Splendore di Laccico</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert.</td><td class=\"py-3 px-3 align-middle\">Doppelt gewachst: längeres Wachsbad, mehr Politur.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Glanz<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Seidenmatt.</td><td class=\"py-3 px-3 align-middle\">Prächtiger Glanz wie feines Kalbsleder, besondere Farbtiefe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Griff<br><span class=\"small text-muted font-weight-normal\">Haptik</span></td><td class=\"py-3 px-3 align-middle\">Griffig, wird mit dem Tragen weicher.</td><td class=\"py-3 px-3 align-middle\">Anfangs deutlich griffiger und fester, wird mit dem Tragen geschmeidig.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Passt zu<br><span class=\"small text-muted font-weight-normal\">Schuhe</span></td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbys, Anzugschuhe für jeden Tag.</td><td class=\"py-3 px-3 align-middle\">Rahmengenähte Oxfords und Derbys aus Boxcalf oder Cordovan Shell.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längen<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">45–180 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was zeichnet die Serie Splendore di Laccico (R2-SL) im Vergleich zur Serie R2-CS technisch und haptisch aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c8336af8-b0e7-4177-8862-694f1302991c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>2 mm Rundsenkel harmonieren mit klassischen Schnürschuhen mit verdeckten Ösen: Oxfords, Derbys, Budapester und feine Schnürstiefeletten, bei Damen wie bei Herren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Bei verdeckten Ösen (Blindösen) sieht man von oben nur ein kleines Loch im Leder, darunter liegt eine feine Öse. Dafür ist der 2 mm Rundsenkel gemacht. Die langen Längen bis 180 cm gehen meist an Damenstiefel. Sneaker und Boots haben aufgesetzte Ösen oder Haken, dort sind dickere Senkel die bessere Wahl.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhtypen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Gut zu wissen</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxfords<br><span class=\"small text-muted font-weight-normal\">Geschlossene Schnürung</span></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Der Klassiker unter den Anzugschuhen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbys<br><span class=\"small text-muted font-weight-normal\">Offene Schnürung</span></td><td class=\"py-3 px-3 align-middle\">Meist verdeckte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Im klassischen Segment fast immer mit 2 mm Rundsenkel.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Budapester<br><span class=\"small text-muted font-weight-normal\">Lochmuster, Zopfnaht</span></td><td class=\"py-3 px-3 align-middle\">Heute meist verdeckte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Gemeint ist oft der Full Brogue: vorher die Ösen ansehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefeletten<br><span class=\"small text-muted font-weight-normal\">Fein, für Damen und Herren</span></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Meist 120 cm, Damenstiefel bis 180 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneaker, Boots<br><span class=\"small text-muted font-weight-normal\">Zum Vergleich</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen, Haken</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td><td class=\"py-3 px-3 align-middle\">Hier passen dickere Senkel.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhe harmonieren am besten mit 2 mm Rundsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"b9d56302-65c7-46ef-9ea0-c98466cdaf72","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Einen 2 mm Rundsenkel verwendet man, wenn der Schuh verdeckte Ösen hat. Der Senkel sollte etwas Spiel in der Öse haben, sonst wird seine Oberfläche beim Durchziehen stark beansprucht.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Verdeckte Ösen erkennt man daran, dass außen kein Metallring zu sehen ist, nur ein kleines Loch im Leder. Für die Länge misst man am sichersten die alten Senkel ungeschnürt von Spitze zu Spitze nach. Für klassisches Schuhwerk dient die Zahl der Ösenpaare als Faustregel, bei Damengrößen eher eine Stufe kürzer.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen für R2&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Ösenpaare</th><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1–2<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">45 cm</td><td class=\"py-3 px-3 align-middle\">Schuhe mit nur einem Lochpaar</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbys mit tief angesetzten Schnürteilen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Klassische Derbys und Oxfords mit 5 Lochpaaren</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbys und Oxfords bei kräftigem Fuß, Übergang zu knöchelhohen Schuhen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">ab 9<br><span class=\"small text-muted font-weight-normal\">Ösenpaare / Stiefel</span></td><td class=\"py-3 px-3 align-middle\">150–180 cm</td><td class=\"py-3 px-3 align-middle\">Hohe Schnürstiefel, meist Damenstiefel</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wann verwendet man einen Rundsenkel mit 2 mm Durchmesser (R2)?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"069c9238-db1e-4f57-852f-3c08af8951e2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der Splendore di Laccico passt zu feinen, klassischen Schuhen aus Glattleder: rahmengenähte Oxfords, Derbys und Budapester aus Boxcalf oder Cordovan Shell, dazu Abendschuhe und feine Damenstiefeletten.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Er ist doppelt gewachst und wird in Italien gefertigt. Glanz und Farbtiefe erinnern an gut gepflegtes Kalbsleder, die Farben tragen ihre italienischen Namen, von Bianco bis Grigio Ferro. Der Senkel, den ein guter Schuh erwartet. Wie alle 2 mm Rundsenkel ist er für verdeckte Ösen gemacht, in Längen von 45 bis 180 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhe für SL&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Leder &amp; Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boxcalf<br><span class=\"small text-muted font-weight-normal\">Poliertes Kalbsleder</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Glanz und Farbtiefe passen zum polierten Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Cordovan Shell<br><span class=\"small text-muted font-weight-normal\">Für Kenner</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Der tiefe Glanz des Cordovan findet hier seine Entsprechung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Abendschuhe<br><span class=\"small text-muted font-weight-normal\">Smoking, Frack, Festtag</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Ein feiner Senkel für die festliche Garderobe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Damenstiefeletten<br><span class=\"small text-muted font-weight-normal\">Fein, mit verdeckten Ösen</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Lange Längen bis 180 cm, auch für Stiefel.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhe passen zum exklusiven Splendore di Laccico (SL) Stil?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"485df272-eea0-4730-a26a-00a50798e69e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der 2 mm Rundsenkel fällt kaum auf und lässt Leder und Form des Schuhs wirken. Der 3 mm Rundsenkel ist sichtbar kräftiger und passt zu Schuhen, die selbst kräftiger gebaut sind.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Die Wirkung folgt der Öse: Verdeckte Ösen an feinen Halbschuhen verlangen den 2 mm Rundsenkel, aufgesetzte Ösen und Haken an Schnürstiefeletten und Boots den 3 mm Rundsenkel. Und je länger der Senkel, desto mehr sieht man von ihm. Am Halbschuh bleibt er ein Detail, an der Stiefelette wird er zur Fläche.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> 2 mm &amp; 3 mm&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Fein, fällt kaum auf.</td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">45–180 cm</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Kräftig, gut sichtbar.</td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">45–150 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie unterscheidet sich die optische Wirkung von 2 mm Rundsenkeln zu 3 mm Rundsenkeln?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"b8fc62f7-7936-4034-a6cc-660a3c48c88d","isGlobalTemplate":false},"conten