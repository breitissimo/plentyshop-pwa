[{"name":"MultiGrid","type":"structure","meta":{"uuid":"124c6bdf-755d-4dcd-a5b7-419df932b872","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"e13b0ece-bc48-487a-8aa8-bf46ca09715f","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"316f0747-1363-46bd-8116-aa1bc22d7f07","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Haben Derbys und Chukkas aufgesetzte Ösen, ist der 4 mm Flachsenkel (F4-CS) die richtige Wahl. Besonders beliebt ist er an Schnürstiefeletten mit Ösen und Haken.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Aufgesetzte Ösen erkennt man am Metallring, der außen zu sehen ist. Bei verdeckten Ösen sieht man von außen nur ein kleines Loch im Leder, dorthin gehören feinere Senkel: der 3 mm Flachsenkel oder der 2 mm Rundsenkel. Ob flach oder rund, ist an aufgesetzten Ösen Geschmackssache. Der 3 mm Rundsenkel passt dort ebenso.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhe &amp; Ösen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Senkel</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Smart Casual</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chukka Boots<br><span class=\"small text-muted font-weight-normal\">2–3 Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefeletten<br><span class=\"small text-muted font-weight-normal\">Knöchelhoch</span></td><td class=\"py-3 px-3 align-middle\">Unten Ösen, oben Haken.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schlanke Ledersneaker<br><span class=\"small text-muted font-weight-normal\">Sportlich-elegant</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 4 mm Innendurchmesser.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxford, klassisches Derby<br><span class=\"small text-muted font-weight-normal\">Verdeckte Ösen</span></td><td class=\"py-3 px-3 align-middle\">Von außen nur ein kleines Loch.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneaker, Boots<br><span class=\"small text-muted font-weight-normal\">Sneaker, Boots</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 5 mm Innendurchmesser.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Breite passt zu Derby-Schuhen und Chukkas?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3bc5afed-c731-4389-928d-e6267ae45c91","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den F4-CS gibt es in 45 Farben, von Weiß bis Schwarz, und in 60, 75, 90 und 120 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Neben Klassikern wie Schwarz, Dunkelbraun und Dunkelblau gibt es leise Töne wie Greige, Helltaupe oder Altrosa und kräftige wie Senfgelb, Fuchsia oder Türkis. So lässt sich der Senkel Ton in Ton zum Leder wählen oder bewusst als Akzent. Rot und Hellbeige gibt es in 60, 75 und 120 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farben&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Farbwelt</th><th scope=\"col\" class=\"py-3 px-3\">F4-CS Farben</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarz<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Schwarz</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weiß &amp; Creme<br><span class=\"small text-muted font-weight-normal\">3 Farben</span></td><td class=\"py-3 px-3 align-middle\">Weiß, Hellbeige, Greige</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grau<br><span class=\"small text-muted font-weight-normal\">4 Farben</span></td><td class=\"py-3 px-3 align-middle\">Hellgrau, Kieselgrau, Mittelgrau, Grau</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braun &amp; Beige<br><span class=\"small text-muted font-weight-normal\">15 Farben</span></td><td class=\"py-3 px-3 align-middle\">Hellbeige, Beige, Greige, Dunkelbeige, Helltaupe, Taupe, Hellbraun, Karamellbraun, Cognac, Nussbraun, Mittelbraun, Braun, Mahagoni, Dunkelbraun, Schwarzbraun</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Gelb<br><span class=\"small text-muted font-weight-normal\">2 Farben</span></td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Orange<br><span class=\"small text-muted font-weight-normal\">1 Farbe</span></td><td class=\"py-3 px-3 align-middle\">Orange</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rot &amp; Rosa<br><span class=\"small text-muted font-weight-normal\">9 Farben</span></td><td class=\"py-3 px-3 align-middle\">Rosa, Altrosa, Pink, Fuchsia, Magenta, Rot, Weinrot, Aubergine, Lila</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grün<br><span class=\"small text-muted font-weight-normal\">7 Farben</span></td><td class=\"py-3 px-3 align-middle\">Mintgrün, Hellgrün, Grün, Khakigrün, Olivgrün, Military Grün, Dunkelgrün</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blau<br><span class=\"small text-muted font-weight-normal\">6 Farben</span></td><td class=\"py-3 px-3 align-middle\">Hellblau, Türkis, Blau, Royalblau, Dunkelblau, Lila</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Farben gibt es beim gewachsten 4 mm Flachsenkel F4-CS?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c98ed839-4bc7-4d14-9fa6-fa95d5822ed9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den Flachsenkel legt man in den Haken ein: erst überkreuzen, dann unter Spannung einlegen. Zieht man ihn im Zugkanal des Hakens fest, scheuert er schnell.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Die falsche Zugrichtung ist der häufigste Grund für frühen Verschleiß an Haken. In den Ösen darunter führt man das Band mit einer Hand durch die Öse und lässt das Restende über einen Finger der anderen Hand unter leichter Spannung gleiten. Erst ziehen, wenn das Band flach liegt. Wer es einfacher mag, nimmt an Haken den 3 mm Rundsenkel, er ist dort weniger anfällig. Flach oder rund ist Geschmackssache.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Haken&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">So geht es</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ösen<br><span class=\"small text-muted font-weight-normal\">Unterer Teil</span></td><td class=\"py-3 px-3 align-middle\">Band mit einer Hand durch die Öse führen, das Restende unter leichter Spannung über einen Finger gleiten lassen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Überkreuzen<br><span class=\"small text-muted font-weight-normal\">Vor jedem Haken</span></td><td class=\"py-3 px-3 align-middle\">Erst kreuzen, dann zum Haken führen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">Oberer Teil</span></td><td class=\"py-3 px-3 align-middle\">Unter Spannung einlegen, nicht durch den Zugkanal festziehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Scheuert schnell<br><span class=\"small text-muted font-weight-normal\">Grate</span></td><td class=\"py-3 px-3 align-middle\">Oft haben Haken oder Ösen scharfe Grate. Einmal entgraten hilft.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rund statt flach<br><span class=\"small text-muted font-weight-normal\">Geschmackssache</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie schnürt man 4 mm Flachsenkel an Schuhen mit Haken?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"82403c83-70f6-47fa-b914-d52437ff6d08","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Straff geflochtene Senkel aus 100 % Baumwolle wie der F4-CS leiern nicht aus. Auch durchnässt behalten sie ihre Form.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Beim F4-CS werden Spulenzahl und Garnstärke beim Flechten auf den Senkel abgestimmt, danach wird er gewachst, heiß gewalzt und poliert. Die Enden sind mit verpressten Aglets versiegelt, deshalb fransen sie nicht aus.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F4-CS im Überblick&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">F4-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Geflecht</span></td><td class=\"py-3 px-3 align-middle\">100 % Baumwolle, dicht geflochten.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Unter Zug<br><span class=\"small text-muted font-weight-normal\">Dehnung</span></td><td class=\"py-3 px-3 align-middle\">Straff geflochten, leiert nicht aus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nässe<br><span class=\"small text-muted font-weight-normal\">Form</span></td><td class=\"py-3 px-3 align-middle\">Behält auch durchnässt seine Form.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Veredelung<br><span class=\"small text-muted font-weight-normal\">Wachs</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Enden<br><span class=\"small text-muted font-weight-normal\">Aglets</span></td><td class=\"py-3 px-3 align-middle\">Verpresst, fransen nicht aus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Herkunft<br><span class=\"small text-muted font-weight-normal\">Fertigung</span></td><td class=\"py-3 px-3 align-middle\">Gefertigt in der EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Zum Vergleich<br><span class=\"small text-muted font-weight-normal\">Andere Serien</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel dehnen sich beim Tragen nicht unerwünscht aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"731e48fa-c8e1-4655-9110-7099dadb6dd8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Am sichersten misst man die alten Senkel ungeschnürt von Spitze zu Spitze nach. Für klassische Schuhe hilft die Zahl der Ösenpaare als Faustregel, etwa 75 cm bei 4 bis 5 Ösenpaaren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Den F4-CS gibt es in 60, 75, 90 und 120 cm. Die passende Länge hängt auch von der Schnürart und vom Fuß ab. Je weiter die Ösen auseinanderliegen, wie an Sneakern, desto weniger passt die Faustregel. Bei Damengrößen reicht oft eine Stufe kürzer.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Ösenpaare</th><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Chukka Boots, Derbys mit kurzer Schnürung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Derbys mit aufgesetzten Ösen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbys bei kräftigem Fuß, schlanke Ledersneaker.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, Ledersneaker mit vielen Ösen.</td></tr></tbody></table></div></div><p>Ausführlich auf unserer Seite <a href=\"/laccico-finest-waxed-laces/schnuersenkel-laenge\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Schnürsenkel-Länge</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Länge wählt man für 4 mm Flachsenkel?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"f84618da-b631-47b5-86c4-37ac7782d46c","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"5d465ab7-8b48-4888-bdef-a1bcc5d29878","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"46d1099b-4535-4548-9bc5-73dcf84982c8","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ba3a6f38-be16-4bd6-bd7e-7127b0e3466c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]