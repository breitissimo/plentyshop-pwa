[{"name":"MultiGrid","type":"structure","meta":{"uuid":"d366ad36-fa4b-4bb7-af87-70f2ec96186e","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"9363a0fd-f9c3-431c-9a33-98a9bb376aa1","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"d0aed8a4-6eea-4c6c-82ab-15dcb34ccc02","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"5eeeffc8-52b4-4810-8d11-0eb28920177a","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"5518b9cf-541c-4a9a-9a92-549b848fb83f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Baumwollsenkel. Das Wachs durchdringt das dicht geflochtene Geflecht, Schmutz und Nässe setzen sich deshalb nicht so leicht in den Fasern fest wie bei ungewachsten Senkeln.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Für Boots richtet sich der Senkel nach den Ösen: Ab 4 mm Innendurchmesser passt der 3 mm Rundsenkel R3-CS, ab 5 mm Innendurchmesser auch die 6 mm Flachsenkel F6-CS und F6-XR. Ganz sauber bleibt ein getragener Senkel trotzdem nicht: Mit der Zeit entsteht eine Patina. Senfgelb verzeiht Gebrauchsspuren eher als helle Gelbtöne.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Boots &amp; Gelb&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Gelbton</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Winterboots<br><span class=\"small text-muted font-weight-normal\">Glatt- oder Rauleder</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzt, Haken</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb, Verkehrsgelb</td><td class=\"py-3 px-3 align-middle\">Kräftiger Akzent auf dunklem Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Workwear-Boots<br><span class=\"small text-muted font-weight-normal\">Heritage</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Verkehrsgelb</td><td class=\"py-3 px-3 align-middle\">Rustikal, im Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Freizeit-Boots<br><span class=\"small text-muted font-weight-normal\">Glatt- oder Rauleder</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Gelb, Zitrusgelb, Senfgelb, Verkehrsgelb</td><td class=\"py-3 px-3 align-middle\">Frisch und auffällig.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel trotzen winterlichem Schmutz und Matsch bei gelben Farbtönen am besten?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"7fa5a6c3-f838-4f4e-991d-c443275c8e54","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Schnürsenkel für Schuhe werden nicht gewebt, sondern geflochten. Gewebte Bänder kennt man als Zier- und Geschenkbänder.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Entscheidend ist, wie dicht geflochten wird. Spulenzahl und Garnstärke werden beim Flechten auf den jeweiligen Senkel abgestimmt. Ein dicht und straff geflochtener Senkel ist reißfest, dehnt sich kaum und behält auch nass seine Form.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Aufbau&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Form</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rundsenkel<br><span class=\"small text-muted font-weight-normal\">2 und 3 mm</span></td><td class=\"py-3 px-3 align-middle\">Rund geflochten, die dickeren um eine Kernkordel. Das gibt Volumen.</td><td class=\"py-3 px-3 align-middle\">Rund und formstabil.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flachsenkel<br><span class=\"small text-muted font-weight-normal\">3, 4 und 6 mm</span></td><td class=\"py-3 px-3 align-middle\">Hohle Kordel, die anschließend flach gewalzt wird.</td><td class=\"py-3 px-3 align-middle\">Liegt flach in der Schnürung.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtung<br><span class=\"small text-muted font-weight-normal\">Spulenzahl, Garnstärke</span></td><td class=\"py-3 px-3 align-middle\">Dicht geflochten aus 100 % Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Reißfest, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum sind dicht geflochtene Schnürsenkel für gelbe Kontrastbänder besser als gewebte Bänder?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3be2bae3-23c7-422c-b094-f7e38b354650","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>An schlanken Glattleder-Sneakern wirkt der 4 mm Flachsenkel F4-CS, an Retro-Sneakern mit Ösen ab 5 mm Innendurchmesser der 6 mm Flachsenkel F6-CS.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Auf weißem, grauem oder dunkelblauem Leder setzt Gelb einen frischen Akzent. Senfgelb wirkt dabei ruhiger, Zitrusgelb und Verkehrsgelb leuchten kräftiger.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Sneaker &amp; Gelb&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Gelbton</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Glattleder-Sneaker<br><span class=\"small text-muted font-weight-normal\">Schlank, minimalistisch</span></td><td class=\"py-3 px-3 align-middle\">Gestanzte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb</td><td class=\"py-3 px-3 align-middle\">Schlank und ruhig.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Retro-Sneaker<br><span class=\"small text-muted font-weight-normal\">Breite Ösenleiste</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb</td><td class=\"py-3 px-3 align-middle\">Sportlich und präsent.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weiße Sneaker<br><span class=\"small text-muted font-weight-normal\">Glatt- oder Rauleder</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Zitrusgelb, Verkehrsgelb</td><td class=\"py-3 px-3 align-middle\">Frisch, mit starkem Kontrast.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Flachsenkel passen zu sportlich-eleganten Sneakern als gelber Akzent?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3241b6fd-0149-445e-a2e5-63bc06e8ca51","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Die Dicke richtet sich nach den Ösen, nicht nach der Farbe. Für verdeckte Ösen sind die 2 mm Rundsenkel und der flache 3 mm Senkel gemacht, für aufgesetzte Ösen und Haken der 3 mm Rundsenkel und der 4 mm Flachsenkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der Senkel sollte etwas Spiel in der Öse haben, sonst wird er beim Durchziehen stark beansprucht. Gelb gibt es in allen diesen Serien. Die feinsten Töne hat die Serie R2-SL aus Italien: Giallo (Sonnengelb), Giallino (Blassgelb), Senape (Senf) und Panna (Sahne).</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Senkelstärke&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Gelbtöne</th><th scope=\"col\" class=\"py-3 px-3\">Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Gelb, Zitrusgelb, Senfgelb</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbys, Brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Giallo (Sonnengelb), Giallino (Blassgelb), Senape (Senf), Panna (Sahne)</td><td class=\"py-3 px-3 align-middle\">Feine Oxfords und Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb</td><td class=\"py-3 px-3 align-middle\">Derbys, Brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb, Verkehrsgelb</td><td class=\"py-3 px-3 align-middle\">Chukka-Boots, Schnürstiefeletten</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle\">Gelb, Senfgelb</td><td class=\"py-3 px-3 align-middle\">Offene Derbys, Schnürstiefeletten</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Dicke ist ideal für sportive Kontrastschnürungen mit gelben Senkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6302d3a1-8a4f-4aa0-affa-c604eefe5fca","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Leichten Staub nimmt ein weiches Baumwolltuch mit. Ist ein heller Senkel richtig verschmutzt, tauscht man ihn aus.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Den Senkel mit dem Tuch fest umschließen und kräftig durchziehen. Das verteilt zugleich das Wachs neu, ein stumpfer Senkel bekommt so seinen Glanz zurück. Wer helle Gelbtöne trägt, legt sich am besten einen Vorrat an.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Pflege &amp; Tausch&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Fall</th><th scope=\"col\" class=\"py-3 px-3\">Was man tut</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Staub<br><span class=\"small text-muted font-weight-normal\">Leicht verschmutzt</span></td><td class=\"py-3 px-3 align-middle\">Mit einem weichen Baumwolltuch fest umschließen und kräftig durchziehen.</td><td class=\"py-3 px-3 align-middle\">Der Staub ist weg.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Stumpfer Senkel<br><span class=\"small text-muted font-weight-normal\">Nach längerem Tragen</span></td><td class=\"py-3 px-3 align-middle\">Genauso mit dem Tuch durchziehen.</td><td class=\"py-3 px-3 align-middle\">Das Wachs verteilt sich neu, der Glanz kommt zurück.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Starker Schmutz<br><span class=\"small text-muted font-weight-normal\">Helle Gelbtöne</span></td><td class=\"py-3 px-3 align-middle\">Gegen ein frisches Paar tauschen.</td><td class=\"py-3 px-3 align-middle\">Wieder ein sauberes, frisches Gelb.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":