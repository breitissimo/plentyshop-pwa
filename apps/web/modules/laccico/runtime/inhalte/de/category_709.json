[{"name":"MultiGrid","type":"structure","meta":{"uuid":"41b3de18-cd84-4b34-b308-bb882d423622","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"8071eba6-ccb8-45f5-8c7d-b0507c273559","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"1542817c-0681-4621-bcd8-0598c2cfb8bb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der R2-CS ist der klassische 2 mm Rundsenkel von LACCICO: gewachst, heiß gewalzt und poliert, mit seidenmattem Glanz. Unsere Standardwachsung reicht für den Alltag völlig aus und sieht sehr gut aus.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Beim R2-SL läuft das Band langsamer durch das Wachsbad und saugt sich stärker voll. Er ist doppelt gewachst und anfangs griffiger. Beide sind aus 100 % Baumwolle, dicht geflochten und für verdeckte Ösen gemacht. Den R2-CS gibt es in 44 Farben.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> R2-CS &amp; R2-SL&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">R2-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">R2-SL Splendore di Laccico</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Standardwachsung: gewachst, heiß gewalzt, poliert.</td><td class=\"py-3 px-3 align-middle\">Doppelt gewachst: längeres Wachsbad, mehr Politur.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Glanz<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Seidenmatt.</td><td class=\"py-3 px-3 align-middle\">Prächtiger Glanz wie feines Kalbsleder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Griff<br><span class=\"small text-muted font-weight-normal\">Haptik</span></td><td class=\"py-3 px-3 align-middle\">Fest und formstabil.</td><td class=\"py-3 px-3 align-middle\">Anfangs griffiger, wird mit dem Tragen geschmeidig.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Farben<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">44 Farben, von Weiß bis Schwarzbraun.</td><td class=\"py-3 px-3 align-middle\">Über 40 Farben mit italienischen Namen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längen<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150 und 180 cm.</td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150 und 180 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Herkunft<br><span class=\"small text-muted font-weight-normal\">Fertigung</span></td><td class=\"py-3 px-3 align-middle\">Gefertigt in der EU.</td><td class=\"py-3 px-3 align-middle\">Gefertigt in Italien.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was zeichnet die Serie Classic Sportive (R2-CS) im Vergleich zur Serie R2-SL technisch und haptisch aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a3f57ded-4e85-4bd9-813b-91b3d56576ea","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der R2-CS passt zu klassischen Lederschuhen mit verdeckten Ösen: Oxfords mit geschlossener Schnürung, Derbys mit offener Schnürung, Budapester und feine Schnürstiefeletten, für Damen wie für Herren.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Bei verdeckten Ösen sieht man außen nur ein kleines Loch im Leder, darunter liegt eine feine Öse. Dafür ist der 2 mm Rundsenkel gemacht. Er steht dem Schuh, ohne sich vorzudrängen, und passt so auch zum Business-Schuh, der jeden Tag getragen wird. Schuhe mit aufgesetzten Ösen oder Haken, etwa Sneaker und Boots, brauchen dickere Senkel.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhe &amp; Schnitte&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Schnitt</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung des R2-CS</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxford<br><span class=\"small text-muted font-weight-normal\">Geschlossene Schnürung</span></td><td class=\"py-3 px-3 align-middle\">Die Schnürteile liegen unter dem Blatt.</td><td class=\"py-3 px-3 align-middle\">Die Schnürung bleibt schmal und ruhig.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Offene Schnürung</span></td><td class=\"py-3 px-3 align-middle\">Die Schnürteile liegen über dem Blatt und lassen sich weit aufklappen.</td><td class=\"py-3 px-3 align-middle\">Der feine Senkel lässt dem Schnitt den Vortritt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Budapester<br><span class=\"small text-muted font-weight-normal\">Lochmuster, Zopfnaht</span></td><td class=\"py-3 px-3 align-middle\">Meist mit verdeckten Ösen.</td><td class=\"py-3 px-3 align-middle\">Das Lochmuster bleibt im Mittelpunkt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefeletten<br><span class=\"small text-muted font-weight-normal\">Fein, mit verdeckten Ösen</span></td><td class=\"py-3 px-3 align-middle\">Knöchelhoch, viele Ösenpaare.</td><td class=\"py-3 px-3 align-middle\">Lange Längen bis 180 cm, auch für Damenstiefel.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhe und Schnitte harmonieren am besten mit R2-CS Rundsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f3845ee1-2375-491c-9a58-2b05a7f7f41c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das Wachs durchdringt das Baumwollgeflecht, danach wird der Senkel heiß gewalzt und poliert. So liegt er glatt und gleitet gleichmäßig durch die Öse, ohne an den Kanten zu reiben.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Wichtig ist das Verhältnis zur Öse: Der Senkel sollte etwas Spiel in der Öse haben, sonst wird seine Oberfläche beim Durchziehen stark beansprucht. Für die verdeckten Ösen klassischer Schuhe ist der 2 mm Rundsenkel deshalb die richtige Wahl.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Senkel &amp; Öse&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Punkt</th><th scope=\"col\" class=\"py-3 px-3\">Was hilft</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachs im Geflecht<br><span class=\"small text-muted font-weight-normal\">Gewachste Baumwolle</span></td><td class=\"py-3 px-3 align-middle\">Das Wachs durchdringt das Geflecht, die Fasern liegen gebunden.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Heiß gewalzt, poliert<br><span class=\"small text-muted font-weight-normal\">Oberfläche</span></td><td class=\"py-3 px-3 align-middle\">Der Senkel liegt glatt und gleitet gleichmäßig.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Durchmesser<br><span class=\"small text-muted font-weight-normal\">Etwas Spiel in der Öse</span></td><td class=\"py-3 px-3 align-middle\">2 mm für verdeckte Ösen, dickere Senkel für aufgesetzte Ösen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grate an Ösen<br><span class=\"small text-muted font-weight-normal\">Schlecht verarbeitete Ösen</span></td><td class=\"py-3 px-3 align-middle\">Raue Ösenkanten einmal vorsichtig entgraten.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nässe<br><span class=\"small text-muted font-weight-normal\">Form</span></td><td class=\"py-3 px-3 align-middle\">Er behält auch durchnässt seine Form, weil er eng geflochten ist.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum gleiten gewachste R2-CS Rundsenkel besonders materialschonend durch verdeckte Ösen?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"b1bce121-ade4-4d29-8731-ee7ab157f8f1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Bei 4 bis 5 Ösenpaaren passen 75 cm, bei 5 bis 6 Ösenpaaren 90 cm. Bei 5 Ösenpaaren entscheidet der Fuß: 75 cm ist bei klassischen Derbys und Oxfords der Normalfall, bei kräftigem Fuß sind 90 cm die bessere Wahl.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Am sichersten misst man die alten Senkel ungeschnürt von Spitze zu Spitze nach. Bei Damengrößen reicht oft eine Stufe kürzer. Die Faustregel gilt für klassisches Schuhwerk mit verdeckten Ösen, wie es zum R2-CS gehört.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen 4–6 Ösenpaare&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Ösenpaare</th><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 Ösenpaare<br><span class=\"small text-muted font-weight-normal\">Halbschuh</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Derbys und Oxfords mit kurzer Schnürung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5 Ösenpaare<br><span class=\"small text-muted font-weight-normal\">Normalfall</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Der klassische 5-Loch-Derby oder -Oxford.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5 Ösenpaare<br><span class=\"small text-muted font-weight-normal\">Kräftiger Fuß</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Gleicher Schuh, mehr Volumen am Spann.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 Ösenpaare<br><span class=\"small text-muted font-weight-normal\">Höher geschnitten</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Übergang zu knöchelhohen Schuhen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weitere Längen<br><span class=\"small text-muted font-weight-normal\">R2-CS</span></td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">Von der Stiefelette bis zum Damenstiefel.</td></tr></tbody></table></div></div><p>Ausführlich auf unserer Seite <a href=\"/laccico-finest-waxed-laces/schnuersenkel-laenge\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Schnürsenkel-Länge</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Länge benötigt man für R2-CS bei 4 bis 6 Ösenpaaren?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4823df3d-2d71-4c54-ac98-4a5c831ca0d8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für Business-Schuhe eignen sich vor allem Schwarz, Dunkelbraun, Schwarzbraun, Mittelbraun, Dunkelblau und Weinrot. Ton in Ton zum Leder gewählt, bleibt der Senkel ganz im Hintergrund.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zu schwarzem Boxcalf gehört Schwarz, wer einen leisen Kontrast mag, wählt Schiefergrau. Braune Schuhe trägt man am einfachsten mit dem passenden Braunton. Dunkelblau und Weinrot setzen auf dunklem Leder einen dezenten Akzent. Insgesamt gibt es den R2-CS in 44 Farben, jede in allen Längen von 45 bis 180 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Business-Farben&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuhleder</th><th scope=\"col\" class=\"py-3 px-3\">R2-CS Farbe</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarz<br><span class=\"small text-muted font-weight-normal\">Glattleder, Boxcalf</span></td><td class=\"py-3 px-3 align-middle\">Schwarz, Schiefergrau</td><td class=\"py-3 px-3 align-middle\">Ton in Ton formell, mit Schiefergrau leiser Kontrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraun<br><span class=\"small text-muted font-weight-normal\">Mokka, Espresso</span></td><td class=\"py-3 px-3 align-middle\">Dunkelbraun, Schwarzbraun</td><td class=\"py-3 px-3 align-middle\">Der Senkel geht im Leder auf.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mittelbraun<br><span class=\"small text-muted font-weight-normal\">Kastanie</span></td><td class=\"py-3 px-3 align-middle\">Mittelbraun, Braun, Nussbraun</td><td class=\"py-3 px-3 align-middle\">Warmer, natürlicher Übergang zum Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hellbraun<br><span class=\"small text-muted font-weight-normal\">Cognac</span></td><td class=\"py-3 px-3 align-middle\">Karamellbraun, Hellbraun</td><td class=\"py-3 px-3 align-middle\">Hell und frisch, passend zum Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkles Leder<br><span class=\"small text-muted font-weight-normal\">Akzent</span></td><td class=\"py-3 px-3 align-middle\">Dunkelblau, Weinrot</td><td class=\"py-3 px-3 align-middle\">Ein dezenter Farbakzent für Kenner.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Alle Farben<br><span class=\"small text-muted font-weight-normal\">44 Farben</span></td><td class=\"py-3 px-3 align-middle\">Jede Farbe in 45, 60, 75, 90, 120, 150 und 180 cm.</td><td class=\"py-3 px-3 align-middle\">Ton in Ton oder als Akzent.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Basisfarben der R2-CS Serie eignen sich am besten für klassische Business-Kombinationen?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"de55bce8-0f8b-4856-adf9-1f305c11883a","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"3b9175a1-96df-4cb5-94ea-39d09b526355","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"99bd59c3-1e12-4f2d-9f95-42cca0980d96","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ba8a601c-6bb2-4645-bf70-a83108eca30f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]