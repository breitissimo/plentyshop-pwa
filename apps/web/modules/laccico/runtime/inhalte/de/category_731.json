[{"name":"MultiGrid","type":"structure","meta":{"uuid":"cdefd3f0-6416-4619-a44a-5b174a968c42","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"f5f97977-67ff-456b-a2eb-a60474d3d4aa","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"7481bff1-9f1e-43b9-a5d1-3bc4afd29a27","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"76074c70-2422-4f6d-85c5-1228060d8ab4","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Neben Schwarz und Dunkelbraun sind an Business-Schuhen vor allem gedeckte Töne gefragt: Dunkelblau, Weinrot und warme Brauntöne wie Tabacco oder Karamellbraun.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zu formellen Oxfords mit verdeckten Ösen passt der 2 mm Rundsenkel Ton in Ton. Der schmale 3 mm Flachsenkel sorgt an klassischen Lederschuhen für einen kleinen Überraschungseffekt, den Kenner bemerken.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farb- &amp; Modellguide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Farbwelt</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Form &amp; Maß</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Passt zu</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarz &amp; Dunkelbraun<br><span class=\"small text-muted font-weight-normal\">Ton in Ton</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">2 mm rund</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords, Plain Derbys und Anzugschuhe mit verdeckten Ösen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bordo (Weinrot)<br><span class=\"small text-muted font-weight-normal\">Akzent mit Farbtiefe</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2 mm rund<br>(doppelt gewachst)</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Dunkelbraune Lederschuhe, Cordovan Shell und festliche Abendschuhe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelblau<br><span class=\"small text-muted font-weight-normal\">Dezenter Business-Kontrast</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">3 mm flach</td><td class=\"py-3 px-3 align-middle\">60, 75, 90, 120 cm</td><td class=\"py-3 px-3 align-middle\">Braune Brogues und Semibrogues, zu Anzügen aus Kammgarn oder Flanell.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Karamellbraun &amp; Beige<br><span class=\"small text-muted font-weight-normal\">Warm und unkompliziert</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">4 mm flach</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Derbys aus Rauleder, Schnürstiefeletten und Business-Casual-Schuhe.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Farben liegen bei modernen Herren-Business-Schuhen im Trend?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"5017d204-9461-4ade-a869-2f9737b53998","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Schuhbänder aus Baumwolle haben eine glatte Oberfläche mit dezentem Glanz, die sich harmonisch mit der Textur feinster Schuhleder verbindet.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das dicht geflochtene Geflecht bleibt formstabil und ergibt ein sauberes Schnürbild. Weil das Wachs die Reibung verringert, gleitet der Senkel geschmeidig durch die Ösen und bleibt lange ansehnlich.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Oberflächen- &amp; Modellguide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Form &amp; Maß</th><th scope=\"col\" class=\"py-3 px-3\">Oberfläche</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Passt zu</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">2 mm rund</td><td class=\"py-3 px-3 align-middle\">Gewachst, seidenmatt</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords und Derbys mit verdeckten Ösen.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2 mm rund</td><td class=\"py-3 px-3 align-middle\">Doppelt gewachst, besondere Farbtiefe und Glanz</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Rahmengenähte Schuhe aus Kalbsleder oder Cordovan Shell.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">3 mm flach</td><td class=\"py-3 px-3 align-middle\">Gewachst, sehr dezent</td><td class=\"py-3 px-3 align-middle\">60, 75, 90, 120 cm</td><td class=\"py-3 px-3 align-middle\">Brogues und feine Anzugschuhe mit verdeckten Ösen.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">4 mm flach</td><td class=\"py-3 px-3 align-middle\">Gewachst, seidenmatt</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Derbys und Schnürstiefeletten mit Ösen und Haken.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum passen gewachste Schnürsenkel so gut zu feinem Lederschuhwerk?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"1564da85-3d2e-45ec-abe4-6c0d77dbdeff","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Einen Lappen mit etwas Schuhcreme fest um den Senkel schließen und kräftig entlangziehen. Durch Reibung und Wärme verteilt sich das Wachs neu, und der Glanz kommt zurück.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dass der Glanz mit Nässe und Gebrauch nachlässt, ist normal. Mit der Zeit entsteht eine Patina, die zum getragenen Schuh passt.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Pflege-Guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Methode</th><th scope=\"col\" class=\"py-3 px-3\">Geeignet für</th><th scope=\"col\" class=\"py-3 px-3\">So geht es</th><th scope=\"col\" class=\"py-3 px-3\">Hinweis</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lappen mit Schuhcreme<br><span class=\"small text-muted font-weight-normal\">Der Klassiker</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td><td class=\"py-3 px-3 align-middle\">Lappen mit wenig Creme um den Senkel legen und kräftig entlangziehen.</td><td class=\"py-3 px-3 align-middle\">Finger mit dem Tuch oder einem Stück Leder schützen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ganz ausfädeln<br><span class=\"small text-muted font-weight-normal\">Ab und zu</span></td><td class=\"py-3 px-3 align-middle\">Alle Serien</td><td class=\"py-3 px-3 align-middle\">Den Senkel herausnehmen und auf ganzer Länge behandeln.</td><td class=\"py-3 px-3 align-middle\">So bekommen auch die verdeckten Stellen etwas ab.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bügeleisen<br><span class=\"small text-muted font-weight-normal\">Für Flachsenkel</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td><td class=\"py-3 px-3 align-middle\">Kurz mit höherer Hitze über den Senkel gehen, das Wachs verteilt sich neu.</td><td class=\"py-3 px-3 align-middle\">Die Bügelsohle danach gründlich reinigen.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie frischt man den Seidenglanz gewachster Schnürsenkel wieder auf?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a53e80cd-5dbe-4fa6-ac08-6eca5f18ff4f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das Wachs durchdringt das Fasergefüge des Baumwollgeflechts vollständig, ähnlich wie Gerbstoffe das Leder. Es schützt die Baumwolle vor Nässe und Abrieb und macht den Senkel langlebig.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Außerdem verringert das Wachs die Reibung, sodass der Senkel geschmeidig durch die Ösen gleitet. Der Splendore (SL) liegt länger im Wachsbad, daher kommt seine besondere Farbtiefe.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Veredelungs- &amp; Modellguide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wachsung</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Einsatz</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Gewachst</td><td class=\"py-3 px-3 align-middle\">Seidenmatt, wetterfest und langlebig.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Business-Schuhe mit verdeckten Ösen.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Gewachst</td><td class=\"py-3 px-3 align-middle\">Seidenmatt, wetterfest und langlebig.</td><td class=\"py-3 px-3 align-middle\">45 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Halbschuhe und Schnürstiefeletten mit Haken.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">Doppelt gewachst</td><td class=\"py-3 px-3 align-middle\">Besondere Farbtiefe und Glanz.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Feine Lederschuhe und Cordovan Shell.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Gewachst</td><td class=\"py-3 px-3 align-middle\">Dezenter Glanz, gleitet leicht durch die Öse.</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Anzugschuhe, Brogues und Schnürstiefeletten.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Gewachst</td><td class=\"py-3 px-3 align-middle\">Reißfest und wetterfest; XR mit softig-massivem Griff aus kräftigeren Strängen.</td><td class=\"py-3 px-3 align-middle\">75 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Sneaker, Boots und Workwear-Stiefel (XR).</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was bewirkt die hochwertige Wachsung bei Baumwoll-Schnürsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"07cbf86e-1382-4f46-be0d-36a2f09dd7a7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das Wachs füllt das dicht geflochtene Baumwollgeflecht. Schmutz und Nässe setzen sich deshalb nicht so leicht in den Fasern fest wie bei ungewachsten Senkeln.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Ganz sauber bleibt ein getragener Senkel trotzdem nicht: Mit der Zeit entsteht eine Patina, die zum Schuh passt. Verschmutzte helle Senkel tauscht man aus; wer helle Töne trägt, legt sich am besten einen Vorrat an.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farb- &amp; Alltagsguide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Farbwelt</th><th scope=\"col\" class=\"py-3 px-3\">Im Alltag</th><th scope=\"col\" class=\"py-3 px-3\">Tipp</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarz, Dunkelbraun, Dunkelblau<br><span class=\"small text-muted font-weight-normal\">Dunkle Töne</span></td><td class=\"py-3 px-3 align-middle\">Gebrauchsspuren fallen kaum auf.</td><td class=\"py-3 px-3 align-middle\">Ideal für den täglichen Einsatz im Büro.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grau, Beige, Braun<br><span class=\"small text-muted font-weight-normal\">Mittlere Töne</span></td><td class=\"py-3 px-3 align-middle\">Die Patina wirkt natürlich und passt zum getragenen Leder.</td><td class=\"py-3 px-3 align-middle\">Schön zu Rauleder und Casuals.</td><td class=\"py-3 px-3 align-middle\">Alle Serien</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weiß &amp; Creme<br><span class=\"small text-muted font-weight-normal\">Helle Töne</span></td><td class=\"py-3 px-3 align-middle\">Zeigen Schmutz am ehesten.</td><td class=\"py-3 px-3 align-middle\">Einen Vorrat anlegen und bei Bedarf tauschen.</td><td class=\"py-3 px-3 align-middle\">Alle Serien</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum sind gewachste Schnürsenkel besonders schmutzunempfindlich?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"MultiGrid","type":"structure","meta":{"uuid":"fc2df10b-5c67-459a-b25b-5816c4e23cc2","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"0dda0abf-751b-4a5c-9b86-5aa1006daf03","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"d49e9963-94c2-47b6-8d34-e21f2dee9789","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Farbwelten/Farbwelten-entdecken.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Farbwelten/Farbwelten-entdecken.jpg","tablet":"https://c