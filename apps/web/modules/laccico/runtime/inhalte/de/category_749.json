[{"name":"MultiGrid","type":"structure","meta":{"uuid":"a9b53849-5642-4418-88b3-683142b301c8","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"766a4d48-c72c-468c-9002-6a0693c23bcd","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"99d4a343-034a-44eb-a61b-69ea540acadc","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>In klassische rahmengenähte Halbschuhe gehören in erster Linie feine Senkel: der 2 mm Rundsenkel oder der schmale 3 mm Flachsenkel. Rahmengenähte Schnürstiefeletten, Boots und Country-Derbys mit aufgesetzten Ösen oder Haken brauchen dagegen oft kräftigere Senkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Viele klassische Halbschuhe haben verdeckte Ösen: Von oben sieht man nur ein Loch im Leder, darunter liegt eine feine Öse. Der Senkel sollte etwas Spiel in der Öse haben, sonst wird er beim Durchziehen stark beansprucht. Eine pauschale Empfehlung für 4 mm Flachsenkel lässt sich deshalb handwerklich nicht geben. Sie passen am besten in Ösen ab 4 mm Innendurchmesser, verdeckte Ösen haben meist nur 3 mm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Senkelbreite&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Brauntöne im Sortiment</th><th scope=\"col\" class=\"py-3 px-3\">Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Der Klassiker</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Für verdeckte Ösen.</td><td class=\"py-3 px-3 align-middle\">Hellbraun, Mittelbraun, Dunkelbraun, Schwarzbraun, bei SL z. B. Cognac, Tabacco, Testa di Moro</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbys, Full Brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flach<br><span class=\"small text-muted font-weight-normal\">Für Kenner</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Für verdeckte Ösen.</td><td class=\"py-3 px-3 align-middle\">Hellbraun, Mittelbraun, Cognac, Nussbraun, Dunkelbraun</td><td class=\"py-3 px-3 align-middle\">Plain Oxfords, Semi-Brogues, feine Halbschuhe</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Für Ösen und Haken</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Für aufgesetzte Ösen und Haken.</td><td class=\"py-3 px-3 align-middle\">Hellbraun, Mittelbraun, Cognac, Nussbraun, Dunkelbraun, Schwarzbraun</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Haken, Country-Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flach<br><span class=\"small text-muted font-weight-normal\">Für Ösen ab 4 mm Innendurchmesser</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Für aufgesetzte Ösen und Haken. In verdeckten Ösen wird er stark beansprucht.</td><td class=\"py-3 px-3 align-middle\">Beige, Cognac, Nussbraun, Dunkelbraun</td><td class=\"py-3 px-3 align-middle\">Country-Derbys, Schnürstiefeletten mit Haken</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel oder Schuhbänder gehören in rahmengenähte Lederschuhe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e4401952-4d57-4c92-8bff-54c88e300325","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Flachsenkel aus 100 % Baumwolle mit CS Finish haben einen dezenten, seidenmatten Glanz. Der passt zu Glattleder, Wildleder und Canvas, aus denen Retro-Sneaker meist gemacht sind.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das feine Flechtbild des 6 mm Flachsenkels F6-CS ist unaufdringlich und wirkt edel, auch in kräftigen Brauntönen. Wer es rustikaler mag, nimmt den F6-XR: Er hat mehr Garn und gröbere Stränge und bringt den Vintage-Look an Boots. Für Sneaker mit vielen Lochpaaren braucht man meist 90 bis 120 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Brauntöne am Sneaker&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Sneaker</th><th scope=\"col\" class=\"py-3 px-3\">Senkelfarbe</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weißes Leder<br><span class=\"small text-muted font-weight-normal\">Court-Sneaker</span></td><td class=\"py-3 px-3 align-middle\">Beige, Hellbeige, Greige</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Warmer, weicher Kontrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braunes Wildleder<br><span class=\"small text-muted font-weight-normal\">Velours, Nubuk</span></td><td class=\"py-3 px-3 align-middle\">Hellbraun, Karamellbraun, Cognac</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Ton in Ton.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Canvas<br><span class=\"small text-muted font-weight-normal\">Natur, Oliv, Navy</span></td><td class=\"py-3 px-3 align-middle\">Nussbraun, Dunkelbraun</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Ruhiger, klassischer Akzent.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, Heritage</span></td><td class=\"py-3 px-3 align-middle\">Beige, Hellbraun, Karamellbraun, Dunkelbraun</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Kräftig, im Vintage-Look.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum passen gewachste Flachsenkel so gut zu Retro-Sneakern?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"9a7a76d5-a4f8-4260-9228-4c83e63b1dee","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Ersetzen muss man sie nicht sofort. Durch Reibung und Wärme verteilt sich das Wachs im Senkel neu, und der Glanz kommt zurück. Das lässt sich öfter wiederholen, aber nicht ewig.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dazu nimmt man den Senkel relativ fest zwischen die Finger, geschützt durch ein weiches Baumwolltuch oder ein Stück Leder (Streichfetzen), und zieht ihn mehrmals kräftig hindurch. Wenn es farblich passt, dient auch der Putzlappen bestens, da er meist schon mit Schuhcreme benetzt ist. Meistertipp: Den Senkel ab und zu ganz ausfädeln, damit auch die verdeckten Stellen gepflegt werden.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Stumpfe Senkel auffrischen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Methode</th><th scope=\"col\" class=\"py-3 px-3\">Hilfsmittel</th><th scope=\"col\" class=\"py-3 px-3\">So geht es</th><th scope=\"col\" class=\"py-3 px-3\">Wann</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Durchziehen<br><span class=\"small text-muted font-weight-normal\">Reibungswärme</span></td><td class=\"py-3 px-3 align-middle\">Baumwolltuch oder Lederrest</td><td class=\"py-3 px-3 align-middle\">Senkel fest umschließen und kräftig entlangziehen.</td><td class=\"py-3 px-3 align-middle\">Wenn der Senkel matt wirkt</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mit Schuhcreme<br><span class=\"small text-muted font-weight-normal\">Putzlappen</span></td><td class=\"py-3 px-3 align-middle\">Lappen mit etwas Schuhcreme in passender Farbe</td><td class=\"py-3 px-3 align-middle\">Genauso durchziehen, am besten gleich bei der Schuhpflege.</td><td class=\"py-3 px-3 align-middle\">Bei der Schuhpflege</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bügeleisen<br><span class=\"small text-muted font-weight-normal\">Nur Flachsenkel</span></td><td class=\"py-3 px-3 align-middle\">Bügeleisen</td><td class=\"py-3 px-3 align-middle\">Den Flachsenkel kurz überbügeln, danach das Eisen reinigen.</td><td class=\"py-3 px-3 align-middle\">Gelegentlich</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was kann man tun, wenn gewachste Schnürsenkel über die Jahre stumpf werden?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"dbc37471-dfa1-4281-b431-9035f1b2af08","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für cognacfarbene, mahagonifarbene und nussbraune Schuhe wählt man im Zweifel einen Farbton, der eine Nuance dunkler ist als das Oberleder.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Ein etwas dunklerer Braunton fasst die Ösenleiste ein und sorgt für ein ruhiges Gesamtbild. Hellere Töne setzen dagegen einen bewussten Akzent. Bei Wildleder darf es Ton in Ton sein.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Leder &amp; Brauntöne&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Senkelfarbe</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Cognac, helles Tan<br><span class=\"small text-muted font-weight-normal\">Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Mittelbraun, Nussbraun</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Klassisch, eine Spur dunkler als der Schuh.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nussbraun, Mahagoni<br><span class=\"small text-muted font-weight-normal\">Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Dunkelbraun, Schwarzbraun, Testa di Moro</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Ruhig und zeitlos.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraun<br><span class=\"small text-muted font-weight-normal\">Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Dunkelbraun, Testa di Moro</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Ton in Ton, mit einem Glanz wie feines Kalbsleder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraun<br><span class=\"small text-muted font-weight-normal\">Glattleder oder Wildleder</span></td><td class=\"py-3 px-3 align-middle\">Cognac, Karamellbraun</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Heller Akzent, bewusst gesetzt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Beiges Wildleder<br><span class=\"small text-muted font-weight-normal\">Velours, Nubuk</span></td><td class=\"py-3 px-3 align-middle\">Beige, Hellbeige, Greige</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Entspannt, Ton in Ton.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Farbe wählt man für cognacfarbene und nussbraune Schuhe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3f0772a0-b4af-43bc-b84e-27b46b5a1b95","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Ob sich ein Flachsenkel verdreht, hängt nicht vom Material ab. Es ist eine Frage der Handhabung beim Einfädeln und der passenden Senkelbreite zum Ösenmaß.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Man führt den Senkel mit der einen Hand durch die Öse und lässt das Restende über einen Finger der anderen Hand unter leichter Spannung gleiten. So wirkt die Öse wie eine Führungsschiene, und der Senkel bleibt flach. Ist er erst einmal unbemerkt verdreht festgezogen, lässt sich der Drall nur schwer wieder korrigieren.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Flachsenkel richtig einfädeln&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">So geht es</th><th scope=\"col\" class=\"py-3 px-3\">Typischer Fehler</th><th scope=\"col\" class=\"py-3 px-3\">Ergebnis</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1. Einfädeln<br><span class=\"small text-muted font-weight-normal\">Spitze voran</span></td><td class=\"py-3 px-3 align-middle\">Senkel flach ausrichten und die Spitze gerade durch die Öse führen.</td><td class=\"py-3 px-3 align-middle\">Spitze schräg oder verdreht in die Öse gedrückt.</td><td class=\"py-3 px-3 align-middle\">Der Senkel liegt von Anfang an flach.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2. Durchziehen<br><span class=\"small text-muted font-weight-normal\">Zweite Hand führt</span></td><td class=\"py-3 px-3 align-middle\">Das Restende über einen Finger unter leichter Spannung gleiten lassen.</td><td class=\"py-3 px-3 align-middle\">Ruckartig und ohne Führung durchgezogen.</td><td class=\"py-3 px-3 align-middle\">Der Senkel läuft flach durch die Öse.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3. Festziehen<br><span class=\"small text-muted font-weight-normal\">Erst prüfen</span></td><td class=\"py-3 px-3 align-middle\">Vor dem Festziehen nachsehen, ob der Senkel überall flach liegt.</td><td class=\"py-3 px-3 align-middle\">Verdreht festgezogen.</td><td class=\"py-3 px-3 align-middle\">Ein ruhiges, gleichmäßiges Schnürbild.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie verhindert man das Einrollen und Verdrehen von Flachsenkeln?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"a21a0a92-8db4-4258-b095-31ad9b730473","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"56d1c986-b269-46bf-af35-1481ca240f48","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"345fa89b-a0fc-43c1-af38-cc9c15794b59","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"23d7963f-2110-4a9a-ae6f-36774dd71dfa","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]