[{"name":"MultiGrid","type":"structure","meta":{"uuid":"49ae600c-6682-40e3-8025-f15988bf8905","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"1461cac1-f115-41a5-a1ab-8bc10c727d88","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"0665547f-8325-4011-83f4-40245f02641c","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"70d2c437-4cf7-4a71-b4c4-4009c4102083","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"54fc2fe3-1942-47b7-9e16-98eb441af6b1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Zu kräftigen Boots im Heritage- und Workwear-Stil passen der 3 mm Rundsenkel R3-CS und der 4 mm Flachsenkel F4-CS in Orange.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Solche Boots haben meist aufgesetzte Ösen und Haken, dafür sind beide Senkel gemacht. Auf dunklem Leder setzt Orange einen kräftigen Akzent, das dichte Baumwollgeflecht passt zum rustikalen Charakter schwerer Stiefel.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Boots &amp; Orange&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Orangeton</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Moc-Toe-Boots<br><span class=\"small text-muted font-weight-normal\">Heritage, Workwear</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzt, Haken</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle\">Kräftiger Akzent auf dunklem Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chukka-Boots<br><span class=\"small text-muted font-weight-normal\">Rau- oder Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzt</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle\">Lässig, passt zu Cord und Tweed.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefelette<br><span class=\"small text-muted font-weight-normal\">Dunkelbraunes Leder</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzt, Haken</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle\">Deutlich, aber nicht laut.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">High-Top-Sneaker<br><span class=\"small text-muted font-weight-normal\">Im Workwear-Look</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 5 mm Innendurchmesser</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle\">Frisch, mit sportlicher Note.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel passen zu modischen Heritage- und markanten Workwear-Styles mit orangen Akzenten?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"b84a08f5-e3bf-4916-9e04-abfddc4a78a1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Orange 3 mm Rundsenkel R3-CS oder 4 mm Flachsenkel F4-CS. Welcher von beiden passt, entscheiden die Ösen.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der Senkel sollte etwas Spiel in der Öse haben, sonst wird er beim Durchziehen stark beansprucht. Zu dunklem Leder bildet Orange einen lebendigen Kontrast. Für Halbschuhe gibt es Orange auch als 2 mm Rundsenkel und 3 mm Flachsenkel, für Sneaker als 6 mm Flachsenkel.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Orange &amp; Leder&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Orangeton</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dunkelbraune Boots<br><span class=\"small text-muted font-weight-normal\">Glatt- oder Rauleder</span></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Warmer, kräftiger Kontrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schwarze Boots<br><span class=\"small text-muted font-weight-normal\">Glattleder</span></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Starker Kontrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbys, Brogues<br><span class=\"small text-muted font-weight-normal\">Braunes oder blaues Wildleder</span></td><td class=\"py-3 px-3 align-middle\">Orange, Orange Juice · R2-SL: Arancione (Orange)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Frischer Farbtupfer.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Helle Sneaker<br><span class=\"small text-muted font-weight-normal\">Weiß oder hellgrau</span></td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Frisch und fröhlich.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel wählt man als markanten Signal-Akzent für Freizeit-Boots?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0afd4241-5023-4403-ab0c-a7df024b91dc","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Die Färbung übernehmen die Garnhersteller. Sie färben die Baumwollgarne mit speziellen Färbe- und Fixierverfahren, bevor daraus Senkel geflochten werden.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das Wachs bindet die Farbe nicht, bildet aber eine schützende Barriere: Es durchdringt das Fasergefüge des Geflechts. Beim normalen Tragen bleiben die Senkel dank guter Färbung lange farbstabil. Wirkt ein Senkel mit der Zeit stumpf, zieht man ihn kräftig durch ein weiches Baumwolltuch, dann kommt der Glanz zurück.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Farbe &amp; Wachs&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">Was passiert</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Färben<br><span class=\"small text-muted font-weight-normal\">Garn</span></td><td class=\"py-3 px-3 align-middle\">Die Garnhersteller färben und fixieren die Baumwollgarne.</td><td class=\"py-3 px-3 align-middle\">Gleichmäßiger Farbton über die ganze Länge.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsen<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert. Das Wachs durchdringt das Fasergefüge.</td><td class=\"py-3 px-3 align-middle\">Schützende Barriere, seidenmatter Glanz.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Auffrischen<br><span class=\"small text-muted font-weight-normal\">Baumwolltuch</span></td><td class=\"py-3 px-3 align-middle\">Den Senkel fest umschließen und kräftig durchziehen.</td><td class=\"py-3 px-3 align-middle\">Das Wachs verteilt sich neu, der Glanz kommt zurück.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie halten orange gefärbte gewachste Schnürsenkel ihre Farbe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"fd272980-55d1-4b11-bad7-aeb3612a0f7b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Dicht geflochtene, gewachste Baumwollsenkel. Sie dehnen sich kaum und behalten auch durchnässt ihre Form.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Spulenzahl und Garnstärke werden beim Flechten auf den jeweiligen Senkel abgestimmt. Das Wachs durchdringt das Fasergefüge und schützt vor Nässe. Ein Vorteil zeigt sich bei Regen: Die Schleife eines gewachsten Baumwollsenkels löst sich nicht so leicht.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Nässe &amp; Form&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtung<br><span class=\"small text-muted font-weight-normal\">Dicht und straff</span></td><td class=\"py-3 px-3 align-middle\">Spulenzahl und Garnstärke passend zum Senkel.</td><td class=\"py-3 px-3 align-middle\">Dehnt sich kaum, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nässe<br><span class=\"small text-muted font-weight-normal\">Regen, Schnee</span></td><td class=\"py-3 px-3 align-middle\">Eng geflochten aus 100 % Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Behält auch durchnässt die Form.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert.</td><td class=\"py-3 px-3 align-middle\">Schützt vor Nässe und Abrieb.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel behalten auch bei starker Nässe ihre Form?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c0467644-b1e3-489d-a894-e20369d01d0a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Reißfest wird ein Senkel durch gutes Garn und eine dichte, straffe Flechtung. Die Farbe spielt dabei keine Rolle.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">LACCICO Schnürsenkel bestehen aus 100 % Baumwolle, dicht geflochten und gewachst. Das Wachs schützt sie vor Abrieb. Reißt ein Senkel trotzdem früh, liegt es meist an einer gratigen Öse oder an der falschen Zugrichtung an Haken.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Aufbau &amp; Reißfestigkeit&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Was es bringt</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Garn<br><span class=\"small text-muted font-weight-normal\">Baumwolle</span></td><td class=\"py-3 px-3 align-middle\">100 % Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Reißfest.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtung<br><span class=\"small text-muted font-weight-normal\">Dicht und straff</span></td><td class=\"py-3 px-3 align-middle\">Spulenzahl und Garnstärke passend zum Senkel.</td><td class=\"py-3 px-3 align-middle\">Reißfest, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wachsung<br><span class=\"small text-muted font-weight-normal\">Veredelung</span></td><td class=\"py-3 px-3 align-middle\">Das Wachs durchdringt das Fasergefüge.</td><td class=\"py-3 px-3 align-middle\">Schützt vor Abrieb an der Öse.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Öse<br><span class=\"small text-muted font-weight-normal\">Passendes Maß</span></td><td class=\"py-3 px-3 align-middle\">Der Senkel hat etwas Spiel in der Öse.</td><td class=\"py-3 px-3 align-middle\">Wird beim Durchziehen nicht unnötig beansprucht.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie beeinflusst eine dichte Flechtung die Reißkraft von farbigen Senkeln?","defaultOpen":false}}}],"parent_slot":0,"slot_in