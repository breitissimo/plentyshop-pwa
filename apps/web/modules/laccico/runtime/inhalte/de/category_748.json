[{"name":"MultiGrid","type":"structure","meta":{"uuid":"d8081c68-16c8-446c-8599-10b5eecb4697","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"857f8fec-ddce-4b03-ad99-eddb5432b3d7","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"f1eee154-de83-478d-87e2-54d92ec762a4","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"f1201308-b14e-4a4a-8bcf-2dbf54e02807","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"93863bac-78d6-41f7-a964-7ddbe55150c1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Zu schwarzen Anzugschuhen gehört in aller Regel ein schwarzer Senkel. Den Unterschied macht das Finish: seidenmatt oder glänzend.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der R2-CS hat einen dezenten, seidenmatten Glanz und passt zu jedem Business-Schuh. Der doppelt gewachste Splendore (R2-SL) in Nero glänzt kräftiger. Zu hochglanzpoliertem Boxcalf gehört er wie die Manschettenknöpfe zum Smoking.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Finish-Vergleich&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wachsung</th><th scope=\"col\" class=\"py-3 px-3\">Glanz</th><th scope=\"col\" class=\"py-3 px-3\">Passt zu</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS (2 mm)</a></td><td class=\"py-3 px-3 align-middle\">Gewachst</td><td class=\"py-3 px-3 align-middle\">Dezent, seidenmatt</td><td class=\"py-3 px-3 align-middle\">Glattleder, Kalbsleder, Business-Schuhe</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (2 mm), Nero</a></td><td class=\"py-3 px-3 align-middle\">Doppelt gewachst</td><td class=\"py-3 px-3 align-middle\">Kräftiger Glanz mit Farbtiefe</td><td class=\"py-3 px-3 align-middle\">Poliertes Boxcalf, Cordovan Shell, Abendschuhe</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Farbe wählt man für Schnürsenkel bei tiefschwarzen Anzugschuhen?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"d63838b5-5bbb-4fb0-9933-28f3a85085e5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für feine Herrenschuhe mit verdeckten Ösen sind die 2 mm Rundsenkel R2-CS und R2-SL gemacht.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Wichtig ist das Ösenmaß: Der Senkel sollte etwas Spiel in der Öse haben, sonst wird seine Oberfläche beim Durchziehen zu stark beansprucht. Für aufgesetzte Ösen und Haken ist der 3 mm Rundsenkel R3-CS die bessere Wahl.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen- &amp; Modellguide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Durchmesser</th><th scope=\"col\" class=\"py-3 px-3\">Passende Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Eigenschaft</th><th scope=\"col\" class=\"py-3 px-3\">Schuhtypen</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Fein</span></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Gleitet leicht durch die Öse.</td><td class=\"py-3 px-3 align-middle\">Oxfords, Galaschuhe, feine Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Kräftig</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen und Haken</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Griffig, füllt Ösen ab 4 mm Innendurchmesser gut aus.</td><td class=\"py-3 px-3 align-middle\">Country-Derbys, kräftige Halbschuhe, Schnürstiefeletten</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Rundsenkel eignen sich für feine Herrenschuhe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a98dfc7c-7824-4568-9584-e6156f405860","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für elegante Abendschuhe nimmt man den 2 mm Rundsenkel (R2-CS oder R2-SL) oder den schmalen 3 mm Flachsenkel (F3-CS). Die Länge richtet sich nach der Zahl der Ösenpaare.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zum Smoking passt der glänzende Splendore. Der flache F3-CS ist sehr dezent und sorgt für einen kleinen Überraschungseffekt, den Kenner bemerken.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Abendschuh-Maße&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Form &amp; Maß</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Länge nach Ösenpaaren</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Typischer Abendschuh</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Doppelt gewachst</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2–3 Paar: 60 cm<br>4–5 Paar: 75 cm<br>5–6 Paar: 90 cm</td><td class=\"py-3 px-3 align-middle\">Kräftiger Glanz mit Farbtiefe.</td><td class=\"py-3 px-3 align-middle\">Smoking-Oxfords und festliche Schuhe aus poliertem Kalbsleder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Gewachst</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">2–3 Paar: 60 cm<br>4–5 Paar: 75 cm<br>5–6 Paar: 90 cm</td><td class=\"py-3 px-3 align-middle\">Dezent, seidenmatt.</td><td class=\"py-3 px-3 align-middle\">Business-Oxfords, Cap-Toes und Abend-Derbys.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flach<br><span class=\"small text-muted font-weight-normal\">Gewachst</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">2–3 Paar: 60 cm<br>4–5 Paar: 75 cm<br>5–6 Paar: 90 cm</td><td class=\"py-3 px-3 align-middle\">Sehr dezent, liegt flach auf.</td><td class=\"py-3 px-3 align-middle\">Plain Derbys und elegante Halbschuhe.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Maße haben klassische Senkel für elegante Abendschuhe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c238d5ae-14ed-45e1-afe2-3c2e4eff13ab","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Billige Schnürsenkel sind oft locker geflochten. An scharfen Ösenkanten scheuern sie deshalb schnell durch.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">LACCICO Schnürsenkel bestehen aus 100 % Baumwolle, dicht geflochten und gewachst. Das Wachs schützt sie vor Abrieb und Nässe. Reißt ein Senkel trotzdem früh, liegt es meist an einer gratigen Öse oder an der falschen Zugrichtung an Haken.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Aufbau &amp; Reißfestigkeit&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Form &amp; Stärke</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Aufbau</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Einsatz</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive / Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Dicht geflochtene Kordel, reißfest.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Business-Schuhe, rahmengenähte Oxfords und Abendschuhe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm und 4 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Formstabiles Flachgeflecht, leiert nicht aus.</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Derbys, Budapester, Glattledersneaker und Halbschuhe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm flach<br><span class=\"small text-muted font-weight-normal\">Xtra Robust</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Kräftige Stränge mit softig-massivem Griff, sehr belastbar.</td><td class=\"py-3 px-3 align-middle\">75 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Heritage-Boots, Workwear- und Outdoor-Stiefel.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Warum reißen billige Schnürsenkel so schnell?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6b2d624c-5b90-43c9-a706-a4923b628344","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Baumwolle ist reißfest, leiert nicht aus und behält auch nass ihre Form. Ihre glatte Oberfläche mit dezentem Glanz passt gut zu Glattleder.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Ein Vorteil zeigt sich bei Regen: Die Schleife eines gewachsten Baumwollsenkels löst sich nicht so leicht.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Gewachste Baumwolle&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Eigenschaft</th><th scope=\"col\" class=\"py-3 px-3\">Gewachste Baumwolle</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Unter Zug<br><span class=\"small text-muted font-weight-normal\">Form</span></td><td class=\"py-3 px-3 align-middle\">Leiert nicht aus, behält auch nass ihre Form.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oberfläche<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Glatt, dezenter Glanz, passt zu feinem Leder.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bei Nässe<br><span class=\"small text-muted font-weight-normal\">Schleife</span></td><td class=\"py-3 px-3 align-middle\">Die Schleife löst sich nicht so leicht.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Vorteile bieten Schnürsenkel aus 100% echter Baumwolle?","defaultOpen":false}}}],"parent_slot":0,"slot_index":2},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"a3e6cab8-cae3-4b50-a2e8-8a5737242ffc","isGlobalTemplate":false},"parent_slot":1,"slot_index":0,"content":{"teil":"titel"}},{"name":"SortFilter","type":"content","meta":{"uuid":"32e23bc5-d765-4256-b017-3aacd0d36fa2","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","man