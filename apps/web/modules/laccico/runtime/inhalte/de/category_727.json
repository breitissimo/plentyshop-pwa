[{"name":"MultiGrid","type":"structure","meta":{"uuid":"d9e4a019-b80c-4134-9fed-09b44976a85b","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"1b3457b6-8df4-4939-b8bb-4bca897951dc","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"0610631f-6382-427e-8642-3f7211c09c84","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"2e570f5d-c9bd-4eb9-b71f-74bda3b242ed","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Rundsenkel sind eine runde Kordel und wirken zurückhaltend. Flachsenkel sind ein flaches Band, liegen flach auf der Zunge und zeigen mehr vom Senkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Beim Rundsenkel wird das Geflecht, vor allem bei den dickeren, um eine Kernkordel geflochten, so entsteht das Volumen. Der Flachsenkel ist eine hohle Kordel, die anschließend flach gewalzt wird. Welche Form passt, entscheiden der Schuh und seine Ösen: Der Senkel sollte etwas Spiel in der Öse haben. Für verdeckte Ösen sind der 2 mm Rundsenkel und der 3 mm Flachsenkel gemacht, alle dickeren Senkel für aufgesetzte Ösen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Rund &amp; flach&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Passt zu</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Fällt kaum auf, elegant und zurückhaltend.</td><td class=\"py-3 px-3 align-middle\">Klassische Oxfords und Derbys</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td><td class=\"py-3 px-3 align-middle\">Schmal und flach, ein kleiner Akzent, den Kenner bemerken.</td><td class=\"py-3 px-3 align-middle\">Klassische Halbschuhe zu feinen Anzugstoffen</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm rund<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen, Haken</td><td class=\"py-3 px-3 align-middle\">Kräftiger und präsenter als 2 mm.</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Haken, Boots</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen, Haken</td><td class=\"py-3 px-3 align-middle\">Schlank, aber gut sichtbar.</td><td class=\"py-3 px-3 align-middle\">Knöchelhohe Schnürschuhe, schlanke Ledersneaker</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm flach<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Xtra Robust</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 5 mm Innendurchmesser</td><td class=\"py-3 px-3 align-middle\">CS fein und edel, XR kräftig im Vintage-Look.</td><td class=\"py-3 px-3 align-middle\">Sneaker, Boots, Komfortschuhe</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was ist der Unterschied zwischen Rundsenkeln und Flachsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"1a8a41e3-f542-4a91-a7d5-438e2f27912f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Zeitlos wirkt ein Senkel, der in Form, Stärke und Farbe zum Schuh passt. Je feiner der Schuh, desto feiner der Senkel; je kräftiger der Schuh, desto kräftiger darf der Senkel sein.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">An klassischen Halbschuhen aus Glattleder mit verdeckten Ösen sind der 2 mm Rundsenkel und der 3 mm Flachsenkel zu Hause. Der Rundsenkel tritt ganz zurück, der schmale Flachsenkel setzt einen leisen Akzent. Schnürstiefeletten, Boots und Sneaker mit aufgesetzten Ösen tragen kräftigere Senkel: 3 mm rund, 4 mm oder 6 mm flach. Trends spielen dabei keine Rolle, entscheidend ist, dass Senkel und Schuh zusammenpassen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Look &amp; Schuh&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Look</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Passende Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Klassisch-elegant<br><span class=\"small text-muted font-weight-normal\">Glattleder, verdeckte Ösen</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Dezent, der Senkel tritt zurück.</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbys, Anzugschuhe</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Für Kenner<br><span class=\"small text-muted font-weight-normal\">Leiser Akzent</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Schmal und flach, fällt erst auf den zweiten Blick auf.</td><td class=\"py-3 px-3 align-middle\">Klassische Halbschuhe zu Anzug und Kostüm</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Klassisch-sportlich<br><span class=\"small text-muted font-weight-normal\">Aufgesetzte Ösen</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Schlank und seidenmatt glänzend.</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, Ledersneaker</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Kräftig<br><span class=\"small text-muted font-weight-normal\">Ösen und Haken</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Rund und präsent.</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Haken, Boots</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneaker &amp; Vintage<br><span class=\"small text-muted font-weight-normal\">Breites Band</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">CS fein und edel, XR kräftig im Vintage-Look.</td><td class=\"py-3 px-3 align-middle\">Sneaker, Heritage- und Workwear-Boots</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Form sorgt für einen zeitlosen Look?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0977e668-8733-4a93-aabb-2ad4da7e229a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Berechnen ließe sich die Länge schon, wenn man Schnürart, Fuß und Senkelstärke genau erfasst. In der Praxis macht das aber niemand: Am einfachsten und sichersten misst man die alten Senkel im ungeschnürten Zustand von Spitze zu Spitze nach.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dickere Senkel brauchen etwas mehr Länge als dünne. Für klassisches Schuhwerk dient die Zahl der Ösenpaare als Faustregel. Je weiter die Ösen auseinanderliegen, desto weniger passt sie, etwa bei Sneakern und Boots.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Faustregel klassische Schuhe&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Ösenpaare</th><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Schuhe</th><th scope=\"col\" class=\"py-3 px-3\">Serien</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1–2<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">45 cm</td><td class=\"py-3 px-3 align-middle\">Schuhe mit nur einem oder zwei Lochpaaren</td><td class=\"py-3 px-3 align-middle\">R2, R3</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbys mit tief angesetzten Schnürteilen</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Klassische Derbys und Oxfords mit 5 Lochpaaren</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbys und Oxfords bei kräftigem Fuß, Übergang zu knöchelhohen Schuhen</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">Ösenpaare</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Klassische Schnürstiefeletten</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">ab 9<br><span class=\"small text-muted font-weight-normal\">Ösenpaare / Stiefel</span></td><td class=\"py-3 px-3 align-middle\">150–180 cm</td><td class=\"py-3 px-3 align-middle\">Hohe Schnürstiefel, Damenstiefel</td><td class=\"py-3 px-3 align-middle\">R2 (bis 180 cm), R3, F6 (bis 150 cm)</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie berechnet man die richtige Schnürsenkel-Länge anhand der Ösenpaare?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"9ceb1ad9-1a63-432e-b6d6-633fd8dc7ac8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der Senkel sollte etwas Spiel in der Öse haben, sonst wird seine Oberfläche beim Durchziehen stark beansprucht.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Bei verdeckten Ösen (Blindösen) sieht man von oben nur ein kleines Loch im Leder, darunter liegt eine feine Öse. Dafür sind der 2 mm Rundsenkel und der 3 mm Flachsenkel gemacht. Alle dickeren Senkel sind für aufgesetzte Ösen. Scheuert ein Senkel früh durch, liegt es meist an Graten in der Öse; dann die Öse einmal entgraten.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Ösen &amp; Dicke&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Öse</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Gut zu wissen</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Verdeckte Öse<br><span class=\"small text-muted font-weight-normal\">Blindöse</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">R2: 45–180 cm<br>F3: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">Von oben sieht man nur ein kleines Loch im Leder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Aufgesetzte Öse<br><span class=\"small text-muted font-weight-normal\">Sichtbarer Ring</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">R3: 45–150 cm<br>F4: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">Für Schnürstiefeletten und Ledersneaker.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">An knöchelhohen Schuhen</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">R3: 45–150 cm<br>F4: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">Den Senkel nach dem Überkreuzen unter Spannung einlegen, nicht durchziehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Aufgesetzte Öse ab 5 mm Innendurchmesser<br><span class=\"small text-muted font-weight-normal\">Sneaker, Boots</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">F6: 75–150 cm</td><td class=\"py-3 px-3 align-middle\">Etwa an Court-Sneakern und Boots.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel-Dicke passt zu welchem Ösenloch?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"b2204d40-7c81-4d39-bafa-cde790b293e8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Baumwollsenkel passen zum Leder: dezenter Glanz, wertige Haptik, dazu reißfest und langlebig.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das Wachs durchdringt das Fasergefüge des Baumwollgeflechts, ähnlich wie Gerbstoffe das Leder. Heiß gewalzt und poliert bekommt der Senkel seinen dezenten Glanz und sieht aus wie ein feines Lederband. Er ist wasserabweisend, behält auch nass seine Form und dehnt sich kaum. Bei Nässe löst sich die Schleife nicht so leicht.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Gewachste Baumwolle&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">Gewachste Baumwolle</th><th scope=\"col\" class=\"py-3 px-3\">Woher es kommt</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Optik<br><span class=\"small text-muted font-weight-normal\">Glanz</span></td><td class=\"py-3 px-3 align-middle\">Dezenter Glanz, harmoniert mit feinem Schuhleder.</td><td class=\"py-3 px-3 align-middle\">Gewachst, heiß gewalzt und poliert.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haptik<br><span class=\"small text-muted font-weight-normal\">In der Hand</span></td><td class=\"py-3 px-3 align-middle\">Griffig und wertig. Anfangs etwas steif, mit der Zeit geschmeidiger.</td><td class=\"py-3 px-3 align-middle\">Wachs im Geflecht.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nässe<br><span class=\"small text-muted font-weight-normal\">Regen</span></td><td class=\"py-3 px-3 align-middle\">Wasserabweisend, behält auch nass seine Form.</td><td class=\"py-3 px-3 align-middle\">Wachs und dichte Flechtung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haltbarkeit<br><span class=\"small text-muted font-weight-normal\">Im Alltag</span></td><td class=\"py-3 px-3 align-middle\">Reißfest, dehnt sich kaum.</td><td class=\"py-3 px-3 align-middle\">Straffe Flechtung aus 100 % Baumwolle.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schleife<br><span class=\"small text-muted font-weight-normal\">Unterwegs</span></td><td class=\"py-3 px-3 align-middle\">Sie hält, wenn sie richtig gebunden ist. Geht sie auf, war es meist ein Altweiberknoten: den Startknoten einmal andersherum binden.</td><td class=\"py-3 px-3 align-middle\">Die Bindetechnik, nicht der Senkel.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Vorteile bieten gewachste Schnürsenkel aus 100 % Baumwolle?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"MultiGrid","type":"structure","meta":{"uuid":"50c1bfa0-c4ce-4160-b3cb-aa21add52388","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"6ba225da-34d2-47c3-9280-f0abb4db94fb","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"0e0636e5-e790-469e-89b7-65104459fefc","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","mobile":"https://cdn02.plentyone.com/qadol2fd