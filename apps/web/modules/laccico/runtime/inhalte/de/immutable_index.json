cope=\"col\" class=\"py-3 px-3\">Empfohlener Schuhtyp</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" class=\"text-dark font-weight-bold\">R2-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Rundsenkel\n\t\t\t\t\t\t\t<br><strong>Ø 2,0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 180 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Gewachst, seidenmatter Glanz, griffig</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Klassische Business-Schuhe, Oxfords, Derbys, Anzugschuhe</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" class=\"text-dark font-weight-bold\">R2-SL</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-primary\" style=\"background-color: #4F5D4E;\">Splendore di Laccico</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Rundsenkel\n\t\t\t\t\t\t\t<br><strong>Ø 2,0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 180 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Doppelt gewachst, prächtiger Glanz wie feines Kalbsleder</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Verdeckte Ösen</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Italienische Designerschuhe, Hochzeits- &amp; Abendschuhe, Glattleder</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"text-dark font-weight-bold\">R3-CS</a>\n\t\t\t\t\t\t\t<br><span