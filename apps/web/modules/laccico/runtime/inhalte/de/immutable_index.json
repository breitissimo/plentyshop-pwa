02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/sneaker-freizeitschuhe"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1,"slot_index":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"072c2d13-871c-49fa-97fa-c21646847aa6","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2 class=\"align-center\"><span class=\"color-secondary\"> Splendore di Laccico </span></h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"0bf0bebb-8a21-4e76-8041-4de63ebc012a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"align-center\"><span class=\"color-secondary\"> Doppelt gewachste Prachtsenkel </span></h3><p class=\"align-center\"><span class=\"color-secondary\"> Made in Italy </span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"08730250-af56-41b7-85fe-05cb3cfe0433","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"JETZT ENTDECKEN","link":"/business-elegante-schuhe","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"8ff829e2-3069-4cdb-b9b5-73b902a3fd3e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3><strong class=\"color-#1a1a1a bg-appearance\">Langlebig und robust</strong></h3><p><span class=\"color-#1a1a1a bg-appearance\">Dank der Kombination aus erstklassiger Baumwolle und unserer traditionellen Wachsung sind LACCICO Schnürsenkel </span><strong class=\"color-#1a1a1a bg-appearance\">reißfest</strong><span class=\"color-#1a1a1a bg-appearance\">, </span><strong class=\"color-#1a1a1a bg-appearance\">abriebfest</strong><span class=\"color-#1a1a1a bg-appearance\"> und langlebig. Das Ergebnis sind formstabile Bänder, an denen Sie lange Freude haben werden.</span></p><p><strong class=\"color-#1a1a1a bg-appearance\">Europäische Flechtkunst trifft moderne Technologie</strong></p><p><span class=\"color-#1a1a1a bg-appearance\">Unsere gewachsten Schnürsenkel entstehen in enger Zusammenarbeit mit ausgewählten Traditionsflechtereien in Europa. Dort werden moderne Flechtmaschinen eingesetzt, um aus feinsten Garnen sorgfältig und </span><strong class=\"color-#1a1a1a bg-appearance\">dicht geflochtene</strong><span class=\"color-#1a1a1a bg-appearance\"> Schnürsenkel zu fertigen. Diese Verbindung aus traditionellem Handwerk und innovativer Technologie sorgt für die unverkennbare LACCICO-Qualität.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"222017a3-f831-40ed-a4a3-bdc00858ec48","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Splendore di Laccico</p>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"724","itemId":"","crossSellingRelation":"Similar"}}},{"name":"TextCard","type":"content","meta":{"uuid":"8a33adaf-5978-4339-bf0d-d683ee69d6ad","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4><strong class=\"bg-appearance color-#1a1a1a\">Unsere Philosophie: Schnürsenkel, die zum Schuh passen</strong></h4><p><span class=\"bg-appearance color-#1a1a1a\">Wir führen gewachste Schnürsenkel aus 100 % Baumwolle, für ein edles Aussehen und ein angenehmes Tragegefühl.</span></p><p><strong class=\"bg-appearance color-#1a1a1a\">100 % Baumwolle</strong></p><p><span class=\"bg-appearance color-#1a1a1a\">Reine Baumwolle, gewachst, heiß gewalzt und poliert, mit glatter Oberfläche und seidenmattem Glanz.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"414e3df7-25a7-4795-8cb0-a038a04cae5c","isGlobalTemplate":false},"configuration":{"columnWidths":[4,4,4],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"5d0d6529-3d80-40e1-ad89-b257176f9299","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Warum LACCICO? </strong></h2><h3><strong>Ihre Vorteile im Detail:</strong></h3><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Formstabil &amp; Belastbar:</strong> Durch die dicht geflochtene Konstruktion aus reißfester Baumwolle bleibt jeder Senkel absolut formstabil und belastbar im Alltag.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Gewachst &amp; Abriebfest:</strong> Die gewachste Veredelung macht unsere Premium-Schnürsenkel schmutzunempfindlich, wetterfest und sorgt für einen edlen, seidenglänzenden Look.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Einzigartige Haptik:</strong> Erleben Sie die geschmeidige, griffige und softig-massive Qualität.</li></ol>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"DetailsList","type":"structure","meta":{"uuid":"d271f387-67da-47a2-a9df-192f44b8a4ba","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"c7f8eb99-40a2-485c-9b62-0281647995a9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>Das&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>Wachs durchdringt das Fasergefüge</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>&nbsp;des Baumwollgeflechts vollständig, ähnlich wie Gerbstoffe das Leder. Es schützt die Baumwollfaser vor eindringender Nässe, verhindert das mechanische Aufspleißen der Fasern und&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>verringert die Reibung</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>, sodass der Senkel beim Binden geschmeidig und&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>verschleißarm&nbsp;</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>durch die Ösen gleitet.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Funktion hat die Wachsung bei LACCICO Schnürsenkeln?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4ff62aa1-d534-45fa-9a3f-0de351d72d92","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"https://www.laccico.com/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Rundsenkel 2 mm</u></a> (<a href=\"https://www.laccico.com/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-CS</u></a> · <a href=\"https://www.laccico.com/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-2-mm/r2-sl\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-SL</u></a>):</strong> Für elegante Business-Schuhe (Oxford, Derby) mit verdeckten Ösen</li><li style=\"box-sizing: border-box;\"><a href=\"https://www.laccico.com/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Rundsenkel 3 mm (R3)</u>:</strong></a> Für robuste Halbschuhe, Chukka-Boots und Rahmengenähte mit aufgesetzten Ösen</li><li style=\"box-sizing: border-box;\"><a href=\"https://www.laccico.com/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Flachsenkel 3 mm (F3)</u>:</strong>&nbsp;</a>Für rahmengenähte Klassiker, Brogues und alle Schuhe mit verdeckten Ösen</li><li style=\"box-sizing: border-box;\"><a href=\"https://www.laccico.com/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Flachsenkel 4 mm (F4)</u>:&nbsp;</strong></a>Für klassische Halbschuhe und Stiefeletten &amp; Freizeitschuhe</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"https://www.laccico.com/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Flachsenkel 6 mm</u></a> (<a href=\"https://www.laccico.com/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-CS</u></a> · <a href=\"https://www.laccico.com/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-XR</u></a>):</strong> Für Sneaker, Freizeitschuhe und schwere Workwear-Boots</li></ul>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welcher Schnürsenkel-Typ passt zu welchem Schuh?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"d6a6a278-3ee8-4278-8fc5-f0da5c4da777","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">LACCICO Längen-Guide</strong> (Faustformel für klassisches Schuhwerk)</p><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>Die richtige Länge ist entscheidend für den Halt und die Optik. Als Faustformel für klassisches Schuhwerk gilt die Anzahl der Ösenpaare:</p><ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; list-style-type: circle;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">1–2 Ösenpaare:</strong> 45 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">3–4 Ösenpaare:&nbsp;</strong>60 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">4–5 Ösenpaare:</strong> 75 cm (bei Derby-Schnürung ggf. ab 5 Ösenpaaren auch 90 cm, je nach Fußtyp)</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">5–6 Ösenpaare:</strong> 90 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">7–8 Ösenpaare:</strong> 120 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">9+ Ösenpaare / Stiefel:</strong> 150 bis 180 cm</li></ul><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">Meister-Tipp:</strong> Messen Sie im Zweifel Ihre alten Senkel im ungeschnürten Zustand nach. So sorgen Sie für eine gute Passform, die genau Ihren Vorlieben entspricht.</p><p>Ausführlich auf unserer Seite <a href=\"/laccico-finest-waxed-laces/schnuersenkel-laenge\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Schnürsenkel-Länge</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie ermittle ich die richtige Schnürsenkellänge?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"96f002ef-cf17-4a54-9ec8-4db79165b74b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span data-path-to-node=\"5,3,1,0,0,0\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>Aus <strong style=\"box-sizing: border-box; font-weight: bolder;\">100 % Qualitäts-Baumwolle</strong>, dicht geflochten auf modernen Flechtmaschinen in europäischen Traditionsbetrieben</span><span data-path-to-node=\"5,3,1,0,0,2\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'></span><span data-path-to-node=\"5,3,1,0,0,4\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Aus welchem Material bestehen LACCICO Schnürsenkel?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a5e9f180-d56a-47b3-b17f-72e14c813c72","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><strong>Wasserabweisend und formstabil:</strong> Die Wachsung sättigt das dichte Baumwollgeflecht und verhindert, dass Feuchtigkeit sofort in den Faserstrang gelangt. Selbst bei anhaltender Nässe weicht das Material nicht auf: Der Senkel behält seine feste Struktur, längt sich nicht und bleibt verlässlich reißfest.</