[{"name":"MultiGrid","type":"structure","meta":{"uuid":"8b9e3c56-034b-47fe-9f72-512d65db2653","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"7076a5a8-0430-4f10-b4f4-479808ec1aa2","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"8d567cfd-0050-47a6-ad80-3a880e2c885c","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"49a6385d-6f14-497f-8d98-1242f529f5f9","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"78e099a0-af80-4bad-983e-1048e1b4113f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Zu Heritage- und Workwear-Boots mit Ösen ab 5 mm Innendurchmesser passt der 6 mm Flachsenkel F6-XR. Er hat mehr Volumen, da mehr Garn darin verflochten ist, und wirkt rustikal.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Zu kräftigem Leder und markanter Sohle passt sein kräftiges Flechtbild. An High-Top-Sneakern und Boots im Workwear-Look wirkt der F6-CS ebenso gut, er ist feiner und wirkt edel. Schnürstiefeletten mit Ösen und Haken tragen den 4 mm Flachsenkel oder den 3 mm Rundsenkel, das ist Geschmackssache.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Senkel nach Stil&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Stiefel</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Kräftige Stränge, rustikal.</td><td class=\"py-3 px-3 align-middle\">Moc-Toe-Boots, Heritage- und Workwear-Boots.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Feines Flechtbild, edel.</td><td class=\"py-3 px-3 align-middle\">Boots im Workwear-Look, High-Top-Sneaker.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Schlank, dezenter Glanz.</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Ösen und Haken.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Kräftige runde Kordel.</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten und Boots mit Haken.</td><td class=\"py-3 px-3 align-middle\">45–150 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhbänder passen zu modischen Heritage- und markanten Workwear-Styles?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"5a77e723-80bb-48ee-934e-3ae9c8728580","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für Arbeitsboots mit aufgesetzten Ösen und Haken eignet sich am besten der 6 mm Flachsenkel F6-XR. Gewachste Baumwolle ist reißfest und langlebig.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der Flachsenkel sieht an Boots kräftiger aus; wer das Einlegen in die Haken beherrscht, nimmt gern den flachen. Das ist Geschmackssache. In jedem Fall muss der Senkel zur Öse passen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Rund oder flach&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Senkel</th><th scope=\"col\" class=\"py-3 px-3\">An Haken</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Flach einlegen, nicht durch den Zugkanal ziehen.</td><td class=\"py-3 px-3 align-middle\">Kräftig, rustikal.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Weniger anfällig, verdreht sich nicht.</td><td class=\"py-3 px-3 align-middle\">Zurückhaltender.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schuhbänder eignen sich für Arbeitsboots?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"03388a1c-4495-48b2-9d6d-b0af7477b99d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Schnürsenkel aus 100 % Baumwolle sind wasserabweisend und behalten auch nass ihre Form. Straff geflochten, leiern sie nicht aus.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das Wachs durchdringt das Fasergefüge des Baumwollgeflechts, ähnlich wie Gerbstoffe das Leder. Deshalb ist der Senkel auch schmutzunempfindlich. Bei Nässe löst sich die Schleife nicht so leicht.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Nässe &amp; Schmutz&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Fall</th><th scope=\"col\" class=\"py-3 px-3\">Was passiert</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Regen<br><span class=\"small text-muted font-weight-normal\">Wasserabweisend</span></td><td class=\"py-3 px-3 align-middle\">Das Wachs im Geflecht hält Wasser ab.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Durchnässt<br><span class=\"small text-muted font-weight-normal\">Form</span></td><td class=\"py-3 px-3 align-middle\">Der Senkel behält seine Form und leiert nicht aus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schleife<br><span class=\"small text-muted font-weight-normal\">Bei Nässe</span></td><td class=\"py-3 px-3 align-middle\">Löst sich nicht so leicht.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Stumpf geworden<br><span class=\"small text-muted font-weight-normal\">Pflege</span></td><td class=\"py-3 px-3 align-middle\">Lappen mit etwas Schuhcreme fest um den Senkel schließen und kräftig entlangziehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Für Boots<br><span class=\"small text-muted font-weight-normal\">Senkel</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> (Ösen ab 5 mm Innendurchmesser)<br><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> (Ösen ab 4 mm Innendurchmesser)</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Schnürsenkel behalten auch bei Nässe ihre Form?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"9a667f92-88a2-47ff-8666-bcc221f44d37","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Den Senkel legt man in den Haken ein: erst überkreuzen, dann unter Spannung einlegen. Zieht man ihn im Zugkanal des Hakens fest, scheuert er schnell.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Die falsche Zugrichtung ist der häufigste Grund für frühen Verschleiß an Haken. Oft haben Haken oder Ösen scharfe Grate. Scheuert ein Senkel früh durch, die Haken und Ösen einmal entgraten.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Haken&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schritt</th><th scope=\"col\" class=\"py-3 px-3\">Was tun</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Überkreuzen<br><span class=\"small text-muted font-weight-normal\">Vor jedem Haken</span></td><td class=\"py-3 px-3 align-middle\">Erst kreuzen, dann zum Haken führen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Einlegen<br><span class=\"small text-muted font-weight-normal\">Unter Spannung</span></td><td class=\"py-3 px-3 align-middle\">Unter Spannung einlegen, nicht durch den Zugkanal festziehen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Scheuert schnell<br><span class=\"small text-muted font-weight-normal\">Grate</span></td><td class=\"py-3 px-3 align-middle\">Haken und Ösen einmal entgraten.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flachsenkel<br><span class=\"small text-muted font-weight-normal\">Verdreht</span></td><td class=\"py-3 px-3 align-middle\">Vor dem Einlegen prüfen, ob das Band flach liegt. Verdreht festgezogen lässt sich der Drall nur schwer korrigieren.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Weniger anfällig<br><span class=\"small text-muted font-weight-normal\">Rundsenkel</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie verhindert man das Aufscheuern von Schnürsenkeln an Haken?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a0546f5e-aa65-4cd9-ba30-f525251d455c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Am sichersten misst man die alten Senkel ungeschnürt von Spitze zu Spitze nach. Für knöchelhohe Boots passen meist 120 cm, für hohe Schnürstiefel 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dickere Senkel brauchen etwas mehr Länge als dünne. An Boots liegen die Ösen weit auseinander, deshalb hilft eine Faustregel nach Ösenpaaren hier wenig. Den R3-CS gibt es von 45 bis 150 cm, den F4-CS bis 120 cm, den F6-CS und den F6-XR bis 150 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Längen&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Länge</th><th scope=\"col\" class=\"py-3 px-3\">Typische Stiefel</th><th scope=\"col\" class=\"py-3 px-3\">Senkel</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Niedrig</span></td><td class=\"py-3 px-3 align-middle\">Chukkas und niedrige Boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Knöchelhoch</span></td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten, knöchelhohe Boots, Moc-Toe-Boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> (Ösen ab 5 mm Innendurchmesser)<br><a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> (Ösen ab 4 mm Innendurchmesser)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Hoher Schaft</span></td><td class=\"py-3 px-3 align-middle\">Hohe Schnürstiefel, Workwear-Boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR<