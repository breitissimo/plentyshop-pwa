[{"name":"MultiGrid","type":"structure","meta":{"uuid":"e11d418d-fc35-4630-b2f3-91dfcd2adb9d","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"f4d35eb4-4aea-4cc4-b36c-2075a0a5c4e2","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"f0a4d301-1f64-48ab-b72e-cf54d312ba56","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der 3 mm Flachsenkel passt am besten an klassische Halbschuhe mit verdeckten Ösen: Oxfords, Derbys und Brogues aus Glattleder. Er ist der feinste unserer Flachsenkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Bei verdeckten Ösen sieht man von außen nur ein kleines Loch im Leder. Dafür sind der 3 mm Flachsenkel und der 2 mm Rundsenkel gemacht. Der Rundsenkel tritt ganz zurück, der schmale Flachsenkel sorgt für einen kleinen Überraschungseffekt, den Kenner bemerken. Alle breiteren Flachsenkel sind für aufgesetzte Ösen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Flachsenkel im Vergleich&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Breite</th><th scope=\"col\" class=\"py-3 px-3\">Serie</th><th scope=\"col\" class=\"py-3 px-3\">Wirkung</th><th scope=\"col\" class=\"py-3 px-3\">Längen</th><th scope=\"col\" class=\"py-3 px-3\">Schuhe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm<br><span class=\"small text-muted font-weight-normal\">Verdeckte Ösen</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Sehr dezent, ein leiser Akzent.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Klassische Oxfords, Derbys und Brogues.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm<br><span class=\"small text-muted font-weight-normal\">Aufgesetzte Ösen ab 4 mm Innendurchmesser</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Schlank, sportlich-elegant.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Schnürstiefeletten mit Ösen und Haken, schlanke Ledersneaker.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Aufgesetzte Ösen ab 5 mm Innendurchmesser</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Feines Flechtbild, edel.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">Hochwertige Sneaker, Komfortschuhe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Aufgesetzte Ösen ab 5 mm Innendurchmesser</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Mehr Garn, rustikal, softig-massiver Griff.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">Sneaker und Boots im Vintage- und Workwear-Look.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wann passt ein Flachsenkel mit 3 mm Breite (F3) am besten?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"191dc425-3731-4c96-8af6-01d35d43d70d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Gewachste Flachsenkel aus 100 % Baumwolle passen zum Leder eines hochwertigen Sneakers: dezenter Glanz, wertige Haptik, dazu reißfest und langlebig.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Das Wachs durchdringt das Fasergefüge des Baumwollgeflechts, ähnlich wie Gerbstoffe das Leder. So ist der Senkel wasserabweisend, schmutzunempfindlich und behält auch nass seine Form. Bei Nässe löst sich die Schleife nicht so leicht. Neue gewachste Senkel sind anfangs etwas steif, mit dem Tragen werden sie geschmeidiger.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Am Sneaker&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Eigenschaft</th><th scope=\"col\" class=\"py-3 px-3\">Woher</th><th scope=\"col\" class=\"py-3 px-3\">Am Sneaker</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dezenter Glanz<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Heiß gewalzt und poliert.</td><td class=\"py-3 px-3 align-middle\">Wirkt wie ein feines Lederband und passt zum Glattleder.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Reißfest<br><span class=\"small text-muted font-weight-normal\">Haltbarkeit</span></td><td class=\"py-3 px-3 align-middle\">Dicht geflochtene Baumwolle.</td><td class=\"py-3 px-3 align-middle\">Auch für eine straffe Schnürung.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wasserabweisend<br><span class=\"small text-muted font-weight-normal\">Wetter</span></td><td class=\"py-3 px-3 align-middle\">Das Wachs schützt die Faser.</td><td class=\"py-3 px-3 align-middle\">Behält auch nass seine Form.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dehnt sich kaum<br><span class=\"small text-muted font-weight-normal\">Geflecht</span></td><td class=\"py-3 px-3 align-middle\">Straff geflochten.</td><td class=\"py-3 px-3 align-middle\">Leiert nicht aus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Breite<br><span class=\"small text-muted font-weight-normal\">Auswahl</span></td><td class=\"py-3 px-3 align-middle\">Nach den Ösen wählen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Was spricht für gewachste Flachsenkel an Premium-Sneakern?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"d53e9905-7be8-4a2b-96fa-5cb52c0b1671","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Der 6 mm Flachsenkel sieht an Schuhen mit aufgesetzten Ösen ab 5 mm Innendurchmesser gut aus, vor allem an Sneakern und Boots. Dort hat die breite Fläche Platz und passt zur kräftigen Machart.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Es gibt ihn in zwei Ausführungen. Der F6-CS hat ein feines, zurückhaltendes Flechtbild und wirkt edel, auch in kräftigen Farben. In kürzeren Längen passt er zu Komfortschuhen und aufgesetzten Ösen. Der F6-XR ist höher und schwerer, er hat mehr Volumen, da mehr Garn darin verflochten ist. Er wirkt rustikal und gehört zu Moc-Toe-Boots, Heritage- und Workwear-Schuhen.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-CS &amp; F6-XR&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Merkmal</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flechtbild<br><span class=\"small text-muted font-weight-normal\">Optik</span></td><td class=\"py-3 px-3 align-middle\">Fein und unaufdringlich.</td><td class=\"py-3 px-3 align-middle\">Kräftige Stränge, gröber.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Griff<br><span class=\"small text-muted font-weight-normal\">In der Hand</span></td><td class=\"py-3 px-3 align-middle\">Flach und geschmeidig.</td><td class=\"py-3 px-3 align-middle\">Höher, softig-massiver Griff.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wirkung<br><span class=\"small text-muted font-weight-normal\">Stil</span></td><td class=\"py-3 px-3 align-middle\">Edel, im Stadtbild.</td><td class=\"py-3 px-3 align-middle\">Rustikal, Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schuhe<br><span class=\"small text-muted font-weight-normal\">Einsatz</span></td><td class=\"py-3 px-3 align-middle\">Hochwertige Sneaker, Komfortschuhe, Boots.</td><td class=\"py-3 px-3 align-middle\">Boots, Workwear, Sneaker im Vintage-Look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Längen<br><span class=\"small text-muted font-weight-normal\">Sortiment</span></td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schmaler<br><span class=\"small text-muted font-weight-normal\">Zum Vergleich</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">F3 für verdeckte Ösen, F4 für aufgesetzte Ösen ab 4 mm Innendurchmesser.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mehr dazu<br><span class=\"small text-muted font-weight-normal\">Seite</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wann sieht ein 6 mm breites Schuhband (F6) gut aus?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"bcc1193c-984a-4bb3-8fa0-e196490e7a2f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Für schlanke Ledersneaker und Smart-Casual-Schuhe mit aufgesetzten Ösen ab 4 mm Innendurchmesser ist der 4 mm Flachsenkel (F4-CS) die richtige Wahl. Ab 5 mm Innendurchmesser passt auch der 6 mm Flachsenkel.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Der F4 ist besonders beliebt an Schnürstiefeletten mit Ösen und Haken. An Haken den Flachsenkel einlegen, nicht durch den Zugkanal ziehen, sonst scheuert er schnell. Wer es dort lieber rund mag, nimmt den 3 mm Rundsenkel, das ist Geschmackssache. Court-Sneaker tragen den 6 mm Flachsenkel.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schuhe &amp; Senkel&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Schuh</th><th scope=\"col\" class=\"py-3 px-3\">Ösen</th><th scope=\"col\" class=\"py-3 px-3\">Senkel</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schlanke Ledersneaker<br><span class=\"small text-muted font-weight-normal\">Sportlich-elegant</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 4 mm Innendurchmesser.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbys<br><span class=\"small text-muted font-weight-normal\">Smart Casual</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Schnürstiefeletten<br><span class=\"small text-muted font-weight-normal\">Knöchelhoch</span></td><td class=\"py-3 px-3 align-middle\">Unten Ösen, oben Haken.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/form-durchmesser/rundsenkel-nach-durchmesser/rundsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Court-Sneaker<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 5 mm Innendurchmesser.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Komfortschuhe<br><span class=\"small text-muted font-weight-normal\">Alltag</span></td><td class=\"py-3 px-3 align-middle\">Aufgesetzte Ösen ab 5 mm Innendurchmesser.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Welche Flachsenkel passen zu sportlich-eleganten Sneakern und Smart-Casual-Schuhen?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"8c8c35f8-1927-48f7-8015-8c54ec9bc185","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Das Verdrehen hängt nicht vom Material ab, sondern von der Handhabung. Mit einer Hand führt man das Band durch die Öse, das Restende gleitet über einen Finger der anderen Hand unter leichter Spannung.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">So wirkt die Öse wie eine Führungsschiene und das Band läuft flach hindurch. Ist es erst verdreht festgezogen, lässt sich der Drall nur schwer korrigieren. Wichtig ist auch die passende Breite: Der Flachsenkel soll zur Öse passen, damit er flach liegen kann. Das ist ein Meistertipp aus der Werkstatt.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Schnüren&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Seitlich wischbar&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Punkt</th><th scope=\"col\" class=\"py-3 px-3\">Richtig</th><th scope=\"col\" class=\"py-3 px-3\">Warum</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Einfädeln<br><span class=\"small text-muted font-weight-normal\">Eine Hand</span></td><td class=\"py-3 px-3 align-middle\">Das Band flach durch die Öse führen.</td><td class=\"py-3 px-3 align-middle\">Die Öse wirkt wie eine Führungsschiene.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Restende<br><span class=\"small text-muted font-weight-normal\">Andere Hand</span></td><td class=\"py-3 px-3 align-middle\">Über einen Finger unter leichter Spannung gleiten lassen.</td><td class=\"py-3 px-3 align-middle\">So dreht sich das Band nicht ein.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Festziehen<br><span class=\"small text-muted font-weight-normal\">Zum Schluss</span></td><td class=\"py-3 px-3 align-middle\">Erst ziehen, wenn das Band flach liegt.</td><td class=\"py-3 px-3 align-middle\">Verdreht festgezogen lässt sich der Drall nur schwer korrigieren.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Breite<br><span class=\"small text-muted font-weight-normal\">Zur Öse</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">3 mm</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">4 mm</a> · <a href=\"/form-durchmesser/flachsenkel-nach-breite/flachsenkel-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">6 mm</a></td><td class=\"py-3 px-3 align-middle\">Je leichter das Band durch die Öse gleitet, desto leichter bleibt es flach.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Haken<br><span class=\"small text-muted font-weight-normal\">Stiefeletten</span></td><td class=\"py-3 px-3 align-middle\">Einlegen, nicht durch den Zugkanal ziehen.</td><td class=\"py-3 px-3 align-middle\">Sonst scheuert der Flachsenkel schnell.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mehr dazu<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Unsere häufigen Fragen</a></td><td class=\"py-3 px-3 align-middle\">Weitere Fragen rund um Schnürsenkel und Schuhe.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Wie verhindert man das lästige Verdrehen von Flachsenkeln beim Schnüren?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"7d87b49e-34a8-4309-94ee-f3e99e91ac89","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"164ccb9d-bbce-48f5-979c-ed48b37d389e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"laccico-listenkopf\"><h2>F6-CS</h2><a href=\"/form-durchmesser/flachsenkel-nach-br