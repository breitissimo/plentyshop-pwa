[{"name":"MultiGrid","type":"structure","meta":{"uuid":"1f0775ef-fac8-4f22-ac2c-a5ba4a147531","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"03864c45-39db-4da6-9e8b-bca62e39455a","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"32d955e8-2484-4aa8-a22f-042d58662967","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"a445d5cc-f14a-46e3-8919-354859ce8c55","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Black dress shoes as a rule call for a black lace. The finish makes the difference: silky matt or glossy.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The R2-CS has a subtle, silky-matt sheen and suits any business shoe. The double-waxed Splendore (R2-SL) in Nero has a stronger sheen. With high-shine polished box calf it belongs like cufflinks with a dinner jacket.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Finish comparison&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Waxing</th><th scope=\"col\" class=\"py-3 px-3\">Sheen</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS (2 mm)</a></td><td class=\"py-3 px-3 align-middle\">Waxed</td><td class=\"py-3 px-3 align-middle\">Subtle, silky matt</td><td class=\"py-3 px-3 align-middle\">Smooth leather, calfskin, business shoes</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (2 mm), Nero</a></td><td class=\"py-3 px-3 align-middle\">Double-waxed</td><td class=\"py-3 px-3 align-middle\">Stronger sheen with depth of colour</td><td class=\"py-3 px-3 align-middle\">Polished box calf, shell cordovan, evening shoes</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace colour do you choose for jet-black dress shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"29b1219d-41b7-4148-9e90-4952a2bf7e9b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 2 mm round laces R2-CS and R2-SL are made for fine men's shoes with concealed eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The eyelet size is important: the lace should pass easily through the eyelet, otherwise its surface is put under too much strain when it is pulled through. For visible eyelets and hooks, the 3 mm round lace R3-CS is the better choice.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelet &amp; model guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Diameter</th><th scope=\"col\" class=\"py-3 px-3\">Suitable eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Property</th><th scope=\"col\" class=\"py-3 px-3\">Shoe types</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Fine</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Glides easily through the eyelet.</td><td class=\"py-3 px-3 align-middle\">Oxfords, formal shoes, fine Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">Strong</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Grippy, fills eyelets of 4 mm inner diameter or more well.</td><td class=\"py-3 px-3 align-middle\">Country Derbies, sturdy low shoes, lace-up ankle boots</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which round laces are suitable for fine men's shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f6c83f31-dcd4-414e-9189-0cb3c78eeb43","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For elegant evening shoes, choose the 2 mm round lace (R2-CS or R2-SL) or the narrow 3 mm flat lace (F3-CS). The length depends on the number of pairs of eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The glossy Splendore suits a dinner jacket. The flat F3-CS is very understated and adds a small surprise that connoisseurs notice.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Evening shoe sizes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shape &amp; size</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Length by pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Typical evening shoe</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Double-waxed</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2–3 pairs: 60 cm<br>4–5 pairs: 75 cm<br>5–6 pairs: 90 cm</td><td class=\"py-3 px-3 align-middle\">Stronger sheen with depth of colour.</td><td class=\"py-3 px-3 align-middle\">Dinner-jacket Oxfords and formal shoes in polished calfskin.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Waxed</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">2–3 pairs: 60 cm<br>4–5 pairs: 75 cm<br>5–6 pairs: 90 cm</td><td class=\"py-3 px-3 align-middle\">Understated, silky matt.</td><td class=\"py-3 px-3 align-middle\">Business Oxfords, cap-toes and evening Derbies.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">Waxed</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">2–3 pairs: 60 cm<br>4–5 pairs: 75 cm<br>5–6 pairs: 90 cm</td><td class=\"py-3 px-3 align-middle\">Very understated, lies flat.</td><td class=\"py-3 px-3 align-middle\">Plain Derbies and elegant low shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What sizes are classic laces for elegant evening shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f4737b1d-1469-489e-8c45-64545e678301","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Cheap shoelaces are often loosely braided. That is why they chafe through quickly on sharp eyelet edges.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">LACCICO shoelaces are made of 100 % cotton, densely braided and waxed. The wax protects them against abrasion and moisture. If a lace still breaks early, it is usually due to an eyelet with burrs or to pulling in the wrong direction on hooks.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Construction &amp; tear resistance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shape &amp; thickness</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Construction</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Use</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive / Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Densely braided cord, tear-resistant.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Business shoes, Goodyear-welted Oxfords and evening shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm and 4 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Shape-retaining flat braid, does not stretch out.</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Derbies, full brogues, smooth-leather sneakers and low shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm flat<br><span class=\"small text-muted font-weight-normal\">Xtra Robust</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Strong strands with a soft yet solid grip, very resilient.</td><td class=\"py-3 px-3 align-middle\">75 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Heritage boots, workwear and outdoor boots.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why do cheap shoelaces break so quickly?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"9c38e978-8e93-4001-929c-90a93fe7a08c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed cotton is tear-resistant, does not stretch out and keeps its shape even when wet. Its smooth surface with a subtle sheen goes well with smooth leather.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">One advantage shows in the rain: the bow of a waxed cotton lace does not come undone as easily.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Waxed cotton&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Property</th><th scope=\"col\" class=\"py-3 px-3\">Waxed cotton</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Under tension<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">Does not stretch out, keeps its shape even when wet.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Surface<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Smooth, subtle sheen, suits fine leather.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">When wet<br><span class=\"small text-muted font-weight-normal\">Bow</span></td><td class=\"py-3 px-3 align-middle\">The bow does not come undone as easily.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What are the advantages of shoelaces made of 100 % genuine cotton?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"282ea03a-11e1-4b76-a518-ec1abc237f1a","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"SortFilter","type":"content","meta":{"uuid":"8c0b7630-6674-4d9f-b73c-d0c8c7c412e1","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoLaengenleiste","type":"content","meta":{"uuid":"25bb7594-a0f6-4a39-a0f9-68e2e0dca2f3","isGlobalTemplate":false},"parent_slot":1,"slot_index":2,"co