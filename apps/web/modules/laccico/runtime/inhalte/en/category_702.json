[{"name":"MultiGrid","type":"structure","meta":{"uuid":"3bdaba68-3aac-4114-b8d4-470ca8c409a3","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"6504e0cb-dbc7-46c1-a66a-fa29b72d5d2a","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"167534c7-7f02-481b-81e3-079c3fcd7ee0","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-XR is a 6 mm wide waxed flat lace made of 100 % cotton with strong strands. It has more volume because more yarn is braided into it, and it looks rustic.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Compared with the F6-CS it is higher and heavier. Its soft yet solid grip comes from the strands, not from the wax. Waxed, hot-rolled and polished, it has a silky-matt sheen. The wax penetrates the braid and protects the fibre. If you are looking for a finer lace with an unobtrusive braid pattern, choose the F6-CS.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-XR at a glance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">6 mm, flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Fibre</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, waxed.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braid pattern<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Strong strands, rustic.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grip<br><span class=\"small text-muted font-weight-normal\">In the hand</span></td><td class=\"py-3 px-3 align-middle\">Soft yet solid.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sheen<br><span class=\"small text-muted font-weight-normal\">Waxing</span></td><td class=\"py-3 px-3 align-middle\">Hot-rolled and polished, silky matt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">75, 90, 120 and 150 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Finer<br><span class=\"small text-muted font-weight-normal\">Sister series</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What makes the Xtra Robust series (F6-XR) special among 6 mm flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c424f744-eabe-4914-9e91-324b9674a0ba","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-XR suits shoes in vintage, heritage and workwear style with visible eyelets of 5 mm inner diameter or more: moc-toe boots, workwear boots, lace-up boots and sneakers in vintage style.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The strong braid pattern of the F6-XR suits sturdy leather and a striking sole. On high-top sneakers in workwear style, the F6-CS looks just as good as the F6-XR. For refined leather sneakers, the finer F6-CS is the better choice.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Moc-toe boots<br><span class=\"small text-muted font-weight-normal\">Heritage</span></td><td class=\"py-3 px-3 align-middle\">Eyelets, often with hooks.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Workwear boots<br><span class=\"small text-muted font-weight-normal\">Robust</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up boots<br><span class=\"small text-muted font-weight-normal\">High shaft</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks at the top.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneakers<br><span class=\"small text-muted font-weight-normal\">Vintage style</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">High-top sneakers<br><span class=\"small text-muted font-weight-normal\">Workwear style</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-XR</span> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Leather sneakers<br><span class=\"small text-muted font-weight-normal\">Refined</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which types of shoes and boots benefit most from the F6-XR series?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"eff7a8c4-05e6-4815-a686-14a702ac6ff7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-XR comes in 11 colours and in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Alongside black, anthracite and white there are beige and three shades of brown, plus traffic yellow, wine red, green and blue. The F6-CS offers a larger choice with 50 colours.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR colours</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Black</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">White</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Anthracite</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown &amp; beige<br><span class=\"small text-muted font-weight-normal\">4 colours</span></td><td class=\"py-3 px-3 align-middle\">Beige, light brown, caramel brown, dark brown</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Yellow<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Traffic yellow</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Red &amp; pink<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Wine red</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Green<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Green</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blue<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Blue</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which colours does the waxed 6 mm flat lace F6-XR come in?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"ec71bb45-0244-462d-8041-865fdb1ae0ee","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>You lay the flat lace into the hook: cross first, then lay it in under tension. If you pull it tight in the channel of the hook, it chafes quickly.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Pulling in the wrong direction is the most common cause of early wear on hooks. In the eyelets below, guide the lace through the eyelet with one hand and let the loose end slide over a finger of the other hand under light tension. Only pull once the lace lies flat.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; hooks&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Eyelets<br><span class=\"small text-muted font-weight-normal\">Lower part</span></td><td class=\"py-3 px-3 align-middle\">Guide the lace through with light counter-tension, only pull once it lies flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Crossing<br><span class=\"small text-muted font-weight-normal\">Before each hook</span></td><td class=\"py-3 px-3 align-middle\">Cross first, then lead to the hook.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">Upper part</span></td><td class=\"py-3 px-3 align-middle\">Lay in under tension, do not pull tight through the channel.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Twisted<br><span class=\"small text-muted font-weight-normal\">Before tightening</span></td><td class=\"py-3 px-3 align-middle\">Once pulled tight while twisted, the twist is hard to correct. So check beforehand that the lace lies flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chafes quickly<br><span class=\"small text-muted font-weight-normal\">Burrs</span></td><td class=\"py-3 px-3 align-middle\">Hooks or eyelets often have sharp burrs. Deburring once helps.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you lace F6-XR flat laces on boots with hooks?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e7032960-f5ba-4bcc-8cc7-073c0a76fbd4","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. The F6-XR comes in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The length needed depends on the lacing style, the shaft height and the foot, and on boots the eyelets are far apart. That is why a rule of thumb based on pairs of eyelets helps little here.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">75 cm<br><span class=\"small text-muted font-weight-normal\">Short</span></td><td class=\"py-3 px-3 align-middle\">Low shoes and sneakers with few eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Medium</span></td><td class=\"py-3 px-3 align-middle\">Low-top sneakers in vintage style.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Long</span></td><td class=\"py-3 px-3 align-middle\">Ankle-high boots, moc-toe boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Very long</span></td><td class=\"py-3 px-3 align-middle\">Tall lace-up boots, workwear boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Our frequently asked questions</a></td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace length do you choose for the F6-XR series on boots?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"bb46e95e-7321-44a9-a291-df90eefbcca0","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"29d5bf13-a191-4def-8bbd-bbc6c9db6a9a","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"28701625-e2bc-4a40-8792-ea768a8d10a0","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"97c1e1a7-2022-4b25-85f5-887a2e04d82a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]