[{"name":"MultiGrid","type":"structure","meta":{"uuid":"2807a54e-10c6-49da-8214-1d86d9d6bb14","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"fe5fd3b6-851b-44e9-98fb-8d395ec22e81","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"c591a9f1-59f3-4c13-86a9-fe0eba9d0512","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>If Derbies and chukkas have visible eyelets, the 4 mm flat lace (F4-CS) is the right choice. It is particularly popular on lace-up ankle boots with eyelets and hooks.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">You can recognise visible eyelets by the metal ring on the outside. With concealed eyelets you only see a small hole in the leather from the outside; finer laces belong there: the 3 mm flat lace or the 2 mm round lace. Whether flat or round is a matter of taste with visible eyelets. The 3 mm round lace fits there just as well.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes &amp; eyelets&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Smart casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chukka boots<br><span class=\"small text-muted font-weight-normal\">2–3 pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Eyelets below, hooks above.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Slim leather sneakers<br><span class=\"small text-muted font-weight-normal\">Smart and sporty</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 4 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F4-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxford, classic Derby<br><span class=\"small text-muted font-weight-normal\">Concealed eyelets</span></td><td class=\"py-3 px-3 align-middle\">Only a small hole from the outside.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneakers, boots<br><span class=\"small text-muted font-weight-normal\">Sneakers, boots</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 5 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace width suits Derby shoes and chukkas?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"ea7c6baa-7903-4b90-bbfe-3eee80470a87","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F4-CS comes in 45 colours, from white to black, and in 60, 75, 90 and 120 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Alongside classics such as black, dark brown and navy, there are quiet tones such as greige, light taupe or dusty pink and strong ones such as mustard yellow, fuchsia or turquoise. This way the lace can be chosen tone-on-tone with the leather or deliberately as an accent. Red and light beige are available in 60, 75 and 120 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">F4-CS colours</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Black</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream<br><span class=\"small text-muted font-weight-normal\">3 colours</span></td><td class=\"py-3 px-3 align-middle\">White, light beige, greige</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey<br><span class=\"small text-muted font-weight-normal\">4 colours</span></td><td class=\"py-3 px-3 align-middle\">Light grey, pebble grey, mid grey, grey</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown &amp; beige<br><span class=\"small text-muted font-weight-normal\">15 colours</span></td><td class=\"py-3 px-3 align-middle\">Light beige, beige, greige, dark beige, light taupe, taupe, light brown, caramel brown, cognac, nut brown, mid brown, brown, mahogany, dark brown, black-brown</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Yellow<br><span class=\"small text-muted font-weight-normal\">2 colours</span></td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Orange<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Orange</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Red &amp; pink<br><span class=\"small text-muted font-weight-normal\">9 colours</span></td><td class=\"py-3 px-3 align-middle\">Pink, dusty pink, hot pink, fuchsia, magenta, red, wine red, aubergine, purple</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Green<br><span class=\"small text-muted font-weight-normal\">7 colours</span></td><td class=\"py-3 px-3 align-middle\">Mint green, light green, green, khaki green, olive green, military green, dark green</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blue<br><span class=\"small text-muted font-weight-normal\">6 colours</span></td><td class=\"py-3 px-3 align-middle\">Light blue, turquoise, blue, royal blue, navy, purple</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which colours does the waxed 4 mm flat lace F4-CS come in?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a08eddcf-88f6-4782-8842-dcd108725727","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>You lay the flat lace into the hook: cross first, then lay it in under tension. If you pull it tight in the channel of the hook, it chafes quickly.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Pulling in the wrong direction is the most common cause of early wear on hooks. In the eyelets below, guide the lace through the eyelet with one hand and let the loose end slide over a finger of the other hand under light tension. Only pull once the lace lies flat. If you prefer it simpler, use the 3 mm round lace on hooks; it is less vulnerable there. Flat or round is a matter of taste.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; hooks&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Eyelets<br><span class=\"small text-muted font-weight-normal\">Lower part</span></td><td class=\"py-3 px-3 align-middle\">Guide the lace through the eyelet with one hand, let the loose end slide over a finger under light tension.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Crossing<br><span class=\"small text-muted font-weight-normal\">Before each hook</span></td><td class=\"py-3 px-3 align-middle\">Cross first, then lead to the hook.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">Upper part</span></td><td class=\"py-3 px-3 align-middle\">Lay in under tension, do not pull tight through the channel.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chafes quickly<br><span class=\"small text-muted font-weight-normal\">Burrs</span></td><td class=\"py-3 px-3 align-middle\">Hooks or eyelets often have sharp burrs. Deburring once helps.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Round instead of flat<br><span class=\"small text-muted font-weight-normal\">A matter of taste</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you lace 4 mm flat laces on shoes with hooks?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"08b17deb-07bb-42a1-96f1-acfbaddb04b3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Tightly braided laces made of 100 % cotton, such as the F4-CS, do not stretch out. They keep their shape even when soaked.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">For the F4-CS, the number of bobbins and the yarn thickness are matched to the lace during braiding; it is then waxed, hot-rolled and polished. The ends are sealed with crimped aglets, so they do not fray.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F4-CS at a glance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F4-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Braid</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, densely braided.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Under tension<br><span class=\"small text-muted font-weight-normal\">Stretch</span></td><td class=\"py-3 px-3 align-middle\">Tightly braided, does not stretch out.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wet weather<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">Keeps its shape even when soaked.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Finish<br><span class=\"small text-muted font-weight-normal\">Wax</span></td><td class=\"py-3 px-3 align-middle\">Waxed, hot-rolled and polished.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Ends<br><span class=\"small text-muted font-weight-normal\">Aglets</span></td><td class=\"py-3 px-3 align-middle\">Crimped, do not fray.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Production</span></td><td class=\"py-3 px-3 align-middle\">Made in the EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">For comparison<br><span class=\"small text-muted font-weight-normal\">Other series</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelaces do not stretch undesirably when worn?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"429d97f6-83cf-406a-8127-5577f4dcb4ce","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. For classic shoes, the number of pairs of eyelets is a good rule of thumb, for example 75 cm for 4 to 5 pairs of eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The F4-CS comes in 60, 75, 90 and 120 cm. The right length also depends on the lacing style and on the foot. The further apart the eyelets are, as on sneakers, the less the rule of thumb applies. For women's sizes, one size shorter is often enough.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Chukka boots, Derbies with short lacing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Derbies with visible eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbies for a wider foot, slim leather sneakers.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, leather sneakers with many eyelets.</td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace length do you choose for 4 mm flat laces?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"351689e4-8002-462c-bb6b-0d4dcef02c5a","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"2a0eabdd-ac63-475d-878e-7b6219ff7c0d","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"4ff58607-8945-418e-93e6-e1b7518d7f41","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"febe121d-a369-4daf-83a4-83dfaf71c71b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]