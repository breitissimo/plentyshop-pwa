[{"name":"MultiGrid","type":"structure","meta":{"uuid":"7ac14040-7654-4700-9219-a0f2d31b48e4","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"937c4625-3dd2-4c70-b792-8107f9aa12a9","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"25cf1052-5849-4a46-9c2d-e18dc947071d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>With a little care. If a lace looks dull, pull it firmly through a cloth with a little shoe cream. Friction and warmth redistribute the wax.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">When you clean your shoes, usually only the visible top gets some. So now and then, unthread the lace completely so that the parts inside the eyelets are cared for too. This works many times, but not for ever: at some point a new pair is due. Over time the lace develops a beautiful patina together with the shoe.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Care&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Care</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">What it does</th><th scope=\"col\" class=\"py-3 px-3\">Suitable for</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Refreshing<br><span class=\"small text-muted font-weight-normal\">Friction and warmth</span></td><td class=\"py-3 px-3 align-middle\">Close a cloth with a little shoe cream firmly around the lace and pull it along firmly. Protect your fingers with the cloth.</td><td class=\"py-3 px-3 align-middle\">The wax is redistributed and the lace regains its sheen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Unthreading<br><span class=\"small text-muted font-weight-normal\">Whole lace</span></td><td class=\"py-3 px-3 align-middle\">Take the lace out and treat it like this along its whole length.</td><td class=\"py-3 px-3 align-middle\">The parts inside the eyelets are cared for too.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Iron<br><span class=\"small text-muted font-weight-normal\">Flat laces only</span></td><td class=\"py-3 px-3 align-middle\">Briefly smooth the lace with an iron, then clean the iron.</td><td class=\"py-3 px-3 align-middle\">The wax is redistributed and the lace lies smooth again.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do waxed shoelaces keep their supple feel?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"571377e9-41d6-4445-9fe5-85d84d387da5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Shoelaces are not woven but braided. Woven ribbons are known as decorative and gift ribbons.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">What matters is how densely they are braided. The number of bobbins and the yarn thickness are matched to each lace during braiding. A densely and tightly braided lace is tear-resistant, hardly stretches and keeps its shape even when wet. Cheap laces, on the other hand, are often loosely braided.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Construction&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shape</th><th scope=\"col\" class=\"py-3 px-3\">Construction</th><th scope=\"col\" class=\"py-3 px-3\">What it does</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Round laces<br><span class=\"small text-muted font-weight-normal\">2 and 3 mm</span></td><td class=\"py-3 px-3 align-middle\">Braided round, the thicker ones around a core cord. This gives volume.</td><td class=\"py-3 px-3 align-middle\">Round and shape-retaining.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flat laces<br><span class=\"small text-muted font-weight-normal\">3, 4 and 6 mm</span></td><td class=\"py-3 px-3 align-middle\">Hollow cord that is then rolled flat.</td><td class=\"py-3 px-3 align-middle\">Lies flat in the lacing.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braiding<br><span class=\"small text-muted font-weight-normal\">Number of bobbins, yarn thickness</span></td><td class=\"py-3 px-3 align-middle\">Densely braided from 100 % cotton.</td><td class=\"py-3 px-3 align-middle\">Tear-resistant, does not stretch out.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why are densely braided shoelaces better than woven ones?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a1ca78bf-98f7-4121-b4eb-4abd986d2844","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The thickness depends on the eyelets, not on the colour. The 2 mm round laces and the flat 3 mm lace are made for concealed eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The lace should pass easily through the eyelet, otherwise it is put under heavy strain when it is pulled through. If the shoe has visible eyelets or hooks, like many lace-up ankle boots and country Derbies, the 3 mm round lace and the 4 mm flat lace also fit. Navy is available in all these series.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; lace thickness&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Shades of blue</th><th scope=\"col\" class=\"py-3 px-3\">Shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Navy, blue, grey-blue, light blue, turquoise, purple</td><td class=\"py-3 px-3 align-middle\">Oxfords, fine Derbies, brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Blu (navy), Azzurro (midnight blue), Testa di Azzurro (base blue), Royal (royal blue), Cielo (light blue), Celeste (turquoise)</td><td class=\"py-3 px-3 align-middle\">Fine Oxfords and Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">The understated flat lace</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Navy, blue, royal blue, light blue, turquoise, purple</td><td class=\"py-3 px-3 align-middle\">Classic low shoes, brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">Stronger</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle\">Navy, royal blue, purple</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, country Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flat<br><span class=\"small text-muted font-weight-normal\">Stronger</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle\">Navy, blue, royal blue, light blue, turquoise, purple</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, open Derbies</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace thickness do you choose for navy Oxfords and Derbies?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"69d6e737-5409-447e-ad13-9652c6fa39a4","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Blue on brown leather is a classic contrast. The darker the blue, the calmer it looks.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Dark brown smooth leather suits a dark blue that only stands out at second glance. On lighter brown and cognac it may be stronger. Worn together, the blue picks up a navy suit, a skirt suit, a jacket or jeans.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Blue &amp; brown&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Shade of blue</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark brown smooth leather<br><span class=\"small text-muted font-weight-normal\">Oxford, Derby</span></td><td class=\"py-3 px-3 align-middle\">Navy, Blu (navy), Azzurro (midnight blue)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Discreet, only noticed at second glance.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mid brown, cognac<br><span class=\"small text-muted font-weight-normal\">Smooth leather, brogue</span></td><td class=\"py-3 px-3 align-middle\">Blue, Testa di Azzurro (base blue)</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Clear contrast, suits a blue suit.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown suede<br><span class=\"small text-muted font-weight-normal\">Lace-up ankle boot</span></td><td class=\"py-3 px-3 align-middle\">Navy, royal blue</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Strong, nice with jeans and chinos.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown boots<br><span class=\"small text-muted font-weight-normal\">Workwear, heritage</span></td><td class=\"py-3 px-3 align-middle\">Blue</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Rustic, in a vintage look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneakers<br><span class=\"small text-muted font-weight-normal\">Brown leather</span></td><td class=\"py-3 px-3 align-middle\">Light blue, turquoise</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Fresh and cheerful.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you combine navy laces stylishly with brown leather shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"1c06019a-717b-4287-93c0-4f62782616c3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The dyeing is done by the yarn manufacturers. They dye the cotton yarns with special dyeing and fixing processes before the laces are braided from them.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The wax does not bind the colour, but it forms a protective barrier: it penetrates the fibre structure of the braid. With normal wear, the laces stay colourfast for a long time thanks to good dyeing. With the Splendore di Laccico, the laces run more slowly through the wax bath, which gives the blue a special depth of colour.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colour &amp; wax&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">What happens</th><th scope=\"col\" class=\"py-3 px-3\">What it does</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dyeing<br><span class=\"small text-muted font-weight-normal\">Yarn</span></td><td class=\"py-3 px-3 align-middle\">The yarn manufacturers dye and fix the cotton yarns.</td><td class=\"py-3 px-3 align-middle\">Even colour along the whole length.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Waxing<br><span class=\"small text-muted font-weight-normal\">Finish</span></td><td class=\"py-3 px-3 align-middle\">Waxed, hot-rolled and polished. The wax penetrates the fibre structure.</td><td class=\"py-3 px-3 align-middle\">Protective barrier, silky-matt sheen.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Longer wax bath<br><span class=\"small text-muted font-weight-normal\">SL only</span></td><td class=\"py-3 px-3 align-middle\">The laces run more slowly through the wax bath and are more heavily waxed.</td><td class=\"py-3 px-3 align-middle\">Special depth of colour, sheen like fine calfskin.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do deep blue waxed shoelaces keep their colour?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"81a198a3-5878-4c19-8eb4-8e52743c2cca","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"fe2f75f1-54af-4f38-8ba1-83843f478086","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"f72ee52b-caed-4383-b87c-b78cca634b4d","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"265c1760-fa02-4fc8-8e99-b900dbc605e7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]