:"735","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":4},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"07088def-406b-46b1-8043-535830785ff3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":5},{"name":"CategoryData","type":"content","meta":{"uuid":"7fa26b64-bb48-4bd8-90e0-6bb1581e33b6","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":6}]}]