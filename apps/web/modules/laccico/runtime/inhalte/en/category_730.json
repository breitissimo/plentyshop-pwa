[{"name":"MultiGrid","type":"structure","meta":{"uuid":"5be388a2-6485-4984-a1e0-77eacd017060","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"b24e3aec-5b31-439f-81b2-a6b68a398352","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"6a2416d6-9da1-4a9b-ad61-b51b1626b651","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"79efbf49-c40f-4443-b0b2-5830ad9e49b6","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Heritage and workwear boots with eyelets of 5 mm inner diameter or more suit the 6 mm flat lace F6-XR. It has more volume because more yarn is braided into it, and it looks rustic.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Its strong braid pattern suits sturdy leather and a striking sole. On high-top sneakers and boots in workwear style, the F6-CS looks just as good; it is finer and looks refined. Lace-up ankle boots with eyelets and hooks take the 4 mm flat lace or the 3 mm round lace; that is a matter of taste.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lace by style&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Boots</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Strong strands, rustic.</td><td class=\"py-3 px-3 align-middle\">Moc-toe boots, heritage and workwear boots.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Fine braid pattern, refined.</td><td class=\"py-3 px-3 align-middle\">Boots in workwear style, high-top sneakers.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Slim, subtle sheen.</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with eyelets and hooks.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Strong round cord.</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots and boots with hooks.</td><td class=\"py-3 px-3 align-middle\">45–150 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which laces suit fashionable heritage and striking workwear styles?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a1588de2-b547-46da-97cb-271c404d5518","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For work boots with visible eyelets and hooks, the 6 mm flat lace F6-XR is the best choice. Waxed cotton is tear-resistant and long-lasting.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The flat lace looks stronger on boots; if you have mastered laying it into the hooks, you will happily choose the flat one. That is a matter of taste. In any case, the lace must suit the eyelet.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Round or flat&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">On hooks</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Lay in flat, do not pull it through the channel.</td><td class=\"py-3 px-3 align-middle\">Strong, rustic.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Less vulnerable, does not twist.</td><td class=\"py-3 px-3 align-middle\">More understated.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which laces are suitable for work boots?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"8ba3f9b6-0e59-46ec-9b28-87b9d2f95d6e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed shoelaces made of 100 % cotton are water-repellent and keep their shape even when wet. Tightly braided, they do not stretch out.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The wax penetrates the fibre structure of the cotton braid, much like tanning agents penetrate leather. That is why the lace is also dirt-resistant. When wet, the bow does not come undone as easily.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Wet &amp; dirt&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Situation</th><th scope=\"col\" class=\"py-3 px-3\">What happens</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Rain<br><span class=\"small text-muted font-weight-normal\">Water-repellent</span></td><td class=\"py-3 px-3 align-middle\">The wax in the braid keeps water out.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Soaked<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">The lace keeps its shape and does not stretch out.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bow<br><span class=\"small text-muted font-weight-normal\">When wet</span></td><td class=\"py-3 px-3 align-middle\">Does not come undone as easily.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Become dull<br><span class=\"small text-muted font-weight-normal\">Care</span></td><td class=\"py-3 px-3 align-middle\">Close a cloth with a little shoe cream firmly around the lace and pull it along firmly.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">For boots<br><span class=\"small text-muted font-weight-normal\">Lace</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> (eyelets of 5 mm inner diameter or more)<br><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> (eyelets of 4 mm inner diameter or more)</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelaces keep their shape even when wet?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"99eb4fff-3fc2-4bfe-a398-9310ced44d5d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>You lay the lace into the hook: cross first, then lay it in under tension. If you pull it tight in the channel of the hook, it chafes quickly.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Pulling in the wrong direction is the most common cause of early wear on hooks. Hooks or eyelets often have sharp burrs. If a lace wears through early, deburr the hooks and eyelets once.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Hooks&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Crossing<br><span class=\"small text-muted font-weight-normal\">Before each hook</span></td><td class=\"py-3 px-3 align-middle\">Cross first, then lead to the hook.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Laying in<br><span class=\"small text-muted font-weight-normal\">Under tension</span></td><td class=\"py-3 px-3 align-middle\">Lay in under tension, do not pull tight through the channel.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chafes quickly<br><span class=\"small text-muted font-weight-normal\">Burrs</span></td><td class=\"py-3 px-3 align-middle\">Deburr hooks and eyelets once.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flat laces<br><span class=\"small text-muted font-weight-normal\">Twisted</span></td><td class=\"py-3 px-3 align-middle\">Before laying in, check that the lace lies flat. Once pulled tight while twisted, the twist is hard to correct.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Less vulnerable<br><span class=\"small text-muted font-weight-normal\">Round laces</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you stop shoelaces from chafing on hooks?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"ffaeb818-8286-4f97-98fc-c96a7107007a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. Ankle-high boots usually take 120 cm, tall lace-up boots 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Thicker laces need a little more length than thin ones. On boots the eyelets are far apart, so a rule of thumb based on pairs of eyelets helps little here. The R3-CS comes in lengths from 45 to 150 cm, the F4-CS up to 120 cm, the F6-CS and the F6-XR up to 150 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical boots</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Low</span></td><td class=\"py-3 px-3 align-middle\">Chukkas and low boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, ankle-high boots, moc-toe boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a> (eyelets of 5 mm inner diameter or more)<br><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> (eyelets of 4 mm inner diameter or more)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">High shaft</span></td><td class=\"py-3 px-3 align-middle\">Tall lace-up boots, workwear boots.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Round</span></td><td class=\"py-3 px-3 align-middle\">Tall lace-up boots with hooks.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which lengths do you choose for classic work boots, lace-up boots and outdoor shoes?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"MultiGrid","type":"structure","meta":{"uuid":"b65ef9d2-c01f-43ef-b21a-d1f89f0ccad4","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"efffda90-232b-47c0-a2b9-56713381ac1a","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"556e0088-be43-40ff-9ce0-9bb8258edfab","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Outdoor/R3-CS-Dunkelbeige-szene-im-wald.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Outdoor/R3-CS-Dunkelbeige-szene-im-wald.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Outdoor/R3-CS-Dunkelbeige-szene-im-wald.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Outdoor/R3-CS-Dunkelbeige-szene-im-wald.jpg","alt":"","imageAlignment":"left","fillMode":"fill","aspectRatio":"3 / 2","linktarget":""},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","va