n":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"Image","type":"content","meta":{"uuid":"17ee6b1c-470a-481c-bad5-dfc2a64022e7","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/6_mm/F6-XR/0479C6-_0023_ELT23-XR-HELLBRAUN-5.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/6_mm/F6-XR/0479C6-_0023_ELT23-XR-HELLBRAUN-5.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/6_mm/F6-XR/0479C6-_0023_ELT23-XR-HELLBRAUN-5.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/6_mm/F6-XR/0479C6-_0023_ELT23-XR-HELLBRAUN-5.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"Image","type":"content","meta":{"uuid":"cc5e180e-17d6-4bb6-8a8d-019018be8c26","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/4_mm/Eingefaedelt/detail_0000__0013_P1180734.jpg.jpg.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/4_mm/Eingefaedelt/detail_0000__0013_P1180734.jpg.jpg.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/4_mm/Eingefaedelt/detail_0000__0013_P1180734.jpg.jpg.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/4_mm/Eingefaedelt/detail_0000__0013_P1180734.jpg.jpg.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"Image","type":"content","meta":{"uuid":"a66119a1-4b24-45cb-899c-06f0b4da1df3","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}}],"parent_slot":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"46777f94-74fc-48e4-ba32-56249b264081","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"eb94e3d9-939a-435b-91d6-b00b24911911","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"1e9bc65a-7785-4660-b1fd-ab90d5ca1aec","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 3 mm flat lace is the best fit for classic low shoes with concealed eyelets: Oxfords, Derbies and Brogues in smooth leather. It is the finest of our flat laces.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With concealed eyelets you only see a small hole in the leather from the outside. The 3 mm flat lace and the 2 mm round lace are made for these. The round lace steps back completely; the narrow flat lace adds a small surprise that connoisseurs notice. All wider flat laces are for visible eyelets.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Flat laces compared&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Width</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm<br><span class=\"small text-muted font-weight-normal\">Concealed eyelets</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Very understated, a quiet accent.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Classic Oxfords, Derbies and Brogues.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm<br><span class=\"small text-muted font-weight-normal\">Visible eyelets, 4 mm inner diameter or more</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Slim, smart and sporty.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with eyelets and hooks, slim leather sneakers.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Visible eyelets, 5 mm inner diameter or more</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Fine braid pattern, refined.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">High-quality sneakers, comfort shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Visible eyelets, 5 mm inner diameter or more</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">More yarn, rustic, soft yet solid grip.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">Sneakers and boots in vintage and workwear style.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"When is a 3 mm wide flat lace (F3) the best fit?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"644f3542-9690-4e86-87c6-f971c80562f9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed flat laces made of 100 % cotton suit the leather of a high-quality sneaker: a subtle sheen, a high-quality feel, and they are tear-resistant and long-lasting.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The wax penetrates the fibre structure of the cotton braid, much like tanning agents penetrate leather. This makes the lace water-repellent and dirt-resistant, and it keeps its shape even when wet. When wet, the bow does not come undone as easily. New waxed laces are a little stiff at first and become more supple with wear.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> On the sneaker&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Property</th><th scope=\"col\" class=\"py-3 px-3\">Where from</th><th scope=\"col\" class=\"py-3 px-3\">On the sneaker</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Subtle sheen<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Hot-rolled and polished.</td><td class=\"py-3 px-3 align-middle\">Looks like a fine leather band and suits smooth leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Tear-resistant<br><span class=\"small text-muted font-weight-normal\">Durability</span></td><td class=\"py-3 px-3 align-middle\">Densely braided cotton.</td><td class=\"py-3 px-3 align-middle\">Also for tight lacing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Water-repellent<br><span class=\"small text-muted font-weight-normal\">Weather</span></td><td class=\"py-3 px-3 align-middle\">The wax protects the fibre.</td><td class=\"py-3 px-3 align-middle\">Keeps its shape even when wet.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hardly stretches<br><span class=\"small text-muted font-weight-normal\">Braid</span></td><td class=\"py-3 px-3 align-middle\">Tightly braided.</td><td class=\"py-3 px-3 align-middle\">Does not stretch out.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">Choice</span></td><td class=\"py-3 px-3 align-middle\">Choose according to the eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What speaks for waxed flat laces on premium sneakers?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e8654cf2-f425-47ab-be01-27962346696b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 6 mm flat lace looks good on shoes with visible eyelets of 5 mm inner diameter or more, especially on sneakers and boots. There the wide surface has room and suits the sturdy build.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">It comes in two versions. The F6-CS has a fine, understated braid pattern and looks refined, even in strong colours. In shorter lengths it suits comfort shoes and Derbies with two pairs of holes and visible eyelets. The F6-XR is higher and heavier; it has more volume because more yarn is braided into it. It looks rustic and belongs on moc-toe boots, heritage and workwear shoes.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-CS &amp; F6-XR&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braid pattern<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Fine and unobtrusive.</td><td class=\"py-3 px-3 align-middle\">Strong strands, coarser.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grip<br><span class=\"small text-muted font-weight-normal\">In the hand</span></td><td class=\"py-3 px-3 align-middle\">Flat and supple.</td><td class=\"py-3 px-3 align-middle\">Higher, soft yet solid grip.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Effect<br><span class=\"small text-muted font-weight-normal\">Style</span></td><td class=\"py-3 px-3 align-middle\">Refined, for the city.</td><td class=\"py-3 px-3 align-middle\">Rustic, vintage look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Shoes<br><span class=\"small text-muted font-weight-normal\">Use</span></td><td class=\"py-3 px-3 align-middle\">High-quality sneakers, comfort shoes, boots.</td><td class=\"py-3 px-3 align-middle\">Boots, workwear, sneakers in vintage style.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Narrower<br><span class=\"small text-muted font-weight-normal\">For comparison</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">F3 for concealed eyelets, F4 for visible eyelets of 4 mm inner diameter or more.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">Page</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"When does a 6 mm wide shoelace (F6) look good?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4a4664ed-d596-4d04-a43c-53fe259dbb0b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For slim leather sneakers and smart casual shoes with visible eyelets of 4 mm inner diameter or more, the 4 mm flat lace (F4-CS) is the right choice. From 5 mm inner diameter, the 6 mm flat lace fits as well.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The F4 is particularly popular on lace-up ankle boots with eyelets and hooks. On hooks, lay the flat lace in instead of pulling it through the channel of the hook, otherwise it chafes quickly. If you prefer round laces there, choose the 3 mm round lace; that is a matter of taste. Court sneakers take the 6 mm flat lace.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes &amp; laces&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Slim leather sneakers<br><span class=\"small text-muted font-weight-normal\">Smart and sporty</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 4 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Smart casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Eyelets below, hooks above.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Court sneakers<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 5 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Comfort shoes<br><span class=\"small text-muted font-weight-normal\">Everyday</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 5 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which flat laces suit smart sporty sneakers and smart casual shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"025ba8fe-b0d1-40f5-88f4-1337727d680e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Twisting does not depend on the material, but on how you handle the lace. With one hand you guide the lace through the eyelet, while the loose end slides over a finger of the other hand under light tension.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">That way the eyelet acts like a guide rail and the lace runs through flat. Once it has been pulled tight while twisted, the twist is hard to correct. The right width also matters: the flat lace should suit the eyelet so that it can lie flat. That is a master's tip from the workshop.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lacing&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">Why</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Threading<br><span class=\"small text-muted font-weight-normal\">One hand</span></td><td class=\"py-3 px-3 align-middle\">Guide the lace flat through the eyelet.</td><td class=\"py-3 px-3 align-middle\">The eyelet acts like a guide rail.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Loose end<br><span class=\"small text-muted font-weight-normal\">Other hand</span></td><td class=\"py-3 px-3 align-middle\">Let it slide over a finger under light tension.</td><td class=\"py-3 px-3 align-middle\">That way the lace does not twist.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Tightening<br><span class=\"small text-muted font-weight-normal\">At the end</span></td><td class=\"py-3 px-3 align-middle\">Only pull once the lace lies flat.</td><td class=\"py-3 px-3 align-middle\">Once pulled tight while twisted, the twist is hard to correct.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">To suit the eyelet</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">3 mm</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">4 mm</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">6 mm</a></td><td class=\"py-3 px-3 align-middle\">The more easily the lace glides through the eyelet, the easier it is to keep flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">Ankle boots</span></td><td class=\"py-3 px-3 align-middle\">Lay it in, do not pull it through the channel.</td><td class=\"py-3 px-3 align-middle\">Otherwise the flat lace chafes quickly.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Our frequently asked questions</a></td><td class=\"py-3 px-3 align-middle\">More questions about shoelaces and shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you stop flat laces from twisting annoyingly when lacing?","defaultOpen":false}}}],"parent_slot":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"eb3569dd-9d5a-4ce1-b4ba-458029827e47","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"laccico-listenkopf\"><h2>F6-CS</h2><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\">» View all</a></div>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"705","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"c8d47f63-1159-4d4c-a1a9-ae7d2ae8e09f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"laccico-listenkopf\"><h2>F6-XR</h2><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\">» View all</a></div>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"702","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":1},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"3e4b6e18-22dc-4a25-b8d4-7fc82f836363","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"laccico-listenkopf\"><h2>Flat laces 4 mm</h2><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\">» View all</a></div>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"737","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ecbd98a2-f7ea-49a2-a886-d38650a895e8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"laccico-listenkopf\"><h2>Flat laces 3 