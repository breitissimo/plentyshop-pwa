[{"name":"MultiGrid","type":"structure","meta":{"uuid":"6cfdcc05-9d9e-440f-ba13-89434291d6cf","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"df42d9af-5e35-49f2-87de-9aa5c6037dbe","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"d1835103-0114-4e9d-97d8-30758323b75d","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"40591d7c-6527-4bae-be4a-36940fff3b26","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Double-waxed means that the braided lace runs more slowly through the wax bath and soaks up more wax. It is then polished for longer. This gives the R2-SL its special depth of colour and a splendid sheen like fine calfskin.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Waxing takes place before cutting to length: the lace runs over a roller system through the wax and is only then cut to length. More wax means more polishing work, and the lace is noticeably grippier at first. That is not a defect but part of it: it becomes supple with wear.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Double-waxed&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">What happens</th><th scope=\"col\" class=\"py-3 px-3\">What you get</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wax bath<br><span class=\"small text-muted font-weight-normal\">Slowly, over rollers</span></td><td class=\"py-3 px-3 align-middle\">The lace soaks up more wax.</td><td class=\"py-3 px-3 align-middle\">Special depth of colour.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Polishing<br><span class=\"small text-muted font-weight-normal\">More handwork</span></td><td class=\"py-3 px-3 align-middle\">The wax is polished for longer.</td><td class=\"py-3 px-3 align-middle\">Splendid sheen like fine calfskin.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wax in the fibre<br><span class=\"small text-muted font-weight-normal\">Protection</span></td><td class=\"py-3 px-3 align-middle\">The wax penetrates the braid.</td><td class=\"py-3 px-3 align-middle\">Protection against moisture, long-lasting.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grip<br><span class=\"small text-muted font-weight-normal\">Feel</span></td><td class=\"py-3 px-3 align-middle\">Grippy and firm at first.</td><td class=\"py-3 px-3 align-middle\">Becomes supple with wear.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What does “double-waxed” mean for the Splendore di Laccico (R2-SL)?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0eafb8b4-3b0e-48df-a83f-05b39ae6b59e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The R2-SL belongs on fine, Goodyear-welted smooth-leather shoes with concealed eyelets: Oxfords, Derbies and full brogues in box calf or shell cordovan, as well as evening shoes and fine lace-up ankle boots.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">In this segment, smooth leather is almost always box calf, the classic leather of fine Goodyear-welted shoes. Its polished sheen and the sheen of the R2-SL go together. For sneakers and boots with visible eyelets, a 2 mm round lace is too fine; thicker laces fit there.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes &amp; leather&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Leather</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxfords<br><span class=\"small text-muted font-weight-normal\">Closed lacing</span></td><td class=\"py-3 px-3 align-middle\">Box calf</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td><td class=\"py-3 px-3 align-middle\">The sheen of the lace meets polished calfskin.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Open lacing</span></td><td class=\"py-3 px-3 align-middle\">Box calf, shell cordovan</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td><td class=\"py-3 px-3 align-middle\">The deep sheen of cordovan finds its counterpart in the lace.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Full brogues<br><span class=\"small text-muted font-weight-normal\">Perforations, decorative stitching</span></td><td class=\"py-3 px-3 align-middle\">Box calf</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td><td class=\"py-3 px-3 align-middle\">The fine lace lets the perforations take centre stage.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Evening shoes<br><span class=\"small text-muted font-weight-normal\">Dinner jacket, tailcoat, special occasions</span></td><td class=\"py-3 px-3 align-middle\">Polished box calf</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td><td class=\"py-3 px-3 align-middle\">A lace for formal wear.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Fine, with concealed eyelets</span></td><td class=\"py-3 px-3 align-middle\">Smooth leather</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td><td class=\"py-3 px-3 align-middle\">Long lengths up to 180 cm, also for women's boots.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which types of shoe and leather go best with R2-SL round laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f41e4316-178f-4512-8667-228b3ea657e0","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The R2-SL comes in over 40 colours, each in all lengths from 45 to 180 cm. The colours carry their Italian names, from Bianco to Grigio Ferro.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Alongside classics such as Nero (black), Testa di Moro (base brown) and Blu (navy), there are quiet tones such as Grigio Perla (pearl grey) or Panna (cream) and strong ones such as Bordo (wine red), Senape (mustard) or Bottiglia (bottle green). This way the lace can be chosen tone-on-tone with the leather or deliberately as an accent.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">R2-SL colours</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Nero (black)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream<br><span class=\"small text-muted font-weight-normal\">2 colours</span></td><td class=\"py-3 px-3 align-middle\">Bianco (white), Panna (cream)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey<br><span class=\"small text-muted font-weight-normal\">6 colours</span></td><td class=\"py-3 px-3 align-middle\">Grigio Perla (pearl grey), Grigio 85 (grey 85), Grigio (grey), Grigio Medio (mid grey), Grigio Scuro (dark grey), Grigio Ferro (steel grey)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown &amp; beige<br><span class=\"small text-muted font-weight-normal\">9 colours</span></td><td class=\"py-3 px-3 align-middle\">Beige, Pain Brule (bread crust), Cuoio (leather), Cognac, Tabacco (tobacco), Ruggine (rust), Marrone 8 (brown 8), Testa di Moro (base brown), Melanzana (aubergine)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Yellow<br><span class=\"small text-muted font-weight-normal\">3 colours</span></td><td class=\"py-3 px-3 align-middle\">Giallino (pale yellow), Giallo (sun yellow), Senape (mustard)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Orange<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Arancione (orange)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Red &amp; pink<br><span class=\"small text-muted font-weight-normal\">8 colours</span></td><td class=\"py-3 px-3 align-middle\">Salmone (salmon pink), Rosa Scuro (dark pink), Fuchsia, Rosso (red), Bordo (wine red), Viola (purple red), Viola 2 (dark lilac), Lilla (lilac)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Green<br><span class=\"small text-muted font-weight-normal\">5 colours</span></td><td class=\"py-3 px-3 align-middle\">Mela (apple green), Verde (green), Verde 7 (green 7), Militare (army green), Bottiglia (bottle green)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blue<br><span class=\"small text-muted font-weight-normal\">6 colours</span></td><td class=\"py-3 px-3 align-middle\">Cielo (light blue), Celeste (turquoise), Royal (royal blue), Testa di Azzurro (base blue), Blu (navy), Azzurro (midnight blue)</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">All colours<br><span class=\"small text-muted font-weight-normal\">each 45–180 cm</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark d-block\">R2-SL</span></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which colours does the R2-SL come in?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0849dadd-f968-4eda-9ef7-f708309a9544","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The Splendore di Laccico is made in Italy. “Splendore” means sheen, and it is the sheen that defines this series.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The braiding mill mainly supplies shoe factories, so the R2-SL is of original-equipment quality. The colour names are Italian too: Cuoio, Tabacco, Bottiglia. It is the showpiece among LACCICO shoelaces, made for everyone who loves the details of a good shoe.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Profile&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">R2-SL</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Made in Italy</span></td><td class=\"py-3 px-3 align-middle\">Made in Italy.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Name<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle\">“Splendore” means sheen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Shape<br><span class=\"small text-muted font-weight-normal\">Round lace</span></td><td class=\"py-3 px-3 align-middle\">2 mm diameter, for concealed eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Braid</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, braided to be tear-resistant.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Waxing<br><span class=\"small text-muted font-weight-normal\">Finish</span></td><td class=\"py-3 px-3 align-middle\">Double-waxed: longer wax bath, more polishing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Range<br><span class=\"small text-muted font-weight-normal\">Colours &amp; lengths</span></td><td class=\"py-3 px-3 align-middle\">Over 40 colours, each in 45, 60, 75, 90, 120, 150 and 180 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sister series<br><span class=\"small text-muted font-weight-normal\">Same diameter, standard waxing</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Where does the Splendore di Laccico come from and what does the name mean?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"d9448a21-dc9a-430d-8218-b34125652c74","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>If the R2-SL becomes dull over time, refresh it with a cloth and a little shoe cream: close the cloth firmly around the lace and pull it along firmly. Friction and warmth redistribute the wax.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Protect your fingers with a cloth or a piece of leather while doing so. Now and then, unthread the lace completely so that the hidden parts are cared for too. This works many times, but not for ever. Washing machines and bleach are not meant for waxed laces.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Care&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Situation</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Become dull<br><span class=\"small text-muted font-weight-normal\">Refresh the sheen</span></td><td class=\"py-3 px-3 align-middle\">Close a cloth with a little shoe cream firmly around it and pull it along firmly.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hidden parts<br><span class=\"small text-muted font-weight-normal\">Under the eyelets</span></td><td class=\"py-3 px-3 align-middle\">Now and then, unthread the lace completely and care for it along its whole length.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Light colours<br><span class=\"small text-muted font-weight-normal\">Bianco, Panna</span></td><td class=\"py-3 px-3 align-middle\">Remove light dust with a soft cotton cloth: close it firmly around the lace and pull it through.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Heavily soiled<br><span class=\"small text-muted font-weight-normal\">Replace</span></td><td class=\"py-3 px-3 align-middle\">Thread in a new lace.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Got wet<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">It keeps its shape even when soaked, because it is tightly braided.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Also applies to<br><span class=\"small text-muted font-weight-normal\">Other waxed round laces</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you care for double-waxed shoelaces such as the R2-SL?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"49851435-fc3d-431e-94b1-a3a8ad56e3aa","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"SortFilter","type":"content","meta":{"uuid":"16f5bb38-0267-4231-8517-687b11be86a6","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoLaengenleiste","type":"content","meta":{"uuid":"5208c0bb-ae0a-45d9-be03-f2bd9c51800f","isGlobalTemplate":false},"parent_slot":1,"slot_index":2,"content":{"anzeigen":true}},{"name":"ItemGrid","type":"content","meta":{"uuid":"f56d3a9e-b1f1-4e65-bf51-cec1ba3da2b3","isGlobalTemplate":false},"parent_slot":1,"slot_index":3,"content":{"itemsPerRowDesktop":4,"itemsPerRowTablet":2,"itemsPerRowMobile":2,"showItemCount":false,"itemCountPosition":"left","fields":{"manufacturer":false,"title":true,"rating":true,"previewText":false,"price":true,"addToCart":true},"fieldsOrder":["manufacturer","title","rating","previewText","price","addToCart"],"fieldsDisabled":["title"],"contentAlignment":"left","cardBorders":false,"showSecondImageOnHover":true,"showWishlistButton":false,"addToCartStyle":"primary","paginationPosition":"both"}},{"name":"CategoryData","type":"content","meta":{"uuid":"a212744f-e446-4772-a15e-050c76d618d7","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":4},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"d239bea7-d46e-4a69-940d-93e221e7587e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":5}]}]