[{"name":"MultiGrid","type":"structure","meta":{"uuid":"36e57e62-d3e8-4a95-bcdb-f32a5a164730","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"3377e3b8-7e26-4691-9520-883f0fa1ad2c","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"7c7f291f-d304-4432-a921-4020065f2855","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed cotton laces. The wax penetrates the densely braided cotton, so dirt and moisture do not settle in the fibres as easily as with unwaxed laces.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">For boots, the lace depends on the eyelets: from 4 mm inner diameter the 3 mm round lace R3-CS fits, from 5 mm inner diameter the 6 mm flat laces F6-CS and F6-XR as well. Even so, a worn lace does not stay completely clean: over time a patina develops. Mustard yellow is more forgiving of signs of use than light yellows.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Boots &amp; yellow&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Shade of yellow</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Winter boots<br><span class=\"small text-muted font-weight-normal\">Smooth leather or suede</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow, traffic yellow</td><td class=\"py-3 px-3 align-middle\">Strong accent on dark leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Workwear boots<br><span class=\"small text-muted font-weight-normal\">Heritage</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Traffic yellow</td><td class=\"py-3 px-3 align-middle\">Rustic, in a vintage look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Casual boots<br><span class=\"small text-muted font-weight-normal\">Smooth leather or suede</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Yellow, citrus yellow, mustard yellow, traffic yellow</td><td class=\"py-3 px-3 align-middle\">Fresh and eye-catching.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelaces in yellow shades stand up best to winter dirt and slush?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6b535ebf-cb68-4350-a115-878753be90d8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Shoelaces are not woven but braided. Woven ribbons are known as decorative and gift ribbons.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">What matters is how densely they are braided. The number of bobbins and the yarn thickness are matched to each lace during braiding. A densely and tightly braided lace is tear-resistant, hardly stretches and keeps its shape even when wet.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Construction&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shape</th><th scope=\"col\" class=\"py-3 px-3\">Construction</th><th scope=\"col\" class=\"py-3 px-3\">What it does</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Round laces<br><span class=\"small text-muted font-weight-normal\">2 and 3 mm</span></td><td class=\"py-3 px-3 align-middle\">Braided round, the thicker ones around a core cord. This gives volume.</td><td class=\"py-3 px-3 align-middle\">Round and shape-retaining.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Flat laces<br><span class=\"small text-muted font-weight-normal\">3, 4 and 6 mm</span></td><td class=\"py-3 px-3 align-middle\">Hollow cord that is then rolled flat.</td><td class=\"py-3 px-3 align-middle\">Lies flat in the lacing.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braiding<br><span class=\"small text-muted font-weight-normal\">Number of bobbins, yarn thickness</span></td><td class=\"py-3 px-3 align-middle\">Densely braided from 100 % cotton.</td><td class=\"py-3 px-3 align-middle\">Tear-resistant, does not stretch out.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why are densely braided shoelaces better than woven ribbons for yellow contrast laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6e439195-c39b-49b0-8b84-0c199032205c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>On slim smooth-leather sneakers the 4 mm flat lace F4-CS works well, on retro sneakers with eyelets of 5 mm inner diameter or more the 6 mm flat lace F6-CS.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On white, grey or navy leather, yellow sets a fresh accent. Mustard yellow looks calmer, citrus yellow and traffic yellow shine more strongly.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Sneakers &amp; yellow&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Shade of yellow</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Smooth-leather sneakers<br><span class=\"small text-muted font-weight-normal\">Slim, minimalist</span></td><td class=\"py-3 px-3 align-middle\">Punched eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Slim and calm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Retro sneakers<br><span class=\"small text-muted font-weight-normal\">Wide eyelet row</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Sporty and present.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White sneakers<br><span class=\"small text-muted font-weight-normal\">Smooth leather or suede</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Citrus yellow, traffic yellow</td><td class=\"py-3 px-3 align-middle\">Fresh, with a strong contrast.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which flat laces suit smart sporty sneakers as a yellow accent?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"60f8b412-77a8-4d9a-adb3-53069c6e1d28","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The thickness depends on the eyelets, not on the colour. The 2 mm round laces and the flat 3 mm lace are made for concealed eyelets, the 3 mm round lace and the 4 mm flat lace for visible eyelets and hooks.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The lace should pass easily through the eyelet, otherwise it is put under heavy strain when it is pulled through. Yellow is available in all these series. The finest shades are in the R2-SL series from Italy: Giallo (sun yellow), Giallino (pale yellow), Senape (mustard) and Panna (cream).</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; lace thickness&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Shades of yellow</th><th scope=\"col\" class=\"py-3 px-3\">Shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Yellow, citrus yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbies, brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Giallo (sun yellow), Giallino (pale yellow), Senape (mustard), Panna (cream)</td><td class=\"py-3 px-3 align-middle\">Fine Oxfords and Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Derbies, brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow, traffic yellow</td><td class=\"py-3 px-3 align-middle\">Chukka boots, lace-up ankle boots</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle\">Yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Open Derbies, lace-up ankle boots</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace thickness is ideal for sporty contrast lacing with yellow laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6dfe8f30-2fd1-415f-8ccc-f71bd3feede8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>A soft cotton cloth removes light dust. If a light-coloured lace is really dirty, replace it.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Close the cloth firmly around the lace and pull it through firmly. This also redistributes the wax, so a dull lace gets its sheen back. If you wear light yellows, it is best to keep a supply.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Care &amp; replacement&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Situation</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th><th scope=\"col\" class=\"py-3 px-3\">What it does</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dust<br><span class=\"small text-muted font-weight-normal\">Slightly soiled</span></td><td class=\"py-3 px-3 align-middle\">Close a soft cotton cloth firmly around the lace and pull it through firmly.</td><td class=\"py-3 px-3 align-middle\">The dust is gone.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dull lace<br><span class=\"small text-muted font-weight-normal\">After longer wear</span></td><td class=\"py-3 px-3 align-middle\">Pull through the cloth in the same way.</td><td class=\"py-3 px-3 align-middle\">The wax is redistributed and the sheen comes back.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Heavy dirt<br><span class=\"small text-muted font-weight-normal\">Light yellows</span></td><td class=\"py-3 px-3 align-middle\">Replace with a fresh pair.</td><td class=\"py-3 px-3 align-middle\">A clean, fresh yellow again.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you remove dust and dirt from light yellow laces without losing wax?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"5e68950c-166a-47fd-8a44-e21bbe9187a5","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","m