[{"name":"Image","type":"content","meta":{"uuid":"73a180f5-f7ab-4037-a8ab-84d5d3b65c44","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Startseite/black-and-white/immer-die-passenden-senkel-venezia-II-HR.jpg","alt":"To all shoelaces","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/shoelaces"},"text":{"textOverlay":"<h2>To all shoelaces</h2>","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"aa0a0af4-f2c6-4a70-9fe5-01afc3b6c3a0","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h1 class=\"align-center\">For Beautiful Loops</h1>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"6bbf73f9-7d76-4ef7-b8d6-a462b763d31b","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"009d5196-5a95-478b-91b8-56e2007f01ce","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p class=\"align-justify\">LACCICO® Your shop for waxed shoelaces. We produce round and flat waxed shoelaces in many lengths, diameters, widths and in all fashionable colors. The laces are made of 100% cotton and are produced in Italy, expertly tested in Germany, packaged and also shipped from there. With waxed laces from LACCICO® you get an accessiores, with which you can set accents as needed. In addition, they are also a first-rate replacement for your worn laces.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"5110f236-fb78-439e-ba90-c9f8451bc260","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p class=\"align-justify\">Shoelaces are no longer \"just\" the shoelace with which you close your lace-up shoes. Due to the large selection of variants such as flat or round laces, these in many widths, diameters and colors, almost all imaginable styles can be maintained for different occasions and applications. Let yourself be inspired by the wide variety of our waxed shoe laces. Combine e.g. the color of the laces to the color of cufflinks, pocket squares or the dress of your companion.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]}]