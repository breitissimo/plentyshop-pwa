[{"name":"MultiGrid","type":"structure","meta":{"uuid":"7a2adc68-b0bb-404c-9d2d-46332b57672e","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"95aea905-dfa3-485b-af68-5fd3864d9fe2","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"c8efc460-15bb-4ca7-bb0b-bb4145118cc5","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"60f01e08-725a-470b-86d3-e1c95a79573f","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"a50eaf32-234a-4e2a-ba3a-91e634d94488","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Alongside black and dark brown, muted tones are especially popular on business shoes: navy, wine red and warm browns such as Tabacco or caramel brown.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Formal Oxfords with concealed eyelets suit the 2 mm round lace tone-on-tone. On classic leather shoes, the narrow 3 mm flat lace adds a small surprise that connoisseurs notice.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colour &amp; model guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Shape &amp; size</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black &amp; dark brown<br><span class=\"small text-muted font-weight-normal\">Tone-on-tone</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">2 mm round</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords, plain Derbies and dress shoes with concealed eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bordo (wine red)<br><span class=\"small text-muted font-weight-normal\">Accent with depth of colour</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2 mm round<br>(double-waxed)</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Dark brown leather shoes, shell cordovan and formal evening shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Navy<br><span class=\"small text-muted font-weight-normal\">Discreet business contrast</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">3 mm flat</td><td class=\"py-3 px-3 align-middle\">60, 75, 90, 120 cm</td><td class=\"py-3 px-3 align-middle\">Brown brogues and semi-brogues, with worsted or flannel suits.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Caramel brown &amp; beige<br><span class=\"small text-muted font-weight-normal\">Warm and easy-going</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">4 mm flat</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Suede Derbies, lace-up ankle boots and business casual shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace colours are popular for modern men's business shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"26b6d65d-42f8-4d42-8111-cf35b0d328f1","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed cotton laces have a smooth surface with a subtle sheen that blends harmoniously with the texture of the finest shoe leathers.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The densely braided lace stays shape-retaining and gives a neat lacing pattern. Because the wax reduces friction, the lace glides smoothly through the eyelets and keeps looking good for a long time.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Surface &amp; model guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Shape &amp; size</th><th scope=\"col\" class=\"py-3 px-3\">Surface</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">2 mm round</td><td class=\"py-3 px-3 align-middle\">Waxed, silky matt</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords and Derbies with concealed eyelets.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">2 mm round</td><td class=\"py-3 px-3 align-middle\">Double-waxed, special depth of colour and sheen</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Goodyear-welted shoes in calfskin or shell cordovan.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">3 mm flat</td><td class=\"py-3 px-3 align-middle\">Waxed, very understated</td><td class=\"py-3 px-3 align-middle\">60, 75, 90, 120 cm</td><td class=\"py-3 px-3 align-middle\">Brogues and fine dress shoes with concealed eyelets.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">4 mm flat</td><td class=\"py-3 px-3 align-middle\">Waxed, silky matt</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Derbies and lace-up ankle boots with eyelets and hooks.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why do waxed shoelaces go so well with fine leather footwear?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"842737d6-a65b-4ed1-aa84-51f660b4e1be","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Close a cloth with a little shoe cream firmly around the lace and pull it along firmly. Friction and warmth redistribute the wax and the sheen comes back.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">It is normal for the sheen to fade with moisture and use. Over time a patina develops that suits the worn shoe.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Care guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Method</th><th scope=\"col\" class=\"py-3 px-3\">Suitable for</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">Note</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Cloth with shoe cream<br><span class=\"small text-muted font-weight-normal\">The classic</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td><td class=\"py-3 px-3 align-middle\">Wrap a cloth with a little cream around the lace and pull it along firmly.</td><td class=\"py-3 px-3 align-middle\">Protect your fingers with the cloth or a piece of leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Unthread completely<br><span class=\"small text-muted font-weight-normal\">Now and then</span></td><td class=\"py-3 px-3 align-middle\">All series</td><td class=\"py-3 px-3 align-middle\">Take the lace out and treat it along its whole length.</td><td class=\"py-3 px-3 align-middle\">That way the hidden parts get some too.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Iron<br><span class=\"small text-muted font-weight-normal\">For flat laces</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td><td class=\"py-3 px-3 align-middle\">Run over the lace briefly on a higher heat; the wax is redistributed.</td><td class=\"py-3 px-3 align-middle\">Clean the soleplate thoroughly afterwards.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you restore the silky sheen of waxed shoelaces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a2f5817e-7d07-4e5b-93e1-c338deef358c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The wax fully penetrates the fibre structure of the cotton braid, much like tanning agents penetrate leather. It protects the cotton against moisture and abrasion and makes the lace long-lasting.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The wax also reduces friction, so the lace glides smoothly through the eyelets. The Splendore (SL) stays longer in the wax bath, which is where its special depth of colour comes from.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Finish &amp; model guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Waxing</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Use</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Waxed</td><td class=\"py-3 px-3 align-middle\">Silky matt, weatherproof and long-lasting.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Business shoes with concealed eyelets.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Waxed</td><td class=\"py-3 px-3 align-middle\">Silky matt, weatherproof and long-lasting.</td><td class=\"py-3 px-3 align-middle\">45 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Low shoes and lace-up ankle boots with hooks.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL (Splendore)</a></td><td class=\"py-3 px-3 align-middle\">Double-waxed</td><td class=\"py-3 px-3 align-middle\">Special depth of colour and sheen.</td><td class=\"py-3 px-3 align-middle\">45 – 180 cm</td><td class=\"py-3 px-3 align-middle\">Fine leather shoes and shell cordovan.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Waxed</td><td class=\"py-3 px-3 align-middle\">Subtle sheen, glides easily through the eyelet.</td><td class=\"py-3 px-3 align-middle\">60 – 120 cm</td><td class=\"py-3 px-3 align-middle\">Dress shoes, brogues and lace-up ankle boots.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Waxed</td><td class=\"py-3 px-3 align-middle\">Tear-resistant and weatherproof; XR with a soft yet solid grip from stronger strands.</td><td class=\"py-3 px-3 align-middle\">75 – 150 cm</td><td class=\"py-3 px-3 align-middle\">Sneakers, boots and workwear boots (XR).</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What does high-quality waxing do for cotton shoelaces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"40812f59-ec01-4944-b543-20e00ab272aa","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The wax fills the densely braided cotton. Dirt and moisture therefore do not settle in the fibres as easily as with unwaxed laces.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Even so, a worn lace does not stay completely clean: over time a patina develops that suits the shoe. Soiled light-coloured laces are replaced; if you wear light tones, it is best to keep a supply.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colour &amp; everyday guide&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">In everyday use</th><th scope=\"col\" class=\"py-3 px-3\">Tip</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black, dark brown, navy<br><span class=\"small text-muted font-weight-normal\">Dark tones</span></td><td class=\"py-3 px-3 align-middle\">Signs of use are barely noticeable.</td><td class=\"py-3 px-3 align-middle\">Ideal for daily use at the office.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey, beige, brown<br><span class=\"small text-muted font-weight-normal\">Medium tones</span></td><td class=\"py-3 px-3 align-middle\">The patina looks natural and suits worn leather.</td><td class=\"py-3 px-3 align-middle\">Nice with suede and casual shoes.</td><td class=\"py-3 px-3 align-middle\">All series</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream<br><span class=\"small text-muted font-weight-normal\">Light tones</span></td><td class=\"py-3 px-3 align-middle\">Show dirt soonest.</td><td class=\"py-3 px-3 align-middle\">Keep a supply and replace when needed.</td><td class=\"py-3 px-3 align-middle\">All series</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why are waxed shoelaces particularly dirt-resistant?","defaultOpen":false}}}],"parent_slot":0,"slot_index":2},{"name":"MultiGrid","type":"structure","meta":{"uuid":"5452794c-7ca8-4906-b454-64d231647b0e","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[7,5]},"content":[{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"dcdf7bdc-46e2-460e-985f-60554a368260","isGlobalTemplate":false},"parent_slot":0,"slot_index":null,"content":{"teil":"titel"}},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"7eadf0a4-853d-4c04-a685-8e88d517468c","isGlobalTemplate":false},"parent_slot":0,"slot_index":null,"content":{"teil":"text"}},{"name":"Image","type":"content","meta":{"uuid":"14fd4e35-f19e-40cf-a508-f049a41e05c3","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Farbwelten/Farbwelten-entdecken.jpg","desktop":"https://cdn02.plentyone.com/q