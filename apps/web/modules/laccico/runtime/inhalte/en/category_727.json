[{"name":"MultiGrid","type":"structure","meta":{"uuid":"45a56d5d-2dcd-4b8b-8ba0-72e1993845fe","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"860da76e-1f2c-466d-8286-9be2213aed2c","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"e0dca5bb-6615-48bc-b865-2cdd9b16b7d0","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Round laces are a round cord and look understated. Flat laces are a flat band, lie flat on the tongue and show more of the lace.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With round laces, especially the thicker ones, the braid is formed around a core cord, which creates the volume. A flat lace is a hollow cord that is then rolled flat. Which shape fits is decided by the shoe and its eyelets: the lace should pass easily through the eyelet. The 2 mm round lace and the 3 mm flat lace are made for concealed eyelets, all thicker laces for visible eyelets.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Round &amp; flat&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Barely noticeable, elegant and understated.</td><td class=\"py-3 px-3 align-middle\">Classic Oxfords and Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle\">Narrow and flat, a small accent that connoisseurs notice.</td><td class=\"py-3 px-3 align-middle\">Classic low shoes with fine suit fabrics</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks</td><td class=\"py-3 px-3 align-middle\">Stronger and more present than 2 mm.</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with hooks, boots</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks</td><td class=\"py-3 px-3 align-middle\">Slim, but clearly visible.</td><td class=\"py-3 px-3 align-middle\">Ankle-high lace-up shoes, slim leather sneakers</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Xtra Robust</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 5 mm inner diameter or more</td><td class=\"py-3 px-3 align-middle\">CS fine and refined, XR strong in a vintage look.</td><td class=\"py-3 px-3 align-middle\">Sneakers, boots, comfort shoes</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What is the difference between round laces and flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"358e435e-f2b3-4d25-835c-4e381316807f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>A lace looks timeless when its shape, thickness and colour suit the shoe. The finer the shoe, the finer the lace; the sturdier the shoe, the stronger the lace may be.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On classic smooth-leather low shoes with concealed eyelets, the 2 mm round lace and the 3 mm flat lace are at home. The round lace steps back completely, the narrow flat lace sets a quiet accent. Lace-up ankle boots, boots and sneakers with visible eyelets take stronger laces: 3 mm round, 4 mm or 6 mm flat. Trends play no part in this; what matters is that lace and shoe go together.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Look &amp; shoe&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Look</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Suitable shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Classic and elegant<br><span class=\"small text-muted font-weight-normal\">Smooth leather, concealed eyelets</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Understated, the lace steps back.</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbies, dress shoes</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">For connoisseurs<br><span class=\"small text-muted font-weight-normal\">Quiet accent</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Narrow and flat, only noticed at second glance.</td><td class=\"py-3 px-3 align-middle\">Classic low shoes with suits</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Classic and sporty<br><span class=\"small text-muted font-weight-normal\">Visible eyelets</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Slim, with a silky-matt sheen.</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, leather sneakers</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Strong<br><span class=\"small text-muted font-weight-normal\">Eyelets and hooks</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Round and present.</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with hooks, boots</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sneakers &amp; vintage<br><span class=\"small text-muted font-weight-normal\">Wide lace</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">CS fine and refined, XR strong in a vintage look.</td><td class=\"py-3 px-3 align-middle\">Sneakers, heritage and workwear boots</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace shape gives a timeless look?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c50b8817-826f-4e96-adf9-08f4cbc3b795","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The length could be calculated if you recorded the lacing style, the foot and the thickness of the lace exactly. In practice, though, nobody does that: the easiest and safest way is to measure the old laces unlaced, from tip to tip.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Thicker laces need a little more length than thin ones. For classic footwear, the number of pairs of eyelets serves as a rule of thumb. The further apart the eyelets are, the less it applies, for example on sneakers and boots.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Rule of thumb for classic shoes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th><th scope=\"col\" class=\"py-3 px-3\">Series</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1–2<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">45 cm</td><td class=\"py-3 px-3 align-middle\">Shoes with only one or two pairs of holes</td><td class=\"py-3 px-3 align-middle\">R2, R3</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbies with low-set lacing panels</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Classic Derbies and Oxfords with 5 pairs of holes</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbies and Oxfords for a wider foot, transition to ankle-high shoes</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Classic lace-up ankle boots</td><td class=\"py-3 px-3 align-middle\">R2, R3, F3, F4, F6</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">from 9<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets / boots</span></td><td class=\"py-3 px-3 align-middle\">150–180 cm</td><td class=\"py-3 px-3 align-middle\">Tall lace-up boots, women's boots</td><td class=\"py-3 px-3 align-middle\">R2 (up to 180 cm), R3, F6 (up to 150 cm)</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you work out the right shoelace length from the pairs of eyelets?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f9f14ebc-209a-44eb-9581-027475f18836","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The lace should pass easily through the eyelet, otherwise its surface is put under heavy strain when it is pulled through.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With concealed eyelets (blind eyelets) you only see a small hole in the leather from above, with a fine eyelet underneath. The 2 mm round lace and the 3 mm flat lace are made for these. All thicker laces are for visible eyelets. If a lace wears through early, it is usually due to burrs in the eyelet; in that case, deburr the eyelet once.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; thickness&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Eyelet</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Good to know</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Concealed eyelet<br><span class=\"small text-muted font-weight-normal\">Blind eyelet</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">R2: 45–180 cm<br>F3: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">From above you only see a small hole in the leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelet<br><span class=\"small text-muted font-weight-normal\">Visible ring</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">R3: 45–150 cm<br>F4: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">For lace-up ankle boots and leather sneakers.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">On ankle-high shoes</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">R3: 45–150 cm<br>F4: 60–120 cm</td><td class=\"py-3 px-3 align-middle\">After crossing, lay the lace into the hook under tension instead of pulling it through.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelet, 5 mm inner diameter or more<br><span class=\"small text-muted font-weight-normal\">Sneakers, boots</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">F6: 75–150 cm</td><td class=\"py-3 px-3 align-middle\">For example on court sneakers and boots.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace thickness suits which eyelet?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"10397e09-570a-4adb-846d-4bf837b9befa","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed cotton laces suit leather: a subtle sheen, a high-quality feel, and they are tear-resistant and long-lasting.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The wax penetrates the fibre structure of the cotton braid, much like tanning agents penetrate leather. Hot-rolled and polished, the lace gets its subtle sheen and looks like a fine leather band. It is water-repellent, keeps its shape even when wet and hardly stretches. When wet, the bow does not come undone as easily.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Waxed cotton&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">Waxed cotton</th><th scope=\"col\" class=\"py-3 px-3\">Where it comes from</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Look<br><span class=\"small text-muted font-weight-normal\">Sheen</span></td><td class=\"py-3 px-3 align-middle\">Subtle sheen that goes well with fine shoe leather.</td><td class=\"py-3 px-3 align-middle\">Waxed, hot-rolled and polished.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Feel<br><span class=\"small text-muted font-weight-normal\">In the hand</span></td><td class=\"py-3 px-3 align-middle\">Grippy and high-quality. A little stiff at first, more supple over time.</td><td class=\"py-3 px-3 align-middle\">Wax in the braid.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wet weather<br><span class=\"small text-muted font-weight-normal\">Rain</span></td><td class=\"py-3 px-3 align-middle\">Water-repellent, keeps its shape even when wet.</td><td class=\"py-3 px-3 align-middle\">Wax and dense braiding.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Durability<br><span class=\"small text-muted font-weight-normal\">Everyday use</span></td><td class=\"py-3 px-3 align-middle\">Tear-resistant, hardly stretches.</td><td class=\"py-3 px-3 align-middle\">Tight braiding of 100 % cotton.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bow<br><span class=\"small text-muted font-weight-normal\">On the go</span></td><td class=\"py-3 px-3 align-middle\">It holds when tied correctly. If it comes undone, it was usually a granny knot: tie the starting knot the other way round once.</td><td class=\"py-3 px-3 align-middle\">The tying technique, not the lace.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What are the advantages of waxed shoelaces made of 100 % cotton?","defaultOpen":false}}}],"parent_slot":0},{"name":"MultiGrid","type":"structure","meta":{"uuid":"3856808c-4403-4ec8-bff0-9596e90c4d19","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"a9d60f28-571f-4c22-a169-2b6cded8c230","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"f4fbee19-dc27-47bb-b6f7-454b98deee4c","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Form_Durchmesser/Bannerbild-Form-und-Durchmesser.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":""},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"