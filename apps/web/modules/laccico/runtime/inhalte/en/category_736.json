[{"name":"MultiGrid","type":"structure","meta":{"uuid":"263c6c82-3b9a-4a38-9a40-812b9588e47c","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"6a38ce1d-f2b6-47e1-8449-f5a5c9775343","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"3b6124e6-8506-4542-be8d-ebaeb18f3cfa","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"7962ed9e-20d7-4acc-8b56-f147e6b94263","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"3a9b9952-7149-4767-b589-0e33ec693838","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F3-CS is our finest flat lace: 3 mm wide, made of 100 % cotton, waxed, hot-rolled and polished. It is made for classic low shoes with concealed eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">A flat lace is a hollow cord that is rolled flat. With the F3, this creates a narrow lace with a subtle sheen that looks calm on fine smooth leather. Where the 2 mm round lace steps back completely, the narrow flat lace adds a small surprise that connoisseurs will notice. The F3-CS comes in around 30 colours and in 60, 75, 90 and 120 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F3-CS at a glance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F3-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">Flat</span></td><td class=\"py-3 px-3 align-middle\">3 mm, our finest flat lace.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Braid</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, tightly braided.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Finish<br><span class=\"small text-muted font-weight-normal\">Wax</span></td><td class=\"py-3 px-3 align-middle\">Waxed, hot-rolled and polished.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Eyelets<br><span class=\"small text-muted font-weight-normal\">Use</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets of classic low shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">60, 75, 90 and 120 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Colours<br><span class=\"small text-muted font-weight-normal\">Choice</span></td><td class=\"py-3 px-3 align-middle\">Around 30 colours, from white to black.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Production</span></td><td class=\"py-3 px-3 align-middle\">Made in the EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">For comparison<br><span class=\"small text-muted font-weight-normal\">Other series</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What makes the waxed 3 mm flat lace F3-CS special?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"9a06888c-7714-46f3-bc59-166aeffa162b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>That depends on the eyelets. For concealed eyelets, as on Oxfords and many classic Derbies, the 3 mm flat lace (F3-CS) fits. For Derbies with visible visible eyelets, the 4 mm flat lace (F4-CS) is the right choice.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">You can recognise concealed eyelets by the fact that from the outside you only see a small hole in the leather. Visible eyelets have a metal ring on the outside. If you prefer an even more understated look, choose the 2 mm round lace: it steps back completely, while the narrow flat lace sets a quiet accent.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Business shoes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxford<br><span class=\"small text-muted font-weight-normal\">Closed lacing</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F3-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wholecut<br><span class=\"small text-muted font-weight-normal\">Made from one piece</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F3-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Classic</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F3-CS</span> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Smart casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Eyelets below, hooks above.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace width is right for modern business shoes and Derbies?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"12fa3aec-54ad-4923-83e2-89382fb73b80","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Classic Goodyear-welted low shoes with concealed eyelets call for fine laces: the 3 mm flat lace or the 2 mm round lace. Choose the colour tone-on-tone with the leather or to match the stitching.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Not every welted shoe needs a fine lace. Country Derbies, lace-up ankle boots and boots with visible eyelets take stronger laces. If the shoe has contrasting light stitching, a lace in the colour of the stitching can pick up this handcrafted detail.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Leather &amp; lace colour&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Leather</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">F3-CS Black</td><td class=\"py-3 px-3 align-middle\">Tone-on-tone, classic and calm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark brown<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">F3-CS Black-brown, Dark brown</td><td class=\"py-3 px-3 align-middle\">Tone-on-tone, understated.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Cognac &amp; mid brown<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">F3-CS Cognac, Mid brown, Light brown</td><td class=\"py-3 px-3 align-middle\">Matches the warm tone of the leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown with light stitching<br><span class=\"small text-muted font-weight-normal\">Decorative stitching</span></td><td class=\"py-3 px-3 align-middle\">F3-CS Beige, Light beige, Taupe</td><td class=\"py-3 px-3 align-middle\">Picks up the colour of the stitching.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Even more understated<br><span class=\"small text-muted font-weight-normal\">Round laces 2 mm</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Steps back completely, for the same concealed eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelets<br><span class=\"small text-muted font-weight-normal\">Country Derbies, boots</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Stronger laces for a sturdier build.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which type of shoelace suits Goodyear-welted leather shoes with decorative stitching?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a7d905a0-3ca2-4f5c-9180-ab6ec0eea862","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. For classic low shoes, the number of pairs of eyelets is a good rule of thumb, for example 75 cm for 4 to 5 pairs of eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The F3-CS comes in 60, 75, 90 and 120 cm. The right length also depends on the lacing style and on the foot. For women's sizes, one size shorter is often enough.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbies with short lacing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Classic Oxfords and Derbies.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Classics for a wider foot, transition to ankle-high shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots.</td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What length do I need for 3 mm flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"06c36804-8203-4723-9fe6-a6e6847dacc8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>On Oxfords with concealed eyelets, straight lacing (bar lacing) is the classic. You only see horizontal bars, the rest of the lace runs under the quarters. With the 3 mm flat lace, the bars look narrow and calm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On Derbies and Brogues, criss-cross lacing is common; that is a matter of taste. To keep the flat lace lying flat, guide it through the eyelet with one hand and let the loose end slide over a finger of the other hand under light tension. Only pull once the lace lies flat.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lacing styles&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lacing</th><th scope=\"col\" class=\"py-3 px-3\">On the shoe</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Straight lacing<br><span class=\"small text-muted font-weight-normal\">Bar lacing</span></td><td class=\"py-3 px-3 align-middle\">Horizontal bars, no visible crossings.</td><td class=\"py-3 px-3 align-middle\">Oxfords, wholecuts.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Criss-cross lacing<br><span class=\"small text-muted font-weight-normal\">Classic</span></td><td class=\"py-3 px-3 align-middle\">Diagonal crossings over the tongue.</td><td class=\"py-3 px-3 align-middle\">Derbies, Brogues, lace-up ankle boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Our frequently asked questions</a></td><td class=\"py-3 px-3 align-middle\">More questions about shoelaces and shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which lacing looks cleanest and flattest on Goodyear-welted shoes?","defaultOpen":false}}}],"parent_slot":0,"slot_index":2},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"23363e4b-a54b-40c2-bda1-25761d1dcd27","isGlobalTemplate":false},"parent_slot":1,"slot_index":0,"content":{"teil":"titel"}},{"name":"SortFilter","type":"content","meta":{"uuid":"d2a80be8-45e7-4c5b-8335-5868bf25eb73","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"0114e5cc-4182-4404-bd26-15a011554c92","isGlobalTemplate":false},"parent_slot":1,"slot_in