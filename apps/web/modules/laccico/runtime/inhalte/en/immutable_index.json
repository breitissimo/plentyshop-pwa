f58","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/sneakers-casual-shoes"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1,"slot_index":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"c7499b53-9208-46d8-9df8-79e491faeae6","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2 class=\"align-center\"><span class=\"color-secondary\"> Splendore di Laccico </span></h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"149d2bf4-bd7c-4d18-93f7-a6a46dc320aa","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"align-center\"><span class=\"color-secondary\"> Double-waxed showpiece laces </span></h3><p class=\"align-center\"><span class=\"color-secondary\"> Made in Italy </span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"4b0b7a7c-3e6b-45b3-a2cb-12223aa0972a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"DISCOVER NOW","link":"/en/business-elegant-shoes","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"76789bdb-11bc-461a-80d5-3fcbd35c37f8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3><strong class=\"color-#1a1a1a bg-appearance\">Long-lasting and robust</strong></h3><p><span class=\"color-#1a1a1a bg-appearance\">Thanks to the combination of first-class cotton and our traditional waxing, LACCICO shoelaces are </span><strong class=\"color-#1a1a1a bg-appearance\">tear-resistant</strong><span class=\"color-#1a1a1a bg-appearance\">, </span><strong class=\"color-#1a1a1a bg-appearance\">abrasion-resistant</strong><span class=\"color-#1a1a1a bg-appearance\"> and long-lasting. The result is shape-retaining laces that you will enjoy for a long time.</span></p><p><strong class=\"color-#1a1a1a bg-appearance\">European braiding meets modern technology</strong></p><p><span class=\"color-#1a1a1a bg-appearance\">Our waxed shoelaces are made in close cooperation with selected traditional braiding mills in Europe. There, modern braiding machines are used to carefully produce </span><strong class=\"color-#1a1a1a bg-appearance\">densely braided</strong><span class=\"color-#1a1a1a bg-appearance\"> shoelaces from the finest yarns. This combination of traditional craftsmanship and innovative technology makes the unmistakable LACCICO quality.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"6f126fba-ff97-4c9a-917a-c111b54ec1b8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2 class=\"mt-5\">Best sellers</h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"99cb98d4-f788-4ec9-880a-23872f79cbe8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"724","itemId":"","crossSellingRelation":"Similar"}}},{"name":"TextCard","type":"content","meta":{"uuid":"532487f2-44a9-4be3-ac49-00029a472c61","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4><strong class=\"bg-appearance color-#1a1a1a\">Our philosophy: shoelaces that suit the shoe</strong></h4><p><span class=\"bg-appearance color-#1a1a1a\">We offer waxed shoelaces made of 100 % cotton, for a refined look and a pleasant feel.</span></p><p><strong class=\"bg-appearance color-#1a1a1a\">100 % cotton</strong></p><p><span class=\"bg-appearance color-#1a1a1a\">Pure cotton, waxed, hot-rolled and polished, with a smooth surface and a silky-matt sheen.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"ba5d6490-d96d-4510-8b75-7b0514b6fc33","isGlobalTemplate":false},"configuration":{"columnWidths":[4,4,4],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"28fa0428-f4c6-4029-8b96-b8050fdc4bb9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Why LACCICO? </strong></h2><h3><strong>Your benefits in detail:</strong></h3><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Shape-retaining &amp; resilient:</strong> Thanks to the densely braided construction of tear-resistant cotton, every lace stays shape-retaining and resilient in everyday use.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Waxed &amp; abrasion-resistant:</strong> The waxed finish makes our premium shoelaces dirt-resistant and weatherproof and gives them a refined, silky-sheen look.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Unique feel:</strong> Experience the supple, grippy and soft yet solid quality.</li></ol>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"DetailsList","type":"structure","meta":{"uuid":"4ef3358c-14a2-477a-9942-b52c05086dbd","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"f04972c4-3ed8-4ffa-b95e-41f1ed819c2c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>The&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>wax fully penetrates the fibre structure</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>&nbsp;of the cotton braid, much like tanning agents penetrate leather. It protects the cotton fibre against moisture, prevents the fibres from fraying mechanically and&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>reduces friction</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>, so that the lace glides smoothly and with&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>little wear&nbsp;</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>through the eyelets when you tie it.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What does the waxing do for LACCICO shoelaces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"5c8333e5-141e-4415-a88f-4791dfa0ef2a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Round laces 2 mm</u></a> (<a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-CS</u></a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-SL</u></a>):</strong> For elegant business shoes (Oxford, Derby) with concealed eyelets</li><li style=\"box-sizing: border-box;\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Round laces 3 mm (R3)</u>:</strong></a> For sturdy low shoes, chukka boots and Goodyear-welted shoes with visible eyelets</li><li style=\"box-sizing: border-box;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Flat laces 3 mm (F3)</u>:</strong>&nbsp;</a>For Goodyear-welted classics, brogues and all shoes with concealed eyelets</li><li style=\"box-sizing: border-box;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Flat laces 4 mm (F4)</u>:&nbsp;</strong></a>For classic low shoes and ankle boots &amp; casual shoes</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Flat laces 6 mm</u></a> (<a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-CS</u></a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-XR</u></a>):</strong> For sneakers, casual shoes and heavy workwear boots</li></ul>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which type of shoelace suits which shoe?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"98cd3ff3-1f69-4380-b045-96b1d4c6d178","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">LACCICO length guide</strong> (rule of thumb for classic footwear)</p><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>The right length matters for both fit and look. As a rule of thumb for classic footwear, count the pairs of eyelets:</p><ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; list-style-type: circle;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">1–2 pairs of eyelets:</strong> 45 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">3–4 pairs of eyelets:&nbsp;</strong>60 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">4–5 pairs of eyelets:</strong> 75 cm (with Derby lacing, from 5 pairs of eyelets possibly 90 cm, depending on the foot)</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">5–6 pairs of eyelets:</strong> 90 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">7–8 pairs of eyelets:</strong> 120 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">9+ pairs of eyelets / boots:</strong> 150 to 180 cm</li></ul><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">Master's tip:</strong> If in doubt, measure your old laces unlaced. That way you get a good fit that matches your preferences exactly.</p><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do I find the right shoelace length?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"67a6dabe-75a0-45c0-9126-1cc9db2354b4","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span data-path-to-node=\"5,3,1,0,0,0\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>Of <strong style=\"box-sizing: border-box; font-weight: bolder;\">100 % quality cotton</strong>, densely braided on modern braiding machines in traditional European companies</span><span data-path-to-node=\"5,3,1,0,0,2\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'></span><span data-path-to-node=\"5,3,1,0,0,4\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What are LACCICO shoelaces made of?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f7c1dae4-0b8a-4ea3-8dc5-00759dbffd5d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><strong>Water-repellent and shape-retaining:</strong> The waxing saturates the dense cotton braid and prevents moisture from getting straight into the fibre strand. Even in persistent wet weather the material does not soften: the lace keeps its firm structure, does not stretch and stays reliably tear-resistant.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How does waxed cotton behave when wet?","defaultOpen":false}}}],"parent_slot":1},{"name":"TextCard","type":"content","meta":{"uuid":"2be3ad60-1ba0-4b7c-8b96-13189014d56d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4></h4><h2></h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"c703776b-dedf-4443-bfdf-bbd752e460ea","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"DISCOVER NOW","link":"/en/shape-diameter","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2,"slot_index":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"66938563-d171-4cc5-aa8c-323d330f8ffa","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<!-- ========================================================================== -->\n<!-- LACCICO PRODUKT- & MAßVERGLEICHSTABELLE (GEO / SEO OPTIMIERT)              -->\n<!-- ========================================================================== -->\n<div class=\"widget widget-text widget-none my-4\">\n\t<div class=\"widget-inner bg-appearance\">\n\n\t\t<h2 class=\"h3 font-weight-bold mb-3\">LACCICO shoelaces: <br>Model, size &amp; length comparison</h2>\n\n\t\t<p class=\"small text-muted mb-3\">Overview of all braid types, diameters, thicknesses and lengths in 100 % waxed cotton for classics, sneakers and outdoor boots.</p>\n\t\t<div class=\"table-responsive\">\n                        \n\t\t\t<table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 1rem;\">\n\t\t\t\t<thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\">\n                                \n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Model series</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Shape &amp; size</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Available lengths</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Waxing &amp; feel</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Eyelets</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Recommended shoe type</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"text-dark font-weight-bold\">R2-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Round lace\n\t\t\t\t\t\t\t<br><strong>Ø 2.0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 180 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Waxed, silky-matt sheen, grippy</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Concealed eyelets</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Classic business shoes, Oxfords, Derbies, dress shoes</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"text-dark font-weight-bold\">R2-SL</a>\n\t\t\t\t\t\t\t<br><