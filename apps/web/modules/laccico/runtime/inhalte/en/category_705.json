[{"name":"MultiGrid","type":"structure","meta":{"uuid":"2ae4b5e6-c3bc-4c31-9a34-06fe090070bd","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"a8515692-611a-467c-9360-54d47249a4b5","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"dfea5a1d-7a96-4726-85d4-fdd807ab1045","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"3615f627-41c5-4090-8743-434b0633d72f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-CS is a 6 mm wide waxed flat lace made of 100 % cotton. Its fine, flat braid pattern is unobtrusive and looks refined, even in strong colours.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Waxed, hot-rolled and polished, it has a silky-matt sheen. The wax penetrates the braid and protects the fibre. If you are looking for a stronger, rustic lace, choose the F6-XR: it has more volume because more yarn is braided into it.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-CS at a glance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">6 mm, flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Fibre</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, waxed.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braid pattern<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Fine and unobtrusive.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sheen<br><span class=\"small text-muted font-weight-normal\">Waxing</span></td><td class=\"py-3 px-3 align-middle\">Hot-rolled and polished, silky matt.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">75, 90, 120 and 150 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Production</span></td><td class=\"py-3 px-3 align-middle\">Made in the EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Stronger<br><span class=\"small text-muted font-weight-normal\">Sister series</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What makes the Classic Sportive series (F6-CS) special among 6 mm flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"8fcfb4b7-660b-401e-9cd0-0f201d4248c2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-CS suits shoes with visible eyelets of 5 mm inner diameter or more: high-quality leather sneakers, court sneakers, high-top sneakers, comfort shoes and boots.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On leather sneakers it replaces the simple factory laces with a lace that has a subtle sheen and a high-quality feel. In shorter lengths it also suits Derbies with two pairs of holes and visible eyelets.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Leather sneakers<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Court sneakers<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">High-top sneakers<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Comfort shoes<br><span class=\"small text-muted font-weight-normal\">Everyday</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Two pairs of holes</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\"><span class=\"font-weight-bold text-dark\">F6-CS</span></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear style</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, often with hooks.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Leather sneakers<br><span class=\"small text-muted font-weight-normal\">Slim leather sneakers</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 4 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which sneakers and shoes is the 6 mm F6-CS series ideal for?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"8959f27b-2723-4269-a1b8-15746b4bd668","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-CS comes in 50 colours, from white to black, and in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Alongside classics such as black, dark brown and navy, there are quiet tones such as greige, light taupe or dusty pink and strong ones such as traffic yellow, fuchsia or turquoise. Because the fine braid pattern is unobtrusive, the lace does not look loud even in strong colours. Olive green is only available in 75 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS colours</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Black</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream<br><span class=\"small text-muted font-weight-normal\">3 colours</span></td><td class=\"py-3 px-3 align-middle\">White, light beige, greige</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey<br><span class=\"small text-muted font-weight-normal\">7 colours</span></td><td class=\"py-3 px-3 align-middle\">Light grey, pebble grey, greige, ash grey, mid grey, grey, slate grey</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown &amp; beige<br><span class=\"small text-muted font-weight-normal\">14 colours</span></td><td class=\"py-3 px-3 align-middle\">Light beige, beige, greige, dark beige, light taupe, taupe, light brown, caramel brown, cognac, nut brown, mid brown, brown, mahogany brown, dark brown</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Yellow<br><span class=\"small text-muted font-weight-normal\">4 colours</span></td><td class=\"py-3 px-3 align-middle\">Citrus yellow, yellow, traffic yellow, mustard yellow</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Orange<br><span class=\"small text-muted font-weight-normal\">1 colour</span></td><td class=\"py-3 px-3 align-middle\">Orange</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Red &amp; pink<br><span class=\"small text-muted font-weight-normal\">12 colours</span></td><td class=\"py-3 px-3 align-middle\">Pink, dusty pink, hot pink, fuchsia, magenta, red, ruby red, rust red, wine red, dark wine red, aubergine, purple</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Green<br><span class=\"small text-muted font-weight-normal\">6 colours</span></td><td class=\"py-3 px-3 align-middle\">Mint green, green, khaki green, olive green (75 cm only), military green, dark green</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blue<br><span class=\"small text-muted font-weight-normal\">6 colours</span></td><td class=\"py-3 px-3 align-middle\">Light blue, turquoise, blue, royal blue, navy, purple</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which colours does the waxed 6 mm flat lace F6-CS come in?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"aaa5d990-0a6f-4009-ab2a-211cd99c611d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>From time to time, close a cloth with a little shoe cream firmly around the lace and pull it along firmly. Friction and warmth redistribute the wax.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Protect your fingers with a cloth or a piece of leather while doing so. Now and then, unthread the lace completely so that the hidden parts are cared for too. For flat laces, briefly smoothing them with an iron also helps, on a higher heat as for a T-shirt or jeans: the wax is redistributed and the lace lies smooth again. Afterwards, clean wax residue thoroughly off the soleplate before ironing light-coloured laundry again. This works many times, but not for ever. Washing machines and bleach are not meant for waxed laces. Light-coloured laces on white sneakers are replaced when they are heavily soiled; if you wear light-coloured laces, it is best to keep a supply.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Care&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Situation</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Become dull<br><span class=\"small text-muted font-weight-normal\">Refresh the sheen</span></td><td class=\"py-3 px-3 align-middle\">Close a cloth with a little shoe cream firmly around the lace and pull it along firmly.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Smoothing<br><span class=\"small text-muted font-weight-normal\">Iron</span></td><td class=\"py-3 px-3 align-middle\">Iron briefly, on a higher heat as for jeans. Afterwards, clean wax residue off the soleplate.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hidden parts<br><span class=\"small text-muted font-weight-normal\">Now and then</span></td><td class=\"py-3 px-3 align-middle\">Unthread the lace completely and care for it along its whole length.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Light dust<br><span class=\"small text-muted font-weight-normal\">Light colours</span></td><td class=\"py-3 px-3 align-middle\">Remove with a soft cotton cloth: close the cloth firmly around the lace and pull it through.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Heavily soiled<br><span class=\"small text-muted font-weight-normal\">Light colours</span></td><td class=\"py-3 px-3 align-middle\">Replace. Washing machines and bleach are not meant for them.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you care for waxed 6 mm F6-CS flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"464eee10-4b02-4e79-b075-b8ed1cef68d8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. The F6-CS comes in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The length needed depends on the lacing style and the foot, and on sneakers and boots the eyelets are far apart. That is why a rule of thumb based on pairs of eyelets helps little here.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">75 cm<br><span class=\"small text-muted font-weight-normal\">Short</span></td><td class=\"py-3 px-3 align-middle\">Casual shoes, comfort shoes, Derbies with two pairs of holes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Medium</span></td><td class=\"py-3 px-3 align-middle\">Low-top sneakers, comfort shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Long</span></td><td class=\"py-3 px-3 align-middle\">Sneakers, ankle-high boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Very long</span></td><td class=\"py-3 px-3 align-middle\">High-top sneakers, tall boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Our frequently asked questions</a></td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"