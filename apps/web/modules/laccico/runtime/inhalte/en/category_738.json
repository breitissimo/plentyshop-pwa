[{"name":"MultiGrid","type":"structure","meta":{"uuid":"d1bedb08-86f0-40ec-aa1d-1a33a66e594e","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"a68e72c5-a507-4ae6-8953-51f63c4446c2","isGlobalTemplate":false},"parent_slot":0,"slot_index":0,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"e9a557b2-ba15-47a6-868e-8b53ffb10f5d","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"bd442aa3-a0d5-4e83-bd9e-24f4a2030d36","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>You choose the 6 mm flat lace for shoes with visible eyelets of 5 mm inner diameter or more, especially sneakers and boots. For eyelets under 5 mm inner diameter, a narrower lace is the better choice.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The eyelet is what counts: the smaller its inner diameter and the wider the lace, the more easily it twists. The more easily it glides through the eyelet, the easier it is to keep flat. The F6-CS is the finer of the two and suits high-quality sneakers and comfort shoes; the F6-XR, with its strong braid pattern, suits boots in vintage and workwear style.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Width &amp; eyelets&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelets, 5 mm inner diameter or more<br><span class=\"small text-muted font-weight-normal\">6 mm</span></td><td class=\"py-3 px-3 align-middle\">Sneakers, boots, comfort shoes.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelets, 4 mm inner diameter or more<br><span class=\"small text-muted font-weight-normal\">4 mm</span></td><td class=\"py-3 px-3 align-middle\">Slim leather sneakers, Derbies, chukkas.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Concealed eyelets<br><span class=\"small text-muted font-weight-normal\">3 mm</span></td><td class=\"py-3 px-3 align-middle\">Oxfords, classic Derbies.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"When do you choose 6 mm wide flat laces (F6-CS / F6-XR)?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"80553322-b888-4777-997e-8c8952712607","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Both are 6 mm wide, made of 100 % cotton and waxed. The F6-XR is higher and heavier; it has more volume because more yarn is braided into it. The F6-CS is flatter and has a finer braid pattern.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The F6-CS looks refined, even in strong colours, because its braid pattern is unobtrusive. The F6-XR has strong strands and a soft yet solid grip that comes from the strands, not from the wax. It looks rustic. Which one fits is mainly a question of style.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-CS &amp; F6-XR&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Braid pattern<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Fine and unobtrusive.</td><td class=\"py-3 px-3 align-middle\">Strong strands.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Height<br><span class=\"small text-muted font-weight-normal\">In cross-section</span></td><td class=\"py-3 px-3 align-middle\">Flatter.</td><td class=\"py-3 px-3 align-middle\">Higher and heavier.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grip<br><span class=\"small text-muted font-weight-normal\">In the hand</span></td><td class=\"py-3 px-3 align-middle\">Flat and supple.</td><td class=\"py-3 px-3 align-middle\">Soft yet solid.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Effect<br><span class=\"small text-muted font-weight-normal\">Style</span></td><td class=\"py-3 px-3 align-middle\">Refined, for the city.</td><td class=\"py-3 px-3 align-middle\">Rustic, vintage look.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Shoes<br><span class=\"small text-muted font-weight-normal\">Use</span></td><td class=\"py-3 px-3 align-middle\">High-quality sneakers, comfort shoes, boots.</td><td class=\"py-3 px-3 align-middle\">Boots, workwear, sneakers in vintage style.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">Page</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What is the difference between the F6-CS series and the F6-XR (Xtra Robust) series?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"b00d54c0-7be8-4daf-9037-1a973dc2eefd","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>6 mm flat laces suit shoes with visible eyelets: court sneakers, high-top sneakers, moc-toe boots, heritage and workwear boots, and comfort shoes.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">In shorter lengths, the F6-CS also suits Derbies with two pairs of holes and visible eyelets. On high-quality leather sneakers it replaces the simple factory laces with a lace that has a subtle sheen and a high-quality feel. On high-top sneakers in workwear style, the F6-CS looks just as good as the F6-XR.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes &amp; series&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Court sneakers<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Comfort shoes<br><span class=\"small text-muted font-weight-normal\">Everyday</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Two pairs of holes</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">High-top sneakers<br><span class=\"small text-muted font-weight-normal\">Workwear style</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Moc-toe boots<br><span class=\"small text-muted font-weight-normal\">Heritage</span></td><td class=\"py-3 px-3 align-middle\">Eyelets, often with hooks.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Workwear boots<br><span class=\"small text-muted font-weight-normal\">Robust</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, hooks.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which types of shoe go best with 6 mm wide flat laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"5c3e1810-d289-443a-9c3b-0d217fa71634","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The F6-CS comes in 50 colours, from white to black, the F6-XR in 11 colours. Both come in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With the F6-CS, the choice ranges from quiet tones such as greige, light taupe or dusty pink to strong ones such as traffic yellow, fuchsia or turquoise. The F6-XR has a smaller choice: black, anthracite, beige and three shades of brown, plus white, traffic yellow, wine red, green and blue. F6-CS olive green is only available in 75 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Colour world</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS (50 colours)</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR (11 colours)</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black</td><td class=\"py-3 px-3 align-middle\">Black</td><td class=\"py-3 px-3 align-middle\">Black</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White &amp; cream</td><td class=\"py-3 px-3 align-middle\">White, light beige, greige</td><td class=\"py-3 px-3 align-middle\">White</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey</td><td class=\"py-3 px-3 align-middle\">Light grey, pebble grey, greige, ash grey, mid grey, grey, slate grey</td><td class=\"py-3 px-3 align-middle\">Anthracite</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown &amp; beige</td><td class=\"py-3 px-3 align-middle\">Light beige, beige, greige, dark beige, light taupe, taupe, light brown, caramel brown, cognac, nut brown, mid brown, brown, mahogany brown, dark brown</td><td class=\"py-3 px-3 align-middle\">Beige, light brown, caramel brown, dark brown</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Yellow</td><td class=\"py-3 px-3 align-middle\">Citrus yellow, yellow, traffic yellow, mustard yellow</td><td class=\"py-3 px-3 align-middle\">Traffic yellow</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Orange</td><td class=\"py-3 px-3 align-middle\">Orange</td><td class=\"py-3 px-3 align-middle\">–</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Red &amp; pink</td><td class=\"py-3 px-3 align-middle\">Pink, dusty pink, hot pink, fuchsia, magenta, red, ruby red, rust red, wine red, dark wine red, aubergine, purple</td><td class=\"py-3 px-3 align-middle\">Wine red</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Green</td><td class=\"py-3 px-3 align-middle\">Mint green, green, khaki green, olive green (75 cm only), military green, dark green</td><td class=\"py-3 px-3 align-middle\">Green</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Blue</td><td class=\"py-3 px-3 align-middle\">Light blue, turquoise, blue, royal blue, navy, purple</td><td class=\"py-3 px-3 align-middle\">Blue</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which colours do 6 mm flat laces come in?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3873a64b-e205-453b-bd97-733ff8e2e444","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. The F6-CS and the F6-XR come in 75, 90, 120 and 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On sneakers and boots the eyelets are far apart, so a rule of thumb based on pairs of eyelets hardly helps here. The lacing style and the foot also change the length needed. Shorter lengths suit comfort shoes and Derbies with few eyelets, 120 and 150 cm mainly sneakers and boots.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">75 cm<br><span class=\"small text-muted font-weight-normal\">Short</span></td><td class=\"py-3 px-3 align-middle\">Comfort shoes, Derbies with two pairs of holes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Medium</span></td><td class=\"py-3 px-3 align-middle\">Low-top sneakers, comfort shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Long</span></td><td class=\"py-3 px-3 align-middle\">Sneakers, ankle-high boots.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Very long</span></td><td class=\"py-3 px-3 align-middle\">High-top sneakers, tall boots.</td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What shoelace length do you need for 6 mm flat laces on sneakers and boots?","defaultOpen":false}}}],"parent_slot":0,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"40f4fd96-2854-4a1d-b0a3-4bdefc74b1cd","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"SortFilter","type":"content","meta":{"uuid":"54dd22fd-17fd-497a-950d-b63509a2b5f0","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoLaengenleiste","type":"content","meta":{"uuid":"a620feb7-7dba-41af-89fd-5555d6642797","isGlobalTemplate":false},"parent_slot":1,"slot_index":2,"content":{"anzeigen":true}},{"name":"ItemGrid","type":"content","meta":{"uuid":"fc60179a-0de2-46cf-899c-1746cd0d889d","isGlobalTemplate":false},"parent_slot":1,"slot_index":3,"content":{"itemsPerRowDesktop":4,"itemsPerRowTablet":2,"itemsPerRowMobile":2,"showItemCount":false,"itemCountPosition":"left","fields":{"manufacturer":false,"title":true,"rating":true,"previewText":false,"price":true,"addToCart":true},"fieldsOrder":["manufacturer","title","rating","previewText","price","addToCart"],"fieldsDisabled":["title"],"contentAlignment":"left","cardBorders":false,"showSecondImageOnHover":true,"showWishlistButton":false,"addToCartStyle":"primary","paginationPosition":"both"}},{"name":"CategoryData","type":"content","meta":{"uuid":"9e84dc74-16a7-4c1e-958f-6da6fc5422ff","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":4},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"fdcb80a4-ee6e-4215-84ee-a10c3fdc2448","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":5}]}]