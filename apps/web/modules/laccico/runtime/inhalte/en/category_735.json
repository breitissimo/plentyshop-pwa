[{"name":"MultiGrid","type":"structure","meta":{"uuid":"b82b8b33-6331-4b17-8be9-8e45c7ff1417","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"0e4284c5-69f9-4d85-b2ab-0eca95c17607","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"2e7dc62c-4228-4650-b5d7-c6790115b703","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 3 mm round lace is used on shoes with visible eyelets or hooks. It is stronger than the 2 mm round lace and therefore suits shoes that are themselves a little more sturdily built.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">You can recognise visible eyelets by the metal ring on the outside of the leather. The 2 mm round lace is made for concealed eyelets, where you only see a small hole in the leather from the outside. The 3 mm round lace comes as Classic Sportive (R3-CS) in 39 colours.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> R3-CS at a glance&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">R3-CS Classic Sportive</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Shape<br><span class=\"small text-muted font-weight-normal\">Diameter</span></td><td class=\"py-3 px-3 align-middle\">Round, 3 mm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Material<br><span class=\"small text-muted font-weight-normal\">Braid</span></td><td class=\"py-3 px-3 align-middle\">100 % cotton, densely braided.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Waxing<br><span class=\"small text-muted font-weight-normal\">Finish</span></td><td class=\"py-3 px-3 align-middle\">Waxed, hot-rolled and polished, silky-matt sheen.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Colours<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">39 colours, from white to black.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120 and 150 cm (traffic yellow from 60 cm).</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Production</span></td><td class=\"py-3 px-3 align-middle\">Made in the EU.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Concealed eyelets<br><span class=\"small text-muted font-weight-normal\">For comparison</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"When do you use a 3 mm round lace (R3)?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"2a12763a-5bb1-4d1f-bdfa-e6947cf7a2b5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>3 mm round laces suit lace-up ankle boots with eyelets and hooks best, as well as boots and sturdy Derbies with visible eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Many high-quality lace-up ankle boots have eyelets at the bottom and two to three hooks at the top. The R3 is usually a good choice for them. Goodyear-welted shoes do not always need fine laces either: country Derbies, ankle boots and boots with visible eyelets take the 3 mm round lace. If you prefer a flat lace on hooks, choose the 4 mm flat lace; that is a matter of taste.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoe types&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Eyelets below, often 2–3 hooks above.</td><td class=\"py-3 px-3 align-middle\">Strong enough for the hook, calm in appearance.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark\">R3-CS</span> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Country Derbies<br><span class=\"small text-muted font-weight-normal\">Sturdy sole</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets.</td><td class=\"py-3 px-3 align-middle\">Suits the sturdy build.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, heritage</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks.</td><td class=\"py-3 px-3 align-middle\">A round cord that keeps up.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Leather sneakers<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and loops.</td><td class=\"py-3 px-3 align-middle\">Classic rather than sporty.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Fine Oxfords and Derbies<br><span class=\"small text-muted font-weight-normal\">Concealed eyelets</span></td><td class=\"py-3 px-3 align-middle\">Only a small hole in the leather from the outside.</td><td class=\"py-3 px-3 align-middle\">This is where the 2 mm round lace belongs.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which types of shoe are 3 mm round laces best suited to?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"227050e2-678a-46f7-8ac4-fa0ff481e53b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The lace should pass easily through the eyelet. The 3 mm round lace is made for visible eyelets of 4 mm inner diameter or more and for hooks. Concealed eyelets usually have only 3 mm; there the 2 mm round lace is the better choice.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">If the eyelet is too narrow, the surface of the lace is put under heavy strain when it is pulled through. Eyelets vary from manufacturer to manufacturer. Your previous lace gives a rough guide: if it was round and strong and ran easily through the eyelets, the R3 will fit too.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelet &amp; lace&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Eyelet</th><th scope=\"col\" class=\"py-3 px-3\">Does the R3 fit?</th><th scope=\"col\" class=\"py-3 px-3\">Better suited</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Concealed eyelets<br><span class=\"small text-muted font-weight-normal\">Fine low shoes</span></td><td class=\"py-3 px-3 align-middle\">No, too narrow.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelets, 4 mm inner diameter or more<br><span class=\"small text-muted font-weight-normal\">Low shoes, ankle boots</span></td><td class=\"py-3 px-3 align-middle\">Yes.</td><td class=\"py-3 px-3 align-middle\">R3-CS</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">Ankle boots, boots</span></td><td class=\"py-3 px-3 align-middle\">Yes, lay the lace in.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><span class=\"font-weight-bold text-dark\">R3-CS</span> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Visible eyelets, 5 mm inner diameter or more<br><span class=\"small text-muted font-weight-normal\">Sneakers, boots</span></td><td class=\"py-3 px-3 align-middle\">Yes, but it looks narrow there.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What eyelet diameter do 3 mm round laces need?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"7026380b-7f4a-4518-bd0f-8eceedc4a31e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. For classic footwear, the number of pairs of eyelets is a good rule of thumb, for example 75 cm for 4 to 5 pairs of eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Thicker laces need a little more length than thin ones. On boots the eyelets are far apart, so the rule of thumb hardly applies; the only way is to measure. The R3-CS comes in 45, 60, 75, 90, 120 and 150 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1–2<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">45 cm</td><td class=\"py-3 px-3 align-middle\">Shoes with only one pair of holes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3–4<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">60 cm</td><td class=\"py-3 px-3 align-middle\">Derbies with short lacing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4–5<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Sturdy Derbies with visible eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5–6<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Derbies for a wider foot, transition to ankle-high shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">7–8<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets</span></td><td class=\"py-3 px-3 align-middle\">120 cm</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with eyelets and hooks.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">from 9<br><span class=\"small text-muted font-weight-normal\">pairs of eyelets / boots</span></td><td class=\"py-3 px-3 align-middle\">150 cm</td><td class=\"py-3 px-3 align-middle\">Tall lace-up boots and boots: measure.</td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What shoelace length do I need for 3 mm round laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0842bc00-3164-4afa-9389-084881bc1e6e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The R3-CS is tear-resistant: densely braided cotton whose braid is fully penetrated by the wax. How long it lasts depends mainly on the eyelets, the hooks and the way you lace.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">On hooks, lay the lace in under tension only after crossing, not before, and do not pull it through. Pulling in the wrong direction is the most common cause of wear. New waxed laces are a little stiff at first and become more supple with wear.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Handling&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">Why</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hooks<br><span class=\"small text-muted font-weight-normal\">Ankle boots, boots</span></td><td class=\"py-3 px-3 align-middle\">Lay in under tension after crossing.</td><td class=\"py-3 px-3 align-middle\">Pulling in the wrong direction is the most common cause of wear.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Eyelets<br><span class=\"small text-muted font-weight-normal\">Rough edges</span></td><td class=\"py-3 px-3 align-middle\">Carefully deburr once.</td><td class=\"py-3 px-3 align-middle\">Burrs from old punching tools chafe the lace.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Care<br><span class=\"small text-muted font-weight-normal\">Dull laces</span></td><td class=\"py-3 px-3 align-middle\">Close a cloth with a little shoe cream firmly around the lace and pull it along firmly.</td><td class=\"py-3 px-3 align-middle\">Friction and warmth redistribute the wax.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">New laces<br><span class=\"small text-muted font-weight-normal\">Stiff at first</span></td><td class=\"py-3 px-3 align-middle\">Just wear them.</td><td class=\"py-3 px-3 align-middle\">Good waxed laces become more supple over time.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Learn more<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/laccico-finest-waxed-laces/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Our frequently asked questions</a></td><td class=\"py-3 px-3 align-middle\">More questions about shoelaces and shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How durable are 3 mm round laces and what should you look out for when handling them?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"8bb70205-4021-4b4c-82af-adc7a5d71c4b","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"505175d7-3d39-4eb8-8971-048bb8593cf2","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"ac9e979f-19d0-4af8-8d6c-702c5dad2da5","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ce653cf0-69c4-43e6-a82a-a998097ee1cb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]