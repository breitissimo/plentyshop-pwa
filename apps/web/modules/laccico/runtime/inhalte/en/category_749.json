[{"name":"MultiGrid","type":"structure","meta":{"uuid":"9401795d-c46a-4458-98c8-8c1407aa9659","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true,"columnWidthsTablet":[12,12]},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"6ca68459-f980-4419-8d87-165f40546abb","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":false,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":0,"paddingBottom":12,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"LaccicoKategoriebaum","type":"content","meta":{"uuid":"e1152b0c-2302-4a14-8176-c429d80a37f0","isGlobalTemplate":false},"parent_slot":0,"slot_index":1,"content":{"anzeigen":true}},{"name":"DetailsList","type":"structure","meta":{"uuid":"52530bde-f01e-4c00-9f77-b833c64b79ab","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"c2b37315-c006-454f-900d-0a1ff117c81e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Classic Goodyear-welted low shoes call first and foremost for fine laces: the 2 mm round lace or the narrow 3 mm flat lace. Goodyear-welted lace-up ankle boots, boots and country Derbies with visible eyelets or hooks, on the other hand, often need stronger laces.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Many classic low shoes have concealed eyelets: from above you only see a hole in the leather, with a fine eyelet underneath. The lace should pass easily through the eyelet, otherwise it is put under heavy strain when it is pulled through. That is why, as a craftsman, one cannot give a blanket recommendation for 4 mm flat laces. They fit best in eyelets of 4 mm inner diameter or more; concealed eyelets usually have only 3 mm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Eyelets &amp; lace width&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Browns in the range</th><th scope=\"col\" class=\"py-3 px-3\">Shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">The classic</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">For concealed eyelets.</td><td class=\"py-3 px-3 align-middle\">Light brown, mid brown, dark brown, black-brown, for SL e.g. Cognac, Tabacco, Testa di Moro</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbies, full brogues</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">For connoisseurs</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">For concealed eyelets.</td><td class=\"py-3 px-3 align-middle\">Light brown, mid brown, cognac, nut brown, dark brown</td><td class=\"py-3 px-3 align-middle\">Plain Oxfords, semi-brogues, fine low shoes</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">For eyelets and hooks</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">For visible eyelets and hooks.</td><td class=\"py-3 px-3 align-middle\">Light brown, mid brown, cognac, nut brown, dark brown, black-brown</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots with hooks, country Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm flat<br><span class=\"small text-muted font-weight-normal\">For eyelets of 4 mm inner diameter or more</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">For visible eyelets and hooks. In concealed eyelets it is put under heavy strain.</td><td class=\"py-3 px-3 align-middle\">Beige, cognac, nut brown, dark brown</td><td class=\"py-3 px-3 align-middle\">Country Derbies, lace-up ankle boots with hooks</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelaces belong in Goodyear-welted leather shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"37094dc8-2720-4280-a583-8aae0f8ae44f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed flat laces made of 100 % cotton with the CS finish have a subtle, silky-matt sheen. It suits the smooth leather, suede and canvas that retro sneakers are usually made of.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The fine braid pattern of the 6 mm flat lace F6-CS is unobtrusive and looks refined, even in strong shades of brown. If you prefer something more rustic, choose the F6-XR: it has more yarn and coarser strands and brings the vintage look to boots. Sneakers with many pairs of holes usually need 90 to 120 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Browns on the sneaker&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Sneaker</th><th scope=\"col\" class=\"py-3 px-3\">Lace colour</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White leather<br><span class=\"small text-muted font-weight-normal\">Court sneakers</span></td><td class=\"py-3 px-3 align-middle\">Beige, light beige, greige</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Warm, soft contrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brown suede<br><span class=\"small text-muted font-weight-normal\">Suede, nubuck</span></td><td class=\"py-3 px-3 align-middle\">Light brown, caramel brown, cognac</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Tone-on-tone.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Canvas<br><span class=\"small text-muted font-weight-normal\">Natural, olive, navy</span></td><td class=\"py-3 px-3 align-middle\">Nut brown, dark brown</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Calm, classic accent.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, heritage</span></td><td class=\"py-3 px-3 align-middle\">Beige, light brown, caramel brown, dark brown</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Strong, in a vintage look.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why do waxed flat laces suit retro sneakers so well?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"367eb0de-5425-4c12-bb6e-bc6298d4f05d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>You do not have to replace them right away. Friction and warmth redistribute the wax in the lace and the sheen comes back. This can be repeated many times, but not for ever.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">To do this, hold the lace fairly firmly between your fingers, protected by a soft cotton cloth or a piece of leather, and pull it through firmly several times. If the colour suits, your shoe-cleaning cloth also works very well, as it is usually already moistened with shoe cream. Master's tip: now and then, unthread the lace completely so that the hidden parts are cared for too.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Refreshing dull laces&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Method</th><th scope=\"col\" class=\"py-3 px-3\">Tool</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">When</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Pulling through<br><span class=\"small text-muted font-weight-normal\">Frictional heat</span></td><td class=\"py-3 px-3 align-middle\">Cotton cloth or leather scrap</td><td class=\"py-3 px-3 align-middle\">Hold the lace firmly and pull it along firmly.</td><td class=\"py-3 px-3 align-middle\">When the lace looks matt</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">With shoe cream<br><span class=\"small text-muted font-weight-normal\">Cleaning cloth</span></td><td class=\"py-3 px-3 align-middle\">Cloth with a little shoe cream in a matching colour</td><td class=\"py-3 px-3 align-middle\">Pull through in the same way, ideally while cleaning your shoes.</td><td class=\"py-3 px-3 align-middle\">When cleaning shoes</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Iron<br><span class=\"small text-muted font-weight-normal\">Flat laces only</span></td><td class=\"py-3 px-3 align-middle\">Iron</td><td class=\"py-3 px-3 align-middle\">Briefly iron over the flat lace, then clean the iron.</td><td class=\"py-3 px-3 align-middle\">Occasionally</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What can you do when waxed shoelaces become dull over the years?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"efbf504e-6662-48ef-9b04-663d797eb597","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For cognac, mahogany and nut-brown shoes, if in doubt choose a shade that is a touch darker than the upper leather.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">A slightly darker brown frames the eyelet row and gives a calm overall look. Lighter tones, on the other hand, set a deliberate accent. On suede it can be tone-on-tone.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Leather &amp; browns&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Lace colour</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Cognac, light tan<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">Mid brown, nut brown</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Classic, a shade darker than the shoe.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Nut brown, mahogany<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">Dark brown, black-brown, Testa di Moro</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Calm and timeless.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark brown<br><span class=\"small text-muted font-weight-normal\">Smooth leather</span></td><td class=\"py-3 px-3 align-middle\">Dark brown, Testa di Moro</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Tone-on-tone, with a sheen like fine calfskin.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark brown<br><span class=\"small text-muted font-weight-normal\">Smooth leather or suede</span></td><td class=\"py-3 px-3 align-middle\">Cognac, caramel brown</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Light accent, deliberately set.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Beige suede<br><span class=\"small text-muted font-weight-normal\">Suede, nubuck</span></td><td class=\"py-3 px-3 align-middle\">Beige, light beige, greige</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Relaxed, tone-on-tone.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace colour do you choose for cognac and nut-brown shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"29f6707a-efbf-45bd-8a8c-7587fc55fb34","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Whether a flat lace twists does not depend on the material. It is a question of how you handle it when threading and of matching the lace width to the eyelet size.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Guide the lace through the eyelet with one hand and let the loose end slide over a finger of the other hand under light tension. That way the eyelet acts like a guide rail and the lace stays flat. Once it has been pulled tight while twisted without your noticing, the twist is hard to correct.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Threading flat laces correctly&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">How to do it</th><th scope=\"col\" class=\"py-3 px-3\">Typical mistake</th><th scope=\"col\" class=\"py-3 px-3\">Result</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">1. Threading<br><span class=\"small text-muted font-weight-normal\">Tip first</span></td><td class=\"py-3 px-3 align-middle\">Align the lace flat and guide the tip straight through the eyelet.</td><td class=\"py-3 px-3 align-middle\">Tip pushed into the eyelet at an angle or twisted.</td><td class=\"py-3 px-3 align-middle\">The lace lies flat from the start.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2. Pulling through<br><span class=\"small text-muted font-weight-normal\">Second hand guides</span></td><td class=\"py-3 px-3 align-middle\">Let the loose end slide over a finger under light tension.</td><td class=\"py-3 px-3 align-middle\">Pulled through jerkily and without guidance.</td><td class=\"py-3 px-3 align-middle\">The lace runs flat through the eyelet.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3. Tightening<br><span class=\"small text-muted font-weight-normal\">Check first</span></td><td class=\"py-3 px-3 align-middle\">Before tightening, check that the lace lies flat everywhere.</td><td class=\"py-3 px-3 align-middle\">Pulled tight while twisted.</td><td class=\"py-3 px-3 align-middle\">A calm, even lacing pattern.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do you stop flat laces from curling and twisting?","defaultOpen":false}}}],"parent_slot":0,"slot_index":2},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"88e46d57-a074-4664-95b5-db5693a2cb27","isGlobalTemplate":false},"parent_slot":1,"slot_index":0,"content":{"teil":"titel"}},{"name":"SortFilter","type":"content","meta":{"uuid":"96dd25b7-6419-43b6-ad3a-46e61a30de1d","isGlobalTemplate":false},"parent_slot":1,"slot_index":1,"content":{"fields":{"category":false,"sortBy":true,"perPage":true,"itemRating":false,"manufacturer":false,"price":false,"availability":false,"customizedFilters":true},"filtersOrder":["category","customizedFilters","availability","sortBy","perPage","itemRating","manufacturer","price"],"filtersDisabled":[],"showAllFiltersImmediately":false,"numberOfFiltersToShowInitially":3}},{"name":"LaccicoKategorieText","type":"content","meta":{"uuid":"1dbfde57-def5-4f97-8e25-9f3e4c2a7d2d","isGlobalTemplate":false},"parent_slot":1,"slot_index":2,"content":{"teil":"text"}},{"name":"LaccicoLaengenleiste","type":"content","meta":{"uuid":"d51c06dc-d519-499f-bfa2-7b067b1891de","isGlobalTemplate":false},"parent_slot":1,"slot_index":3,"content":{"anzeigen":true}},{"name":"ItemGrid","type":"content","meta":{"uuid":"ad1353ce-1cb6-436a-8415-70521167205d","isGlobalTemplate":false},"parent_slot":1,"slot_index":4,"content":{"itemsPerRowDesktop":5,"itemsPerRowTablet":4,"itemsPerRowMobile":2,"showItemCount":false,"itemCountPosition":"left","fields":{"manufacturer":false,"title":true,"ratin