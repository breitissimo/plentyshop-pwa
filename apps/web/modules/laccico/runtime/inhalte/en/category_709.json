[{"name":"MultiGrid","type":"structure","meta":{"uuid":"84a7c836-2441-459b-af6f-50cf42a6e9de","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"734fc2a7-c78b-46ce-b5e1-d7d3da9cbd4b","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"4a608f8d-e1d8-4de2-b24b-60577a320263","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The R2-CS is LACCICO's classic 2 mm round lace: waxed, hot-rolled and polished, with a silky-matt sheen. Our standard waxing is entirely sufficient for everyday use and looks very good.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With the R2-SL, the lace runs more slowly through the wax bath and soaks up more wax. It is double-waxed and grippier at first. Both are made of 100 % cotton, densely braided and made for concealed eyelets. The R2-CS comes in 44 colours.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> R2-CS &amp; R2-SL&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Feature</th><th scope=\"col\" class=\"py-3 px-3\">R2-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">R2-SL Splendore di Laccico</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Waxing<br><span class=\"small text-muted font-weight-normal\">Finish</span></td><td class=\"py-3 px-3 align-middle\">Standard waxing: waxed, hot-rolled, polished.</td><td class=\"py-3 px-3 align-middle\">Double-waxed: longer wax bath, more polishing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Sheen<br><span class=\"small text-muted font-weight-normal\">Look</span></td><td class=\"py-3 px-3 align-middle\">Silky matt.</td><td class=\"py-3 px-3 align-middle\">Splendid sheen like fine calfskin.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grip<br><span class=\"small text-muted font-weight-normal\">Feel</span></td><td class=\"py-3 px-3 align-middle\">Firm and shape-retaining.</td><td class=\"py-3 px-3 align-middle\">Grippier at first, becomes supple with wear.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Colours<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">44 colours, from white to black-brown.</td><td class=\"py-3 px-3 align-middle\">Over 40 colours with Italian names.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lengths<br><span class=\"small text-muted font-weight-normal\">Range</span></td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150 and 180 cm.</td><td class=\"py-3 px-3 align-middle\">45, 60, 75, 90, 120, 150 and 180 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Origin<br><span class=\"small text-muted font-weight-normal\">Production</span></td><td class=\"py-3 px-3 align-middle\">Made in the EU.</td><td class=\"py-3 px-3 align-middle\">Made in Italy.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What distinguishes the Classic Sportive series (R2-CS) technically and in feel from the R2-SL series?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"03a14e3d-c8f1-4322-9ba3-b038120ff572","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The R2-CS suits classic leather shoes with concealed eyelets: Oxfords with closed lacing, Derbies with open lacing, full brogues and fine lace-up ankle boots, for women and men alike.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With concealed eyelets you only see a small hole in the leather from the outside, with a fine eyelet underneath. The 2 mm round lace is made for these. It suits the shoe without pushing itself forward, and so also fits the business shoe that is worn every day. Shoes with visible eyelets or hooks, such as sneakers and boots, need thicker laces.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes &amp; cuts&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Cut</th><th scope=\"col\" class=\"py-3 px-3\">Effect of the R2-CS</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxford<br><span class=\"small text-muted font-weight-normal\">Closed lacing</span></td><td class=\"py-3 px-3 align-middle\">The lacing panels lie under the vamp.</td><td class=\"py-3 px-3 align-middle\">The lacing stays narrow and calm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derby<br><span class=\"small text-muted font-weight-normal\">Open lacing</span></td><td class=\"py-3 px-3 align-middle\">The lacing panels lie on top of the vamp and can be opened wide.</td><td class=\"py-3 px-3 align-middle\">The fine lace lets the cut take centre stage.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Full brogues<br><span class=\"small text-muted font-weight-normal\">Perforations, decorative stitching</span></td><td class=\"py-3 px-3 align-middle\">Mostly with concealed eyelets.</td><td class=\"py-3 px-3 align-middle\">The perforations stay the focus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Fine, with concealed eyelets</span></td><td class=\"py-3 px-3 align-middle\">Ankle-high, many pairs of eyelets.</td><td class=\"py-3 px-3 align-middle\">Long lengths up to 180 cm, also for women's boots.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoes and cuts go best with R2-CS round laces?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"121cc45f-fec7-4047-a7b6-ea18286738f7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The wax penetrates the cotton braid, and the lace is then hot-rolled and polished. This makes it lie smoothly and glide evenly through the eyelet without rubbing at the edges.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The ratio to the eyelet is important: the lace should pass easily through the eyelet, otherwise its surface is put under heavy strain when it is pulled through. That is why the 2 mm round lace is the right choice for the concealed eyelets of classic shoes.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lace &amp; eyelet&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Point</th><th scope=\"col\" class=\"py-3 px-3\">What helps</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wax in the braid<br><span class=\"small text-muted font-weight-normal\">Waxed cotton</span></td><td class=\"py-3 px-3 align-middle\">The wax penetrates the braid, the fibres are bound.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Hot-rolled, polished<br><span class=\"small text-muted font-weight-normal\">Surface</span></td><td class=\"py-3 px-3 align-middle\">The lace lies smoothly and glides evenly.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Diameter<br><span class=\"small text-muted font-weight-normal\">Passes easily through the eyelet</span></td><td class=\"py-3 px-3 align-middle\">2 mm for concealed eyelets, thicker laces for visible eyelets.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Burrs on eyelets<br><span class=\"small text-muted font-weight-normal\">Poorly finished eyelets</span></td><td class=\"py-3 px-3 align-middle\">Carefully deburr rough eyelet edges once.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Wet weather<br><span class=\"small text-muted font-weight-normal\">Shape</span></td><td class=\"py-3 px-3 align-middle\">It keeps its shape even when soaked, because it is tightly braided.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why do waxed R2-CS round laces glide through concealed eyelets so gently?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"088453b9-f766-4199-8e33-d96a3b6f6974","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For 4 to 5 pairs of eyelets, 75 cm fits; for 5 to 6 pairs of eyelets, 90 cm. With 5 pairs of eyelets the foot decides: 75 cm is the norm for classic Derbies and Oxfords, for a wider foot 90 cm is the better choice.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The safest way is to measure your old laces unlaced, from tip to tip. For women's sizes, one size shorter is often enough. The rule of thumb applies to classic footwear with concealed eyelets, as used with the R2-CS.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths for 4–6 pairs of eyelets&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Pairs of eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 pairs of eyelets<br><span class=\"small text-muted font-weight-normal\">Low shoe</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">Derbies and Oxfords with short lacing.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5 pairs of eyelets<br><span class=\"small text-muted font-weight-normal\">Normal case</span></td><td class=\"py-3 px-3 align-middle\">75 cm</td><td class=\"py-3 px-3 align-middle\">The classic 5-eyelet Derby or Oxford.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">5 pairs of eyelets<br><span class=\"small text-muted font-weight-normal\">Wider foot</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Same shoe, more volume at the instep.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 pairs of eyelets<br><span class=\"small text-muted font-weight-normal\">Higher cut</span></td><td class=\"py-3 px-3 align-middle\">90 cm</td><td class=\"py-3 px-3 align-middle\">Transition to ankle-high shoes.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Other lengths<br><span class=\"small text-muted font-weight-normal\">R2-CS</span></td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">From ankle boots to women's boots.</td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What shoelace length do you need for R2-CS with 4 to 6 pairs of eyelets?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"777c9e10-8e0e-4e73-9514-6a059dc90888","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For business shoes, black, dark brown, black-brown, mid brown, navy and wine red are the best choices. Chosen tone-on-tone with the leather, the lace stays completely in the background.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Black box calf calls for black; if you like a quiet contrast, choose slate grey. Brown shoes are easiest to wear with the matching shade of brown. Navy and wine red set a discreet accent on dark leather. In total the R2-CS comes in 44 colours, each in all lengths from 45 to 180 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Business colours&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe leather</th><th scope=\"col\" class=\"py-3 px-3\">R2-CS colour</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Black<br><span class=\"small text-muted font-weight-normal\">Smooth leather, box calf</span></td><td class=\"py-3 px-3 align-middle\">Black, slate grey</td><td class=\"py-3 px-3 align-middle\">Tone-on-tone and formal, with slate grey a quiet contrast.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark brown<br><span class=\"small text-muted font-weight-normal\">Mocha, espresso</span></td><td class=\"py-3 px-3 align-middle\">Dark brown, black-brown</td><td class=\"py-3 px-3 align-middle\">The lace blends into the leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Mid brown<br><span class=\"small text-muted font-weight-normal\">Chestnut</span></td><td class=\"py-3 px-3 align-middle\">Mid brown, brown, nut brown</td><td class=\"py-3 px-3 align-middle\">Warm, natural transition to the leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Light brown<br><span class=\"small text-muted font-weight-normal\">Cognac</span></td><td class=\"py-3 px-3 align-middle\">Caramel brown, light brown</td><td class=\"py-3 px-3 align-middle\">Light and fresh, matching the leather.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark leather<br><span class=\"small text-muted font-weight-normal\">Accent</span></td><td class=\"py-3 px-3 align-middle\">Navy, wine red</td><td class=\"py-3 px-3 align-middle\">A discreet colour accent for connoisseurs.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">All colours<br><span class=\"small text-muted font-weight-normal\">44 colours</span></td><td class=\"py-3 px-3 align-middle\">Each colour in 45, 60, 75, 90, 120, 150 and 180 cm.</td><td class=\"py-3 px-3 align-middle\">Tone-on-tone or as an accent.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which basic colours of the R2-CS series are best for classic business combinations?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"b66db30b-6640-42b9-854f-4f564a9c4d0b","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"__KATEGORIE_RASTER__","type":"marker","meta":{"uuid":"130e2e14-e777-4e20-8a3c-5ce6e592403e","isGlobalTemplate":false},"content":{},"parent_slot":1,"slot_index":1},{"name":"CategoryData","type":"content","meta":{"uuid":"efbce0a5-4b10-470c-8435-0012eded35bc","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"089c25b3-ab14-4357-9762-960d6acaa065","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3}]}]