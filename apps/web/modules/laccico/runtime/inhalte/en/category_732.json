[{"name":"MultiGrid","type":"structure","meta":{"uuid":"db999d44-5527-4db1-bd27-c37334dece47","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"3ef6fc29-2868-406e-b239-6947f9d42d90","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"96c4f575-e0ad-414c-bf19-fb6b6a699d78","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 2 mm round lace looks fine and understated; it leaves the stage to the shoe. The 3 mm round lace is stronger and more present, the round cord is clearly visible.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Which one fits is decided mainly by the eyelet: the 2 mm round lace is made for concealed eyelets, as found on classic Oxfords and Derbies. The 3 mm round lace belongs on shoes with visible eyelets or hooks, such as lace-up ankle boots and boots. That way the thickness of the lace also suits the shoe visually.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> 2 mm &amp; 3 mm&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive, Splendore</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Fine and understated.</td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbies, dress shoes</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Strong and present.</td><td class=\"py-3 px-3 align-middle\">45–150 cm</td><td class=\"py-3 px-3 align-middle\">Lace-up ankle boots, boots, shoes with hooks</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How do 2 mm and 3 mm round laces differ in appearance?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"91b74585-1136-4d94-837d-79eb6a4faf08","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>For fine lace-up shoes with concealed eyelets, the 2 mm round lace is the right choice. It steps back visually.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">With concealed eyelets (blind eyelets) you only see a small hole in the leather from above, with a fine eyelet underneath. The lace should pass easily through the eyelet, otherwise its surface is put under heavy strain when it is pulled through. If you would like a quiet accent instead of the round cord, choose the 3 mm flat lace; it is also made for concealed eyelets.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Fine shoes&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Good to know</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">The classic for Oxfords and Derbies.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">2 mm round<br><span class=\"small text-muted font-weight-normal\">Splendore di Laccico</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">Double-waxed, made in Italy.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm flat<br><span class=\"small text-muted font-weight-normal\">Classic Sportive</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Narrow and flat, an accent that connoisseurs notice.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm round<br><span class=\"small text-muted font-weight-normal\">For comparison</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">45–150 cm</td><td class=\"py-3 px-3 align-middle\">For visible eyelets, too strong for fine shoes.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What is the best diameter for fine lace-up shoes?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c387f473-5c8c-4784-885e-c39ee035fb7f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Splendore di Laccico is our special version of the 2 mm round lace: made in Italy and double-waxed. This gives a special depth of colour and a splendid sheen like fine calfskin.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">SL is meant for lovers of fine shoes. On Goodyear-welted Oxfords and Derbies in box calf or shell cordovan it simply belongs, like cufflinks with a dinner jacket. Like all 2 mm round laces, it is made for concealed eyelets.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> SL &amp; CS&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Finish</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th><th scope=\"col\" class=\"py-3 px-3\">Suits</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Splendore di Laccico<br><span class=\"small text-muted font-weight-normal\">Made in Italy</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Double-waxed, splendid sheen like fine calfskin.</td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">Goodyear-welted Oxfords and Derbies, evening shoes</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Classic Sportive<br><span class=\"small text-muted font-weight-normal\">The classic</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-CS</a></td><td class=\"py-3 px-3 align-middle\">Waxed, subtle sheen.</td><td class=\"py-3 px-3 align-middle\">45–180 cm</td><td class=\"py-3 px-3 align-middle\">Oxfords, Derbies, dress shoes</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What makes the Splendore di Laccico (SL) round laces special?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4f436ddc-4dc1-4822-aab4-7f9d4c18c48c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 3 mm round lace is made for shoes with visible eyelets or hooks: lace-up ankle boots, boots and sturdy low shoes.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">For concealed eyelets, the 2 mm round lace is the better choice. On hooks, lay the lace in under tension after crossing instead of pulling it through. The R3-CS comes in lengths from 45 to 150 cm, so also for tall lace-up boots.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes for R3&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Good to know</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Lace-up ankle boots<br><span class=\"small text-muted font-weight-normal\">Ankle-high</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, often hooks at the top</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">With 7–8 pairs of eyelets usually 120 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Boots<br><span class=\"small text-muted font-weight-normal\">Workwear, heritage</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets and hooks</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">The eyelets are far apart: measure the old laces.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Low shoes<br><span class=\"small text-muted font-weight-normal\">Sturdy models</span></td><td class=\"py-3 px-3 align-middle\">Visible eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">With 4–5 pairs of eyelets usually 75 cm.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Fine low shoes<br><span class=\"small text-muted font-weight-normal\">Oxfords, Derbies</span></td><td class=\"py-3 px-3 align-middle\">Concealed eyelets</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">This is where the 2 mm round lace belongs.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoes is a 3 mm round lace (R3) suitable for?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"f6b90c09-63ae-4a45-8ead-63793178a397","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The 2 mm round lace is used on classic lace-up shoes with concealed eyelets, such as Oxfords, Derbies and dress shoes.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">It steps back visually and leaves the stage to the leather. There are two versions to choose from: Classic Sportive (CS), the classic, and Splendore di Laccico (SL), double-waxed and made in Italy. The safest way is to measure the old laces unlaced, from tip to tip. For classic footwear, the number of pairs of eyelets serves as a rule of thumb.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Shoes for R2&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Shoe</th><th scope=\"col\" class=\"py-3 px-3\">Series</th><th scope=\"col\" class=\"py-3 px-3\">Length (rule of thumb)</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Oxfords<br><span class=\"small text-muted font-weight-normal\">Closed lacing</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">75 cm for 4–5 pairs of eyelets</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Open lacing</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">60 cm for 3–4, 75 cm for 4–5 pairs of eyelets</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Goodyear-welted shoes<br><span class=\"small text-muted font-weight-normal\">Box calf, shell cordovan</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">Like Oxfords and Derbies</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Fine ankle boots<br><span class=\"small text-muted font-weight-normal\">Concealed eyelets</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-CS</a> · <a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R2-SL</a></td><td class=\"py-3 px-3 align-middle\">120 cm for 7–8 pairs of eyelets</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"When do you use a 2 mm round lace (R2)?","defaultOpen":false}}}],"parent_slot":0},{"name":"CategoryData","type":"content","meta":{"uuid":"070d52fc-1310-48e3-a65f-885a6693c1dd","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"0862fc31-7e39-4607-a1b5-c203ad45334b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"724","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":1},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"f9610670-b0f8-4918-8886-91c1c9f6393d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"709","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"c26afdf0-3186-4d7c-9588-b9419c2c0997","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"735","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"462a5ba5-ba12-4752-b26a-b1b7cf465f81","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"687","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":4},{"name":"CategoryData","type":"content","meta":{"uuid":"e9cdde74-326b-4578-b7a3-795a2290baf9","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":5},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"b4292b6e-918d-4910-ac40-7a9dac2b0a8a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":6}]}]