/0482CC_0004_Arancione4.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl"},"text":{"textOverlay":"","textOverlayColor":"#333333","textOverlayAlignY":"center","textOverlayAlignX":"center"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"4d43520b-0ddb-4496-87f2-bae3c8ff64b3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Feels like leather</strong></h2><h5>Braided from the best cotton</h5><p>Discover 'Splendore di LACCICO', the double-waxed round shoelaces from LACCICO, in 40 magnificent colours.</p><p>The intensive wax layer not only gives brilliant colours, but also a unique feel that sets them apart from other waxed laces that are second to none. </p><p>You will feel the pleasant firmness and suppleness in your hand. They are also vegan and free from animal ingredients.</p><p>These laces are ideal for shoes with concealed eyelets and go with both classic and modern looks to emphasise your personal style.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"9313c094-e268-483e-b091-4895bd5e6c77","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"Discover now","link":"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"dbfe683e-c2a5-44ea-93fd-c1d054181809","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"9dcb77d6-a4e4-4c61-9f58-2e1982afe162","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>40 vibrant colours</strong></h2><p>When you hold these laces in your hand, you feel a pleasant firmness and suppleness that sets them apart from conventional waxed laces.</p><p>With a choice of over 40 colours and seven lengths, LACCICO offers the opportunity to customise every shoe down to the last detail.</p><p>Choose from a wide range of colours and different lengths to ensure your laces match your shoes perfectly.</p><p>Enhance your shoes with the exquisite 'Slendore di LACCICO' laces from LACCICO.</p><p>Discover the elegance of LACCICO's double-waxed round laces and add sophistication to your footwear.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"540e4a5e-bee8-4e5b-90cb-3de125b0332b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"Discover Splendore di Laccico","link":"/en/","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":1},{"name":"Image","type":"content","meta":{"uuid":"be4c7ba4-0914-48d1-bfbb-dd8db6cdd3d8","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_