[{"name":"TextCard","type":"content","meta":{"uuid":"61de2e8e-5c57-4b1e-b0bd-33d57d1a54a9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h1 class=\"align-center\">Shoelace length</h1>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"1f2baad5-8ed4-4688-bfa0-1414e1dbb9f9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3>Which shoelace length is right?</h3>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"a2383f90-cbc1-42b8-8107-1f95a3e37974","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"Image","type":"content","meta":{"uuid":"e192fae0-c25b-4fbf-89c5-47c008d473b1","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":""},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":0,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"c1782d61-98f8-439d-a1bd-f13cd2cd0fa9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style=\"font-size:.8rem !important;line-height:1.4 !important;color:#666;margin:6px 0 0\">AI-generated image</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":1},{"name":"TextCard","type":"content","meta":{"uuid":"1f897541-96e8-4524-9980-f195769b9160","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style=\"margin:0 0 14px\">For classic footwear, the length depends on the number of pairs of eyelets:</p><div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:1em !important;line-height:1.5 !important;margin:0;border:0\"><thead><tr><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Pairs of eyelets</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Length</th></tr></thead><tbody><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">1–2</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">3–4</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">60 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">4–5</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">75 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">5–6</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">90 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">7–8</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">9+ / boots</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">150–180 cm</td></tr></tbody></table></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"a6f5ee71-aa20-4f6c-b471-7ac6c90bd21f","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"8d218e3b-f5b4-4a81-8135-b23737de4378","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"mt-4\">Which shoes the rule of thumb is for</h3><p>The rule of thumb applies to classic footwear. The further apart the eyelets sit, as on sneakers or boots, the less it fits. Sneakers usually have many pairs of eyelets and need 90–120 cm. An ankle boot needs 120 cm or more, knee-high women's boots usually 150 to 180 cm.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"be6b634c-bd1d-4bec-ad7a-4ac6a60f16af","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3>Between two lengths?</h3><p>For 4 and 5 pairs of eyelets, the table gives two lengths. Whether the shorter or the longer one fits depends on the shoe and the foot: a classic 5-eyelet Derby or Oxford almost always takes 75 cm, a wider foot 90 cm. The lacing method and foot type also play a part, and a thick lace such as the F6-XR needs a little more length than a thin one.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"bc18ca63-bb45-4482-9020-ca599bb050d2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:1em !important;line-height:1.5 !important;margin:0;border:0\"><thead><tr><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Series</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Shape</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Lengths</th></tr></thead><tbody><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-cs\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R2-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">round, 2 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45–180 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-2-mm/r2-sl\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R2-SL</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">round, 2 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">45–180 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R3-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">round, 3 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45–150 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-3-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F3-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">flat, 3 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">60–120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F4-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">flat, 4 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">60–120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F6-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">flat, 6 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">75–150 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F6-XR</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">flat, 6 mm, robust</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">75–150 cm</td></tr></tbody></table></div><p style=\"margin:10px 0 0;font-size:.95rem;color:#555\">180 cm is only available in the 2 mm round laces.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"4d483bea-f8e6-4f4c-8ee2-87ce3efc6f3d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"mt-4\">Frequently asked questions about shoelace length</h3>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"DetailsList","type":"structure","meta":{"uuid":"03b54456-bfa3-4b46-a9ad-788f7f5d23f2","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"79b7e7d3-75c4-40a2-8d37-8a3bbc6fe56b","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>90 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">By the rule of thumb, 90 cm fits 5–6 pairs of eyelets. This applies to classic footwear; if the eyelets are far apart, as on sneakers, they can be longer.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How long should shoelaces be for 6 pairs of eyelets?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"c3b721eb-4cda-4988-b00a-61f7ab55f5d7","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>75 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">That almost always fits classic 5-eyelet shoes. For a wider foot, take 90 cm.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What length do I need for a 5-eyelet Derby or Oxford?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"12633ca5-fc01-4688-bced-d9edae9d4f19","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>120 cm or more for ankle boots, 150 to 180 cm for boots with 9 or more pairs of eyelets.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">At LACCICO, 180 cm is available in the 2 mm round laces; the long lengths mostly go to women's boots.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"How long should shoelaces be for boots?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"bab3fb2e-9558-4d92-96c6-d11240433211","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Yes, a little.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">A thick lace like the F6-XR uses more length on its way through the eyelets than a thin one. If the rule of thumb allows two lengths, choose the longer one for the F6-XR.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Do thicker shoelaces need more length?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"a51b8d72-650e-4db3-9833-c532738cdfa8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>It could be calculated if you knew every eyelet spacing and the allowance for the bow. In practice, nobody does that.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The safest way is to measure your old laces unlaced; without old laces, the rule of thumb above will help.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Can you calculate shoelace length?","defaultOpen":false}}}]},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"6f52cb25-f0d3-44db-9ec6-d24f2f765126","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"727","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"2562e722-1f52-4a31-8110-557f96fc1b76","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"731","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"4d0a6bf9-bedc-40be-9ff8-7ea8448c39bb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"729","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"7acea1d1-c29b-47f5-81ab-6971b6e7a0be","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"730","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"cf379a06-d5a6-4aa9-a764-06bfb3f18c0d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Recently viewed</strong></h2>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}}}]