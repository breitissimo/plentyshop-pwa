[{"name":"MultiGrid","type":"structure","meta":{"uuid":"22ebd65b-4d79-4a4b-a132-6acdf79611b5","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"88ecce85-798f-4cb0-a3ef-0d863750055b","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"2fd30852-c20d-4815-9394-dcad957b3878","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Slim leather sneakers with visible eyelets of 4 mm inner diameter or more suit the 4 mm flat lace (F4-CS). From 5 mm inner diameter, for example on court sneakers, the 6 mm flat lace (F6-CS) fits as well.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The eyelet is what counts: if the width suits the eyelet, the lace lies flat. On high-quality leather sneakers, the waxed lace replaces the simple factory laces with a lace that has a subtle sheen and a high-quality feel. If you prefer round laces, choose the 3 mm round lace for eyelets of 4 mm inner diameter or more and for lace loops.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lace by eyelet&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Eyelets</th><th scope=\"col\" class=\"py-3 px-3\">Sneakers</th><th scope=\"col\" class=\"py-3 px-3\">Lengths</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 4 mm inner diameter or more, or lace loops.</td><td class=\"py-3 px-3 align-middle\">Slim leather sneakers, sports shoes with lace loops, smart casual shoes.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 5 mm inner diameter or more.</td><td class=\"py-3 px-3 align-middle\">Court sneakers, leather sneakers, high-top sneakers.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/round-laces-by-diameter/round-laces-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">R3-CS</a></td><td class=\"py-3 px-3 align-middle\">Visible eyelets, 4 mm inner diameter or more, lace loops.</td><td class=\"py-3 px-3 align-middle\">Leather sneakers, if you want a round lace.</td><td class=\"py-3 px-3 align-middle\">45–150 cm</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which flat laces suit smart sporty sneakers?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0c1588cb-21be-4449-abcb-69d0ea44b1e5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Waxed, hot-rolled and polished, they have a subtle sheen and lie smoothly. That looks more refined than the simple factory laces of many sneakers and suits the leather.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">For the retro look, the braid pattern also matters. The F6-CS is fine and unobtrusive and looks refined, even in strong colours. The F6-XR has strong strands and more volume because more yarn is braided into it; it suits sneakers in vintage style. On slim retro models, the F4-CS works well.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Retro look&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Lace</th><th scope=\"col\" class=\"py-3 px-3\">Effect</th><th scope=\"col\" class=\"py-3 px-3\">Sneakers</th></tr></thead><tbody><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Slim, subtle sheen.</td><td class=\"py-3 px-3 align-middle\">Slim retro models.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Fine, unobtrusive braid pattern, refined.</td><td class=\"py-3 px-3 align-middle\">Court sneakers, leather sneakers.</td></tr><tr><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Strong strands, rustic.</td><td class=\"py-3 px-3 align-middle\">Sneakers in vintage style, high-top sneakers in workwear style.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Why do waxed flat laces bring out the design of retro sneakers so well?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"6427f530-1c89-48b6-a6a9-e429a5b2b20f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Tone-on-tone with the upper looks calm and refined. A lace in a contrasting colour that picks up other accessories deliberately sets an accent.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">White leather sneakers suit white; if you prefer something softer, choose light beige, a creamy tone. Sneakers in muted colours suit greys, beiges and browns. Strong colours such as fuchsia or turquoise do not look loud on the F6-CS, because its braid pattern is unobtrusive. Light-coloured laces are replaced when they are heavily soiled; if you wear light-coloured laces, it is best to keep a supply.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Colour by sneaker&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Sneaker</th><th scope=\"col\" class=\"py-3 px-3\">Colours</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">White<br><span class=\"small text-muted font-weight-normal\">Leather sneakers</span></td><td class=\"py-3 px-3 align-middle\">White, light beige, greige.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Grey &amp; beige<br><span class=\"small text-muted font-weight-normal\">Muted</span></td><td class=\"py-3 px-3 align-middle\">Light grey, greige, taupe, beige.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Dark<br><span class=\"small text-muted font-weight-normal\">Black, blue, brown</span></td><td class=\"py-3 px-3 align-middle\">Black, navy, dark brown.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Accent<br><span class=\"small text-muted font-weight-normal\">Contrast</span></td><td class=\"py-3 px-3 align-middle\">Fuchsia, turquoise, royal blue, orange.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which shoelace colour suits sneakers?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"07b33cbf-53c9-4841-81b3-7fffa669e3ef","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Width and length: the new lace must suit the eyelet. The safest way to get the length is to measure the old laces unlaced, from tip to tip.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The smaller the inner diameter of the eyelet and the wider the lace, the more easily it twists. The more easily it glides through the eyelet, the easier it is to keep flat. When threading, guide the lace through the eyelet with one hand and let the loose end slide over a finger of the other hand under light tension. Only pull once the lace lies flat.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Replacing laces&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Step</th><th scope=\"col\" class=\"py-3 px-3\">What to do</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Width<br><span class=\"small text-muted font-weight-normal\">To suit the eyelet</span></td><td class=\"py-3 px-3 align-middle\">From 4 mm inner diameter and for lace loops: 4 mm. From 5 mm inner diameter: 6 mm as well.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Length<br><span class=\"small text-muted font-weight-normal\">Measure</span></td><td class=\"py-3 px-3 align-middle\">Measure the old laces unlaced, from tip to tip.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Threading<br><span class=\"small text-muted font-weight-normal\">Guide flat</span></td><td class=\"py-3 px-3 align-middle\">Let the loose end slide under light tension, only pull once the lace lies flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Twisted<br><span class=\"small text-muted font-weight-normal\">Before tightening</span></td><td class=\"py-3 px-3 align-middle\">Once pulled tight while twisted, the twist is hard to correct. So check beforehand that the lace lies flat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chafes quickly<br><span class=\"small text-muted font-weight-normal\">Burrs</span></td><td class=\"py-3 px-3 align-middle\">Eyelets often have sharp burrs. Deburring once helps.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"What should you look out for when replacing the original laces on a sneaker?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"e54e0b91-f80b-49ef-b815-3d09bc6a0d3a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>The safest way is to measure your old laces unlaced, from tip to tip. Low-top sneakers usually need 90 or 120 cm, high-top sneakers 150 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">The length needed depends on the lacing style and the foot, and on sneakers the eyelets are far apart. That is why a rule of thumb based on pairs of eyelets helps little here. The F4-CS comes in 60, 75, 90 and 120 cm, the F6-CS and the F6-XR in 75, 90, 120 and 150 cm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Lengths&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Swipe sideways&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Length</th><th scope=\"col\" class=\"py-3 px-3\">Typical shoes</th><th scope=\"col\" class=\"py-3 px-3\">Lace</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">75 cm<br><span class=\"small text-muted font-weight-normal\">Short</span></td><td class=\"py-3 px-3 align-middle\">Casual shoes with few eyelets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">90 cm<br><span class=\"small text-muted font-weight-normal\">Medium</span></td><td class=\"py-3 px-3 align-middle\">Low-top sneakers.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">120 cm<br><span class=\"small text-muted font-weight-normal\">Long</span></td><td class=\"py-3 px-3 align-middle\">Sneakers with many eyelets, mid-cut.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">150 cm<br><span class=\"small text-muted font-weight-normal\">Very long</span></td><td class=\"py-3 px-3 align-middle\">High-top sneakers.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/en/shape-diameter/flat-laces-by-width/flat-laces-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div><p>More on our <a href=\"/en/laccico-finest-waxed-laces/shoelace-length\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Shoelace length</a> page.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Which lengths do you choose for flat laces on high-top and low-top sneakers?","defaultOpen":false}}}],"parent_slot":0},{"name":"MultiGrid","type":"structure","meta":{"uuid":"8acf7b03-eaba-4f01-91cf-e8e737846e7c","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"CategoryData","type":"content","meta":{"uuid":"e49e0254-2bcb-4aab-b7c1-6c164e382253","isGlobalTemplate":false},"content":{"name":"","fields":{"name":true,"description1":true,"description2":false,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"0a86467e-d69f-4af4-abbb-6e11dfcb1a1c","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":""},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1}],"parent_slot":1,"slot_index":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"2add6cb0-2f2b-47df-85e3-95e1367fbf12","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"705","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":1},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"be4ea241-44e7-44ec-ae9b-6ae8116a40d6","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"702","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":2},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"125aaecb-7da9-40bd-873f-0b7b1ba71adb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"737","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":3},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"276d9f8d-ae93-4e3b-8b94-92eb64d6f2ed","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"735","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":4},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"38a41a3b-39ea-4275-90fb-167a95af18ed","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":5},{"name":"CategoryData","type":"content","meta":{"uuid":"922827e7-ff2a-4481-bc7a-cefe4fd3a27c","isGlobalTemplate":false},"content":{"name":"","fields":{"name":false,"description1":false,"description2":true,"shortDescription":false},"fieldsOrder":["name","description1","description2","shortDescription"],"fieldsDisabled":[],"displayCategoryImage":"off","image":{"fillMode":"fill","alt":"","brightness":0.75},"text":{"color":"#121212","bgColor":"#fbfbf9","bgOpacity":1,"textAlignment":"left","justify":"top","align":"left","background":false},"layout":{"paddingTop":16,"paddingBottom":16,"paddingLeft":0,"paddingRight":0}},"parent_slot":1,"slot_index":6}]}]