qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0004_Arancione4.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl"},"text":{"textOverlay":"","textOverlayColor":"#333333","textOverlayAlignY":"center","textOverlayAlignX":"center"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":0},{"name":"MultiGrid","type":"structure","meta":{"uuid":"9eaa663f-afd7-4494-959e-55536418a722","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"52895e5a-b56d-40dd-8fde-8983c16198bb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>au toucher comme le cuir</strong></h2><h5>tressés avec le meilleur coton<br></h5><p>Découvre 'Splendore di LACCICO', les lacets ronds doublement cirés de LACCICO, disponibles en 40 couleurs magnifiques.<br></p><p>La couche de cire intense leur confère non seulement des couleurs brillantes, mais aussi un toucher unique qui les distingue des autres lacets cirés, qui n'ont pas leur pareil.&nbsp;<br></p><p>Vous sentirez leur agréable résistance et leur souplesse dans votre main. De plus, ils sont végétaliens et ne contiennent pas de composants d'origine animale.<br></p><p>Ces lacets sont idéaux pour les chaussures à œillets cachés et s'accordent aussi bien avec les looks classiques que modernes pour mettre en valeur votre style personnel.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"f32dee8b-c3ed-4883-949b-3bb581b8c653","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"découvrir maintenant","link":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":1},{"name":"EmptyGridBlock","type":"content","meta":{"uuid":"a05a6f48-cec8-457f-a56a-5fdc9ab1bfc9","isGlobalTemplate":false},"parent_slot":1,"content":[]}],"parent_slot":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"358c3c6a-21dc-4d10-9ab6-abf9fdb1cd10","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"MultiGrid","type":"structure","meta":{"uuid":"d231880f-5d19-4d68-a666-6b01a83dc983","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"7f2504f8-369d-4086-bb46-fa318c4dea58","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>40 couleurs vives</strong></h2><p>Lorsque l'on tient ces lacets dans la main, on ressent une fermeté et une souplesse agréables qui les distinguent des lacets cirés traditionnels.<br></p><p>Avec un choix de plus de 40 couleurs et sept longueurs, LACCICO offre la possibilité de personnaliser chaque chaussure dans les moindres détails.<br></p><p>Choisissez parmi une large gamme de couleurs et de longueurs différentes pour vous assurer que vos lacets s'adaptent parfaitement à vos chaussures.<br></p><p>Agrémentez vos chaussures avec les lacets exquis 'Slendore di LACCICO' de LACCICO.<br></p><p>Découvrez l'élégance des lacets ronds doublement cirés de LACCICO et ajoutez du raffinement à vos chaussures.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"de94d07a-7abc-4ab9-9492-c3ac52e1943d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"Découvrir maintenant","link":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":1},{"name":"EmptyGridBlock","type":"content","meta":{"uuid":"07b848b5-ebc3-4139-9353-118672bf2256","isGlobalTemplate":false},"parent_slot":1,"content":[]}],"parent_slot":0},{"name":"Image","type":"content","meta":{"uuid":"e430e139-0546-4c7e-9b5b-d5712b9f5024","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0008_Melanzana9.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0008_Melanzana9.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0008_Melanzana9.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Images/Splendore_di_Laccico/Contentseite/0482CC_0008_Melanzana9.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl"},"text":{"textOverlay":"","textOverlayColor":"#333333","textOverlayAlignY":"center","textOverlayAlignX":"center"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"5c8688d1-67ff-477a-be32-8af9f9e28d28","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4><strong>LACETS MAGNIFIQUES<br></strong></h4><h1><strong>splendore di laccico</strong></h1>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"0e450af5-3eac-467b-83b4-3647c47ecc98","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"DÉCOUVRIR MAINTENANT","link":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"67dae0f6-6103-4bcf-9cb8-dccb6ca37b28","isGlobalTemplate":false},"configuration":{"columnWidths":[3,3,3,3],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"96249524-4a6f-4370-a492-55ddfc50b291","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Ces lacets sont idéaux pour les chaussures à œillets cachés et s'adaptent aussi bien aux looks classiques que modernes pour mettre en valeur votre style personnel.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"4955bf08-b843-4177-8c1a-65950d857fe3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Qu'est-ce qui rend LACCICO spécial ? Les lacets sont fabriqués en coton de qualité supérieure certifié Oekotex et sont tressés en une cordelette résistante qui présente une surface uniforme et une solidité exceptionnelle.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1},{"name":"TextCard","type":"content","meta":{"uuid":"0e633960-cd4c-4165-bb6b-dc58267f9911","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Pour seulement EUR 5,99, vous recevrez une paire de lacets LACCICO 'Slendore di LACCICO' - le complément idéal pour donner une touche spéciale à votre style.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2},{"name":"TextCard","type":"content","meta":{"uuid":"95aa737c-5a0c-4b44-a0cd-cb6833cfb0ce","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p>Enrichissez votre collection de chaussures avec les lacets 'Slendore di LACCICO' de LACCICO et faites l'expérience de la combinaison imbattable de la solidité, de la brillance des couleurs et du toucher unique. Offrez le meilleur à vos pieds - offrez-vous LACCICO.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":3,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"5fea2be0-a139-4c68-8e16-7873c6dd1a57","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"Découvre la splendeur","link":"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ron