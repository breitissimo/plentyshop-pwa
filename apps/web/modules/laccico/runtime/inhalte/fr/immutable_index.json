tton":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1}],"parent_slot":1,"slot_index":0},{"name":"Image","type":"content","meta":{"uuid":"e0614dab-c995-4f3d-bad7-ecb361084cf2","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Sneaker_und_Freizeit/Bannerbild-Sneaker-und-Freizeit.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/fr/baskets-et-chaussures-de-loisirs"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":1,"slot_index":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"803bb6c0-ff9d-42af-b69d-1ac8cdd7af44","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2 class=\"align-center\"><span class=\"color-secondary\"> Splendore di Laccico </span></h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"e14d3674-adb1-4363-a38b-009ab4bea904","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"align-center\"><span class=\"color-secondary\"> Lacets d'exception cirés deux fois </span></h3><p class=\"align-center\"><span class=\"color-secondary\"> Made in Italy </span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"8a72bd77-25df-4bb6-bdc1-1e3058b75c81","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"DÉCOUVRIR","link":"/fr/chaussures-professionnelles-et-elegantes","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"e1321daa-5f35-4afe-88a5-2e2eb14ac486","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3><strong class=\"color-#1a1a1a bg-appearance\">Durables et robustes</strong></h3><p><span class=\"color-#1a1a1a bg-appearance\">Grâce à l'association d'un coton de premier choix et de notre cirage traditionnel, les lacets LACCICO sont </span><strong class=\"color-#1a1a1a bg-appearance\">résistants à la déchirure</strong><span class=\"color-#1a1a1a bg-appearance\">, </span><strong class=\"color-#1a1a1a bg-appearance\">résistants à l'abrasion</strong><span class=\"color-#1a1a1a bg-appearance\"> et durables. Le résultat : des lacets qui gardent leur forme et dont vous profiterez longtemps.</span></p><p><strong class=\"color-#1a1a1a bg-appearance\">Le tressage européen rencontre la technologie moderne</strong></p><p><span class=\"color-#1a1a1a bg-appearance\">Nos lacets cirés sont fabriqués en étroite collaboration avec des tresseries traditionnelles sélectionnées en Europe. Des machines à tresser modernes y produisent avec soin, à partir des fils les plus fins, des lacets </span><strong class=\"color-#1a1a1a bg-appearance\">au tressage serré</strong><span class=\"color-#1a1a1a bg-appearance\">. Cette alliance de l'artisanat traditionnel et d'une technologie innovante fait la qualité LACCICO reconnaissable entre toutes.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"2d0f9321-44e0-4927-8b9d-fc766e7a1cd9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2 class=\"mt-5\">Meilleures ventes</h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"11860814-3838-4024-938b-5bf1ed2bcd75","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"724","itemId":"","crossSellingRelation":"Similar"}}},{"name":"TextCard","type":"content","meta":{"uuid":"411e67f7-5710-4eba-abc8-856b681a04ea","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4><strong class=\"bg-appearance color-#1a1a1a\">Notre philosophie : des lacets qui vont avec la chaussure</strong></h4><p><span class=\"bg-appearance color-#1a1a1a\">Nous proposons des lacets cirés en 100 % coton, pour un aspect raffiné et un toucher agréable.</span></p><p><strong class=\"bg-appearance color-#1a1a1a\">100 % coton</strong></p><p><span class=\"bg-appearance color-#1a1a1a\">Coton pur, ciré, laminé à chaud et poli, avec une surface lisse et un brillant mat et soyeux.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"848fbe8e-8481-4fb5-a245-299d38e78946","isGlobalTemplate":false},"configuration":{"columnWidths":[4,4,4],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"3a6461e3-6259-46b9-865a-261f38147f84","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Pourquoi LACCICO ? </strong></h2><h3><strong>Vos avantages en détail :</strong></h3><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Tenue de forme &amp; résistance :</strong> Grâce à sa construction au tressage serré en coton résistant à la déchirure, chaque lacet garde parfaitement sa forme et résiste au quotidien.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Ciré &amp; résistant à l'abrasion :</strong> La finition cirée rend nos lacets premium peu salissants et résistants aux intempéries, et leur donne un aspect raffiné au brillant soyeux.</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><strong>Un toucher unique :</strong> Découvrez une qualité souple, avec une bonne prise en main et un volume à la fois souple et massif.</li></ol>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"DetailsList","type":"structure","meta":{"uuid":"061cbdd8-9688-4f17-b737-4ba389203ac9","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"fa77d987-d40f-4ebc-b396-dcc02767d61d","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>La&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>cire pénètre entièrement la structure des fibres</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>&nbsp;du tressage en coton, un peu comme les tanins pénètrent le cuir. Elle protège la fibre de coton de l'humidité, empêche les fibres de s'effilocher mécaniquement et&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>réduit les frottements</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>, de sorte que le lacet glisse souplement et&nbsp;</span><strong style='box-sizing: border-box; font-weight: bolder; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>avec peu d'usure&nbsp;</strong><span style='color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;'>dans les œillets lorsque vous le nouez.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"À quoi sert le cirage des lacets LACCICO ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3dcdf675-d3f5-4a99-92e9-061d2d0caf93","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Lacets ronds de 2 mm</u></a> (<a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-CS</u></a> · <a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">R2-SL</u></a>) :</strong> Pour les chaussures de ville élégantes (richelieu, derby) aux œillets cachés</li><li style=\"box-sizing: border-box;\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Lacets ronds de 3 mm (R3)</u> :</strong></a> Pour les chaussures basses robustes, les chukka boots et les chaussures cousues Goodyear aux œillets visibles</li><li style=\"box-sizing: border-box;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Lacets plats de 3 mm (F3)</u> :</strong>&nbsp;</a>Pour les classiques cousus Goodyear, les brogues et toutes les chaussures à œillets cachés</li><li style=\"box-sizing: border-box;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><u style=\"box-sizing: border-box;\">Lacets plats de 4 mm (F4)</u> :&nbsp;</strong></a>Pour les chaussures basses classiques, les bottines &amp; les chaussures de loisir</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">Lacets plats de 6 mm</u></a> (<a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-CS</u></a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" style=\"box-sizing: border-box; color: rgb(18, 18, 18); text-decoration: none; background-color: rgba(0, 0, 0, 0); overflow-wrap: break-word;\"><u style=\"box-sizing: border-box;\">F6-XR</u></a>) :</strong> Pour les baskets, les chaussures de loisir et les boots de travail robustes</li></ul>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quel type de lacet pour quelle chaussure ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"eb686202-8b05-4482-803c-11e5dbe9a80e","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">Guide des longueurs LACCICO</strong> (règle empirique pour les chaussures classiques)</p><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>La bonne longueur est déterminante pour le maintien et pour l'aspect. Pour les chaussures classiques, le nombre de paires d'œillets sert de règle empirique :</p><ul style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; list-style-type: circle;'><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">1–2 paires d'œillets :</strong> 45 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">3–4 paires d'œillets :&nbsp;</strong>60 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">4–5 paires d'œillets :</strong> 75 cm (avec un laçage derby, éventuellement 90 cm à partir de 5 paires d'œillets, selon le pied)</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">5–6 paires d'œillets :</strong> 90 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">7–8 paires d'œillets :</strong> 120 cm</li><li style=\"box-sizing: border-box;\"><strong style=\"box-sizing: border-box; font-weight: bolder;\">9 paires d'œillets et plus / bottes :</strong> 150 à 180 cm</li></ul><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'><strong style=\"box-sizing: border-box; font-weight: bolder;\">Le conseil du maître :</strong> En cas de doute, mesurez vos anciens lacets délacés. Vous obtiendrez ainsi une longueur adaptée, qui correspond exactement à vos préférences.</p><p>Plus de détails sur notre page <a href=\"/fr/laccicolacetsfinscires/longueur-des-lacets\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">Longueur des lacets</a>.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Comment trouver la bonne longueur de lacet ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"cc67a405-9d6c-4f35-9fe3-fa2295d2e695","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><span data-path-to-node=\"5,3,1,0,0,0\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>En <strong style=\"box-sizing: border-box; font-weight: bolder;\">coton de qualité 100 %</strong>, tressé serré sur des machines à tresser modernes dans des entreprises européennes de tradition</span><span data-path-to-node=\"5,3,1,0,0,2\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'></span><span data-path-to-node=\"5,3,1,0,0,4\" style='box-sizing: border-box; color: rgb(26, 26, 26); font-family: Averta, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;'>.</span></p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"En quoi sont faits les lacets LACCICO ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"266ab009-99a1-4b97-a939-860c8c45c1a4","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p><strong>Déperlant et stable :</strong> Le cirage imprègne le tressage dense en coton et empêche l'humidité de pénétrer immédiatement dans les fibres. Même par temps humide prolongé, la matière ne ramollit pas : le lacet garde sa structure ferme, ne s'allonge pas et reste résistant à la déchirure.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Comment le coton ciré se comporte-t-il à l'humidité ?","defaultOpen":false}}}],"parent_slot":1},{"name":"TextCard","type":"content","meta":{"uuid":"8a256213-c2e9-49d1-b043-d80af23bfafe","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h4></h4><h2></h2>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"e2c5dd0b-51fd-4f3d-968c-aa55deb7b32c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left","color":""},"button":{"label":"DÉCOUVRIR","link":"/fr/forme-et-diametre","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":2,"slot_index":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"01b61f8b-2d39-4866-91bf-36e48db5bc7a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<!-- ========================================================================== -->\n<!-- LACCICO PRODUKT- & MAßVERGLEICHSTABELLE (GEO / SEO OPTIMIERT)              -->\n<!-- ========================================================================== -->\n<div class=\"widget widget-text widget-none my-4\">\n\t<div class=\"widget-inner bg-appearance\">\n\n\t\t<h2 class=\"h3 font-weight-bold mb-3\">Lacets LACCICO : <br>comparatif des modèles, dimensions &amp; longueurs</h2>\n\n\t\t<p class=\"small text-muted mb-3\">Aperçu de tous les types de tressage, diamètres, épaisseurs et longueurs en coton 100 % ciré, pour les classiques, les baskets et les boots d'extérieur.</p>\n\t\t<div class=\"table-responsive\">\n                        \n\t\t\t<table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 1rem;\">\n\t\t\t\t<thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\">\n                                \n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Série</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Forme &amp; dimensions</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Longueurs disponibles</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Cirage &amp; toucher</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Œillets</th>\n\t\t\t\t\t\t<th scope=\"col\" class=\"py-3 px-3\">Type de chaussure conseillé</th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-cs\" class=\"text-dark font-weight-bold\">R2-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet rond <br><strong>Ø 2,0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 180 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Ciré, brillant mat et soyeux, bonne prise en main</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets cachés</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Chaussures de ville classiques, richelieus, derbies, chaussures habillées</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl\" class=\"text-dark font-weight-bold\">R2-SL</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-primary\" style=\"background-color: #4F5D4E;\">Splendore di Laccico</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet rond <br><strong>Ø 2,0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 180 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Ciré deux fois, brillant somptueux comme un beau cuir de veau</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets cachés</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Chaussures de créateurs italiens, chaussures de mariage &amp; de soirée, cuir lisse</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-3-mm\" class=\"text-dark font-weight-bold\">R3-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet rond <br><strong>Ø 3,0 mm</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">45 – 150 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Ciré, garde sa forme, résistant aux intempéries &amp; bonne prise en main</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 4 mm ou plus, crochets</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Chaussures basses robustes, chukka boots, derbies de campagne, bottines à lacets avec crochets</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" class=\"text-dark font-weight-bold\">F3-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet plat <br><strong>3,0 mm de large</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">60 – 120 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Ruban plat fin, ciré, résistant à la déchirure &amp; fidèle à sa forme</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets cachés</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Classiques cousus Goodyear à œillets cachés, brogues, chaussures en cuir discrètes</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"text-dark font-weight-bold\">F4-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet plat <br><strong>4,0 mm de large</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">60 – 120 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Souple, brillant soyeux, discret</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 4 mm ou plus, crochets</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Baskets sport chic, chaussures basses classiques, bottines à lacets avec crochets</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"text-dark font-weight-bold\">F6-CS</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-secondary\">Classic Sportive</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet plat <br><strong>6,0 mm de large</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">75 – 150 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Aspect raffiné, résistant, allure affirmée</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 5 mm ou plus</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Baskets rétro, streetwear, chaussures de loisir, chaussures basses tendance</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"font-weight-bold py-3 px-3 align-middle\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" class=\"text-dark font-weight-bold\">F6-XR</a>\n\t\t\t\t\t\t\t<br><span class=\"badge badge-dark\">Xtra Robust</span></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Lacet plat <br><strong>6,0 mm de large</strong></td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle font-weight-bold text-nowrap\">75 – 150 cm</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Volume à la fois souple et massif, robuste, résistant à la déchirure</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 5 mm ou plus, crochets</td>\n\t\t\t\t\t\t<td class=\"py-3 px-3 align-middle\">Boots moc-toe, boots heritage et workwear</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t</div></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}}]