[{"name":"TextCard","type":"content","meta":{"uuid":"ee2c1352-2e75-424d-bc3c-af6116984c0f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h1 class=\"align-center\">Longueur des lacets</h1>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"488fdded-b8f8-48ef-af13-b0d2f676317f","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3>Quelle longueur de lacets choisir ?</h3>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"MultiGrid","type":"structure","meta":{"uuid":"6882f311-4f57-4587-ab63-6b68326578d8","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"Image","type":"content","meta":{"uuid":"695a86ab-ae5b-4c78-b0f4-6c5ed5776f59","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","desktop":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","tablet":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","mobile":"https://cdn02.plentyone.com/qadol2fdwt1n/frontend/Images/Kategorie/Laenge/Schnuersenkel_zu_lang.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":""},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}},"parent_slot":0,"slot_index":0},{"name":"TextCard","type":"content","meta":{"uuid":"5115bb8b-1456-4ecc-bdaa-71d6cf472939","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style=\"font-size:.8rem !important;line-height:1.4 !important;color:#666;margin:6px 0 0\">Image générée par IA</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0,"slot_index":1},{"name":"TextCard","type":"content","meta":{"uuid":"27b218e1-c428-4fc3-9594-72fb88422bce","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<p style=\"margin:0 0 14px\">Pour les chaussures classiques, la longueur dépend du nombre de paires d'œillets :</p><div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:1em !important;line-height:1.5 !important;margin:0;border:0\"><thead><tr><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Paires d'œillets</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Longueur</th></tr></thead><tbody><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">1–2</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">3–4</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">60 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">4–5</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">75 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">5–6</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">90 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\">7–8</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\">9 et plus / bottes</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">150–180 cm</td></tr></tbody></table></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"dbf88909-69a5-4330-97d9-b5101fa017f0","isGlobalTemplate":false},"configuration":{"columnWidths":[6,6],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"d6e115ee-93c4-4837-adfa-4240d5da5f77","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"mt-4\">Pour quelles chaussures vaut la règle</h3><p>La règle empirique vaut pour les chaussures classiques. Plus les œillets sont écartés, comme sur les baskets ou les boots, moins elle convient. Les baskets ont généralement beaucoup de paires d'œillets et demandent 90 à 120 cm. Une bottine demande 120 cm ou plus, des bottes hautes pour femme généralement 150 à 180 cm.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":0},{"name":"TextCard","type":"content","meta":{"uuid":"60bd6642-4219-4ab5-ba95-3d0ac023bc31","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3>Entre deux longueurs ?</h3><p>Pour 4 et 5 paires d'œillets, le tableau indique deux longueurs. Le choix entre la plus courte et la plus longue dépend de la chaussure et du pied : un derby ou richelieu classique à 5 trous demande presque toujours 75 cm, un pied fort 90 cm. Le type de laçage et la forme du pied jouent aussi, et un lacet épais comme le F6-XR demande un peu plus de longueur qu'un lacet fin.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"parent_slot":1}]},{"name":"TextCard","type":"content","meta":{"uuid":"1b3a8e3a-5eff-443d-9255-c9024ba4c99c","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:1em !important;line-height:1.5 !important;margin:0;border:0\"><thead><tr><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Série</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Forme</th><th scope=\"col\" style=\"background:#4C595D;color:#fff;text-align:left;font-weight:600;padding:12px 16px;border:0;font-size:1em !important\">Longueurs</th></tr></thead><tbody><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-cs\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R2-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">rond, 2 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45–180 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-2-mm/r2-sl\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R2-SL</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">rond, 2 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">45–180 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-3-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">R3-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">rond, 3 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">45–150 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F3-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">plat, 3 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">60–120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F4-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">plat, 4 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">60–120 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F6-CS</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">plat, 6 mm</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#F6F5F2;\">75–150 cm</td></tr><tr><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;font-weight:600;\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" style=\"color:#1A1A1A;font-weight:600;text-decoration:underline\">F6-XR</a></td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">plat, 6 mm, robuste</td><td style=\"padding:12px 16px;border:0;border-bottom:1px solid #D6D3CD;white-space:nowrap;font-size:1em !important;line-height:1.5 !important;background:#fff;\">75–150 cm</td></tr></tbody></table></div><p style=\"margin:10px 0 0;font-size:.95rem;color:#555\">Le 180 cm n'existe qu'en lacets ronds de 2 mm.</p>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"TextCard","type":"content","meta":{"uuid":"e7281527-fa92-4f2a-b0e2-70282762c5db","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h3 class=\"mt-4\">Questions fréquentes sur la longueur des lacets</h3>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}}},{"name":"DetailsList","type":"structure","meta":{"uuid":"6be34efe-91f4-4791-8490-4b37b8ba5d14","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"e9c44fea-071b-4735-9305-97086fd86df9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>90 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Selon la règle empirique, 90 cm conviennent pour 5 à 6 paires d'œillets. Cela vaut pour les chaussures classiques ; si les œillets sont très écartés, comme sur les baskets, ils peuvent être plus longs.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quelle longueur de lacets pour 6 paires d'œillets ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"d7998c78-bac0-45ec-9ef2-d2ec7f0cb614","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>75 cm.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Cela convient presque toujours aux chaussures classiques à 5 trous. Pour un pied fort, prenez 90 cm.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quelle longueur pour un derby ou richelieu à 5 trous ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"876d5d06-82eb-43b9-93ce-ab783a295d85","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>120 cm ou plus pour les bottines, 150 à 180 cm pour les bottes à 9 paires d'œillets ou plus.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Chez LACCICO, le 180 cm existe en lacets ronds de 2 mm ; les grandes longueurs vont surtout aux bottes pour femme.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quelle longueur de lacets pour des bottes ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"38cbc758-073e-49bf-87d7-5e65080804c3","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Oui, un peu.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Un lacet épais comme le F6-XR consomme plus de longueur en passant dans les œillets qu'un lacet fin. Si la règle empirique permet deux longueurs, prenez la plus longue pour le F6-XR.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Les lacets épais demandent-ils plus de longueur ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"536727e0-f34d-40ca-bcac-5548beaa4761","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>On pourrait la calculer en connaissant tous les écarts entre les œillets et la longueur nécessaire pour le nœud. En pratique, personne ne le fait.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Le plus sûr est de mesurer vos anciens lacets délacés ; sans anciens lacets, la règle empirique ci-dessus vous aide.</p></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Peut-on calculer la longueur des lacets ?","defaultOpen":false}}}]},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"aa5da8cf-ba1a-4bd6-ad3e-ecd4402f6d31","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"727","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"8fe62fb9-4fbd-48d9-85cb-8cb0c44ce7d8","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"731","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"12835c04-7e9b-4c2e-949b-1d7546b114b5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"729","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ffec2b6d-7718-44b8-8383-14a10c321395","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"730","itemId":"","crossSellingRelation":"Similar"}}},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"c181a980-9a7d-439a-bf50-6dd134d95388","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<h2><strong>Vus récemment</strong></h2>","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"last_seen","categoryId":"","itemId":"","crossSellingRelation":"Similar"}}}]