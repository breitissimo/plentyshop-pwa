par-largeur/lacets-plats-de-4-mm"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}},{"name":"Image","type":"content","meta":{"uuid":"ee599a0c-e35c-4c42-ae23-fcac6045456f","isGlobalTemplate":false},"content":{"image":{"wideScreen":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","desktop":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","tablet":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","mobile":"https://cdn02.plentymarkets.com/qadol2fdwt1n/frontend/Artikelbilder/Flachsenkel/3_mm/Detail/Unbenannt-2_0009_Unbenannt-1_0028_P1190031.jpg.jpg.jpg","alt":"","imageAlignment":"left","fillMode":"fit","aspectRatio":"auto","linktarget":"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm"},"text":{"textOverlay":"","textOverlayColor":"#ffffff","textOverlayAlignY":"bottom","textOverlayAlignX":"left"},"button":{"label":"","link":"","variant":"primary"},"layout":{"fullWidth":false}}}],"parent_slot":1}]},{"name":"MultiGrid","type":"structure","meta":{"uuid":"5f4dad8c-c4d2-48c2-80b4-fe9bf8d85ca3","isGlobalTemplate":false},"configuration":{"columnWidths":[3,9],"layout":{"gap":"L","marginTop":0,"marginBottom":0,"backgroundColor":"transparent"},"visible":true},"content":[{"name":"DetailsList","type":"structure","meta":{"uuid":"09c779eb-d25c-4dcf-ab86-2193ba4ea412","isGlobalTemplate":false},"configuration":{"visible":true,"layout":{"fullWidth":false,"caretPosition":"right"}},"content":[{"name":"TextCard","type":"content","meta":{"uuid":"c3db2f50-2125-48b7-b29f-e5eca42e23c5","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Le lacet plat de 3 mm convient le mieux aux chaussures basses classiques à œillets cachés : richelieus, derbies et brogues en cuir lisse. C'est le plus fin de nos lacets plats.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Avec des œillets cachés, on ne voit de l'extérieur qu'un petit trou dans le cuir. Le lacet plat de 3 mm et le lacet rond de 2 mm sont conçus pour cela. Le lacet rond s'efface complètement, le lacet plat étroit crée une petite surprise que les connaisseurs remarquent. Tous les lacets plats plus larges sont destinés aux œillets visibles.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Les lacets plats comparés&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Faites glisser sur le côté&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 680px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Largeur</th><th scope=\"col\" class=\"py-3 px-3\">Série</th><th scope=\"col\" class=\"py-3 px-3\">Effet</th><th scope=\"col\" class=\"py-3 px-3\">Longueurs</th><th scope=\"col\" class=\"py-3 px-3\">Chaussures</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">3 mm<br><span class=\"small text-muted font-weight-normal\">Œillets cachés</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F3-CS</a></td><td class=\"py-3 px-3 align-middle\">Très discret, une touche légère.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Richelieus, derbies et brogues classiques.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">4 mm<br><span class=\"small text-muted font-weight-normal\">Œillets visibles, diamètre intérieur 4 mm ou plus</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">Fin, sport chic.</td><td class=\"py-3 px-3 align-middle\">60–120 cm</td><td class=\"py-3 px-3 align-middle\">Bottines à lacets avec œillets et crochets, baskets en cuir fines.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Œillets visibles, diamètre intérieur 5 mm ou plus</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle\">Tressage fin, raffiné.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">Baskets haut de gamme, chaussures confort.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">6 mm<br><span class=\"small text-muted font-weight-normal\">Œillets visibles, diamètre intérieur 5 mm ou plus</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td><td class=\"py-3 px-3 align-middle\">Plus de fil, rustique, toucher à la fois souple et massif.</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">Baskets et boots au look vintage et workwear.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quand un lacet plat de 3 mm de large (F3) convient-il le mieux ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"3167ebed-88eb-49e4-b6e9-e19742c64e22","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Les lacets plats cirés en 100 % coton s'accordent avec le cuir d'une basket haut de gamme : brillant discret, toucher de qualité, et en plus résistants à la déchirure et durables.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">La cire pénètre la structure des fibres du tressage en coton, un peu comme les tanins pénètrent le cuir. Le lacet est ainsi déperlant, peu salissant, et garde sa forme même mouillé. Par temps humide, le nœud se défait moins facilement. Les lacets cirés neufs sont un peu raides au début et deviennent plus souples à l'usage.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Sur la basket&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Faites glisser sur le côté&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Propriété</th><th scope=\"col\" class=\"py-3 px-3\">D'où</th><th scope=\"col\" class=\"py-3 px-3\">Sur la basket</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Brillant discret<br><span class=\"small text-muted font-weight-normal\">Aspect</span></td><td class=\"py-3 px-3 align-middle\">Laminé à chaud et poli.</td><td class=\"py-3 px-3 align-middle\">Ressemble à un fin ruban de cuir et s'accorde avec le cuir lisse.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Résistant à la déchirure<br><span class=\"small text-muted font-weight-normal\">Durabilité</span></td><td class=\"py-3 px-3 align-middle\">Coton au tressage serré.</td><td class=\"py-3 px-3 align-middle\">Convient aussi à un laçage serré.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Déperlant<br><span class=\"small text-muted font-weight-normal\">Météo</span></td><td class=\"py-3 px-3 align-middle\">La cire protège la fibre.</td><td class=\"py-3 px-3 align-middle\">Garde sa forme même mouillé.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">S'étire à peine<br><span class=\"small text-muted font-weight-normal\">Tressage</span></td><td class=\"py-3 px-3 align-middle\">Tressage serré.</td><td class=\"py-3 px-3 align-middle\">Ne se détend pas.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Largeur<br><span class=\"small text-muted font-weight-normal\">Choix</span></td><td class=\"py-3 px-3 align-middle\">À choisir selon les œillets.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-CS</a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Pourquoi choisir des lacets plats cirés pour des baskets haut de gamme ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"638c500c-3e1a-40f9-af47-c6acdaedfa39","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Le lacet plat de 6 mm est du plus bel effet sur les chaussures à œillets visibles d'un diamètre intérieur de 5 mm ou plus, surtout les baskets et les boots. La surface large y trouve sa place et s'accorde avec la construction robuste.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Il existe en deux versions. Le F6-CS a un tressage fin et discret et paraît raffiné, même dans des couleurs vives. Dans les longueurs plus courtes, il convient aux chaussures confort et aux derbies à deux paires de trous et œillets visibles. Le F6-XR est plus épais et plus lourd, il a plus de volume, car davantage de fil y est tressé. Il a un aspect rustique et va avec les boots moc-toe, les chaussures heritage et workwear.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> F6-CS &amp; F6-XR&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Faites glisser sur le côté&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Caractéristique</th><th scope=\"col\" class=\"py-3 px-3\">F6-CS Classic Sportive</th><th scope=\"col\" class=\"py-3 px-3\">F6-XR Xtra Robust</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Tressage<br><span class=\"small text-muted font-weight-normal\">Aspect</span></td><td class=\"py-3 px-3 align-middle\">Fin et discret.</td><td class=\"py-3 px-3 align-middle\">Brins épais, plus grossier.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Toucher<br><span class=\"small text-muted font-weight-normal\">En main</span></td><td class=\"py-3 px-3 align-middle\">Plat et souple.</td><td class=\"py-3 px-3 align-middle\">Plus épais, toucher à la fois souple et massif.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Effet<br><span class=\"small text-muted font-weight-normal\">Style</span></td><td class=\"py-3 px-3 align-middle\">Raffiné, pour la ville.</td><td class=\"py-3 px-3 align-middle\">Rustique, look vintage.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chaussures<br><span class=\"small text-muted font-weight-normal\">Usage</span></td><td class=\"py-3 px-3 align-middle\">Baskets haut de gamme, chaussures confort, boots.</td><td class=\"py-3 px-3 align-middle\">Boots, workwear, baskets au look vintage.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Longueurs<br><span class=\"small text-muted font-weight-normal\">Gamme</span></td><td class=\"py-3 px-3 align-middle\">75–150 cm</td><td class=\"py-3 px-3 align-middle\">75–150 cm</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Plus étroit<br><span class=\"small text-muted font-weight-normal\">À comparer</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F3-CS</a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a></td><td class=\"py-3 px-3 align-middle\">F3 pour les œillets cachés, F4 pour les œillets visibles d'un diamètre intérieur de 4 mm ou plus.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">En savoir plus<br><span class=\"small text-muted font-weight-normal\">Page</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6xr\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-XR</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quand un lacet de 6 mm de large (F6) est-il du plus bel effet ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"4f8146ec-a2cd-4b18-97d6-f2875902e5cb","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Pour les baskets en cuir fines et les chaussures smart casual à œillets visibles d'un diamètre intérieur de 4 mm ou plus, le lacet plat de 4 mm (F4-CS) est le bon choix. À partir de 5 mm de diamètre intérieur, le lacet plat de 6 mm convient aussi.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">Le F4 est particulièrement apprécié sur les bottines à lacets avec œillets et crochets. Sur les crochets, posez le lacet plat dans le crochet, sans le tirer dans la gorge du crochet, sinon il s'use vite. Si vous préférez un lacet rond à cet endroit, prenez le lacet rond de 3 mm, c'est une question de goût. Les baskets de type court demandent le lacet plat de 6 mm.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Chaussures &amp; lacets&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Faites glisser sur le côté&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Chaussure</th><th scope=\"col\" class=\"py-3 px-3\">Œillets</th><th scope=\"col\" class=\"py-3 px-3\">Lacet</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Baskets en cuir fines<br><span class=\"small text-muted font-weight-normal\">Sport chic</span></td><td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 4 mm ou plus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Derbies<br><span class=\"small text-muted font-weight-normal\">Smart casual</span></td><td class=\"py-3 px-3 align-middle\">Œillets visibles.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F4-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Bottines à lacets<br><span class=\"small text-muted font-weight-normal\">Montantes à la cheville</span></td><td class=\"py-3 px-3 align-middle\">Œillets en bas, crochets en haut.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">F4-CS</a> · <a href=\"/fr/forme-et-diametre/lacets-ronds-classes-par-diametre/lacets-ronds-de-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">R3-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Baskets de type court<br><span class=\"small text-muted font-weight-normal\">Casual</span></td><td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 5 mm ou plus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Chaussures confort<br><span class=\"small text-muted font-weight-normal\">Quotidien</span></td><td class=\"py-3 px-3 align-middle\">Œillets visibles, diamètre intérieur 5 mm ou plus.</td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm/f6cs\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">F6-CS</a></td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Quels lacets plats pour des baskets sport chic et des chaussures smart casual ?","defaultOpen":false}}},{"name":"TextCard","type":"content","meta":{"uuid":"0bbcb94e-62fc-4843-bafb-2b3fc12a82c2","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"<div class=\"mb-2\"><p class=\"mb-2\"><strong>Le vrillage ne dépend pas de la matière, mais de la façon de faire. D'une main, on guide le lacet à travers l'œillet, tandis que l'extrémité libre glisse sur un doigt de l'autre main, sous une légère tension.</strong></p><p class=\"mb-2\"><br></p><p class=\"mb-2\">L'œillet agit ainsi comme un rail de guidage et le lacet passe à plat. Une fois serré vrillé, le lacet se corrige difficilement. La bonne largeur compte aussi : le lacet plat doit être adapté à l'œillet pour pouvoir rester à plat. C'est un conseil de maître, venu de l'atelier.</p><p class=\"mb-2\"><br></p><div class=\"d-flex justify-content-between align-items-center d-md-none bg-light p-2 mb-2 border rounded\"><span class=\"small font-weight-bold text-dark\">&nbsp;<i class=\"fa fa-hand-o-right text-muted mr-1\" aria-hidden=\"true\"></i> Laçage&nbsp;</span> <span class=\"badge badge-secondary py-1 px-2\">&nbsp;<i class=\"fa fa-arrows-h mr-1\" aria-hidden=\"true\"></i> Faites glisser sur le côté&nbsp;</span></div></div><div class=\"laccico-scroll-wrapper\"><div class=\"table-responsive laccico-scroll-table\"><table class=\"table table-bordered table-hover text-left mb-0\" style=\"border: 1px solid #000000; font-size: 0.9rem; min-width: 560px;\"><thead class=\"thead-dark\" style=\"background-color: #000000; color: #ffffff;\"><tr><th scope=\"col\" class=\"py-3 px-3\">Étape</th><th scope=\"col\" class=\"py-3 px-3\">Comment faire</th><th scope=\"col\" class=\"py-3 px-3\">Pourquoi</th></tr></thead><tbody><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Enfiler<br><span class=\"small text-muted font-weight-normal\">Une main</span></td><td class=\"py-3 px-3 align-middle\">Guider le lacet à plat à travers l'œillet.</td><td class=\"py-3 px-3 align-middle\">L'œillet agit comme un rail de guidage.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Extrémité libre<br><span class=\"small text-muted font-weight-normal\">L'autre main</span></td><td class=\"py-3 px-3 align-middle\">La laisser glisser sur un doigt sous une légère tension.</td><td class=\"py-3 px-3 align-middle\">Ainsi, le lacet ne se vrille pas.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Serrer<br><span class=\"small text-muted font-weight-normal\">À la fin</span></td><td class=\"py-3 px-3 align-middle\">Ne tirer que lorsque le lacet est bien à plat.</td><td class=\"py-3 px-3 align-middle\">Une fois serré vrillé, le lacet se corrige difficilement.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Largeur<br><span class=\"small text-muted font-weight-normal\">Selon l'œillet</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-3-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">3 mm</a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-4-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">4 mm</a> · <a href=\"/fr/forme-et-diametre/lacets-plats-classes-par-largeur/lacets-plats-de-6-mm\" class=\"font-weight-bold text-dark\" style=\"text-decoration: underline;\">6 mm</a></td><td class=\"py-3 px-3 align-middle\">Plus le lacet glisse facilement dans l'œillet, plus il est facile de le garder à plat.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">Crochets<br><span class=\"small text-muted font-weight-normal\">Bottines</span></td><td class=\"py-3 px-3 align-middle\">Poser le lacet, ne pas le tirer dans la gorge du crochet.</td><td class=\"py-3 px-3 align-middle\">Sinon, le lacet plat s'use vite.</td></tr><tr><td class=\"font-weight-bold py-3 px-3 align-middle text-nowrap\">En savoir plus<br><span class=\"small text-muted font-weight-normal\">FAQ</span></td><td class=\"py-3 px-3 align-middle text-nowrap\"><a href=\"/fr/laccicolacetsfinscires/faq\" class=\"font-weight-bold text-dark d-block\" style=\"text-decoration: underline;\">Nos questions fréquentes</a></td><td class=\"py-3 px-3 align-middle\">D'autres questions sur les lacets et les chaussures.</td></tr></tbody></table></div></div>","textAlignment":"left","color":""},"button":{"label":"","link":"","variant":"primary"},"layout":{"backgroundColor":"","paddingTop":0,"paddingBottom":0,"paddingLeft":0,"paddingRight":0}},"configuration":{"visible":true,"detailsSettings":{"label":"Comment éviter que les lacets plats se vrillent au laçage ?","defaultOpen":false}}}],"parent_slot":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"34172f4c-095c-4a98-887b-70b193a9252a","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"705","itemId":"","crossSellingRelation":"Similar"}},"parent_slot":1,"slot_index":0},{"name":"ProductRecommendedProducts","type":"content","meta":{"uuid":"ee4e0fdb-d8cd-476f-ac25-33743aba57a9","isGlobalTemplate":false},"content":{"text":{"htmlDescription":"","textAlignment":"left"},"layout":{"fullWidth":false},"source":{"type":"category","categoryId":"702","itemId":"","crossSellin